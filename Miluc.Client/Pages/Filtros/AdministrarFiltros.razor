@page "/Administrar-Filtros"
@using System.Text.Json
@using Miluc.Client.Interfaces
@using Miluc.Client.Interfaces.UsuariosRolesPermisos
@using Miluc.Shared.DTOs.Usuarios
@using Miluc.Shared.DTOs.Usuarios.AsignarFiltrosDto
@inject NavigationManager nav
@inject IAsignacionFiltrosClient _asignar;
@inject IJSRuntime js
@inject IAuthClientService _authService
@inject ILogClientService logClient

<div class="usuarios-page animate__animated animate__fadeIn p-4">
    @* header *@
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-negro m-0 ">
                <i class="bi bi-person-badge-fill me-2"> Gestionar Usuarios</i>
            </h2>
            <p class="m-0 text-muted">Administrcion de usuarios</p>
        </div>
        @if (_authService.HasPermission("Filtro.Create"))
        {
            <button class="btn btn-rojo  btn-nuevo rounded-pill px-4 shadow-sm" @onclick=IrACrear>
                <i class="bi bi-plus-lg me-1"></i> Nuevo
            </button>
        }
    </div>

    @* --- BARRA DE BÚSQUEDA --- *@
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-lg-7">
                    <div class="input-group input-group-lg search-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        @* para actualizar en tiempo real cada vez que precione una tecla
                                no HACERLO contenteditable EL ONCHAGE *@
                        <input type="text" class="form-control border-start-0 shadow-none fs-6"
                               placeholder="Filtrar local o buscar en servidor..."
                               @bind="textoBusqueda" @bind:event="oninput" @onkeyup="HandleEnter" />
                        <button class="btn btn-rojo rounded-end-pill px-4" @onclick="BuscarEnServidor">
                            <i class="bi bi-search me-2"></i>
                        </button>
                    </div>
                </div>
                <div class="col-lg-5 text-lg-end">
                    <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border">
                        <label class="mx-3 small fw-bold text-muted text-uppercase">Mostrar</label>
                        <select class="form-select form-select-sm rounded-pill border-0 bg-transparent fw-bold"
                                style="width: 80px;"
                                value="@cantidadPorPagina"
                                @onchange="CambiarCantidadPagina">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                        <span class="badge bg-rojo rounded-pill ms-2 px-3 py-2">
                            Total: @totalRegistros
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* vamos a mostrar la tabla de usuarios aqui *@

    @if (_authService.HasPermission("Filtro.View"))
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

            <div class="table-responsive">
                <table class=" table table-striped table table-hover mb-0">
                    <thead class="bg-rojo text-white">
                        <tr>
                            <th class="ps-4 py-3">Id</th>
                            <th class="ps-4 py-3">Nombre Usuario</th>
                            <th class="text-center">Nombre Modulo</th>
                            <th class="text-lg-center">Descripcion</th>
                        
                            <th class="text-center pe-4">Filtro</th>
                            <th class="text-center pe-4">Accion</th>

                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        @* Aquí se iteraría sobre la lista de usuarios *@
                        @* Ejemplo de fila de usuario *@
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="spinner-border text-rojo"></div>
                                </td>
                            </tr>
                        }
                        else if (!listaFiltroApi.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    No hay filtros registrados
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var filtro in listaFiltroApi)
                            {
                                <tr>

                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border ">@filtro.AsignarFiltrosId</span>
                                      
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@filtro.NombreUsuario</span>
                                      
                                    </td>
                                    <td class="text-center">
                                        <div class="text-muted x-small">@filtro.NombreModulo</div>
                                    </td>
                                 
                                    <td class="text-center">
                                        <div class="text-muted x-small">@filtro.Descripcion</div>
                                    </td>
                                    <td class="text-center">
                                        <div class="text-muted x-small">@filtro.Filtro</div>
                                    </td>
                                 @*VER EL DETALLE *@
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm border rounded-pill bg-white overflow-hidden">

                                            @if (_authService.HasPermission("Filtro.Details"))
                                            {
                                                <button class="btn-detail btn btn-dark btn-sm px-2 border-end" title="Ver Detalle" @onclick="() => VerDetalleFiltro(filtro.AsignarFiltrosId)">
                                                    <i class="bi bi-eye text-dark"></i>
                                                </button>
                                            }
                                            @if (_authService.HasPermission("Filtro.Update"))
                                            {
                                                @* CORREGIDO: Se usa AsignarFiltrosId en lugar de IdUsuario *@
                                                <button class="btn btn-white btn-sm px-2 border-end edit" title="Editar Usuario" @onclick="() => EditarFiltro(filtro.AsignarFiltrosId)">
                                                    <i class="bi bi-pencil-square text-primary"></i>
                                                </button>
                                            }

                                            @if (_authService.HasPermission("Filtro.Delete"))
                                            {
                                                @* CORREGIDO: Se usa AsignarFiltrosId en lugar de IdUsuario *@
                                                <button class="btn btn-white btn-sm px-2 delete" title="Eliminar" @onclick="() => EliminarFiltro(filtro.AsignarFiltrosId)">
                                                    <i class="bi bi-trash3 text-danger"></i>
                                                </button>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <div class="pagination-footer d-flex justify-content-between align-items-center mt-4">
        <div class=" page-link text-muted small">Página <b>@paginaActual</b> de @totalPaginas</div>
        <div class="page-item.active pagination-container p-1 bg-white border rounded-pill shadow-sm">
            <button class="btn btn-sm rounded-circle @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)"><i class="bi bi-chevron-left"></i></button>
            <span class="mx-3 fw-bold text-rojo">@paginaActual</span>
            <button class="btn btn-sm rounded-circle @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)"><i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
</div>
@code
{
    private List<AsignarFiltrosReaderDto> listaOriginal = new();
    private List<AsignarFiltrosReaderDto> listaFiltroApi = new();

    private string _textoBusqueda = "";
    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            FiltrarLocal(_textoBusqueda,paginaActual,cantidadPorPagina);
        }
    }

    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private int totalRegistros = 0;
    private bool cargando = false;

    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        cantidadPorPagina = int.Parse(e.Value!.ToString()!);
        paginaActual = 1;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await CargarUsuarios();
        else
            await BuscarEnServidor();
    }
    //para qyue funcione para las dos busquedas tanto local como en servidor
    private int totalPaginas
    {
        get
        {
            var total = string.IsNullOrWhiteSpace(_textoBusqueda)
                ? totalRegistros
                : listaFiltroApi.Count;

            return (int)Math.Ceiling((double)total / cantidadPorPagina);
        }
    }
   


    //aca cargo las lista una para mantener el original y otra para mostrar los resultados filtrados
    private async Task CargarUsuarios(string? texto = null, int? pagina = null, int? cantidad = null)
    {
        try
        {

            if (texto == null)
            {
                texto = _textoBusqueda;
            }
            if (pagina == null)
            {
                pagina = 1;

            }
            if (cantidad == null)
            {
                cantidad = 10;
            }

            cargando = true;
            var response = await _asignar.GetFiltrosAsync(texto, pagina, cantidad); //  SIN textoBusqueda

            if (response?.Valor.Count > 0)
            {
                listaOriginal = response.Valor;
                listaFiltroApi = listaOriginal.ToList();
                totalRegistros = response.CantRegistros;
            }
            else
            {
                listaFiltroApi = new List<AsignarFiltrosReaderDto>();
                string errores = response.Errores != null && response.Errores.Any()
                   ? string.Join("<br>", response.Errores)
                   : "Ocurrió un error inesperado.";

                await js.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = $"Error al consultar usuarios {response.Mensaje} ",
                    text = $"{errores}",
                    confirmButtonColor = "#6c1d1d"
                });
            }

            cargando = false;
        }
        catch (Exception ex)
        {
            cargando = false;

            await logClient.GuardarErrorAsync(
                      ex.Message,
                      ex.StackTrace,
                     usuario: _authService.CurrentSession.UserName ?? "No encontrado",
                    metodo: "Cargar Filtro",
                      ruta: $"/Filtros",
                      origen: "Blazor cliente",
                      nivel: "error");


            await js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Error al cargar usuarios",
                text = ex.Message
            });
        }
    }

    private void FiltrarLocal(string? texto = null, int? pagina = null, int? cantidad = null)
    {
        if (texto == null)
        {
            texto = _textoBusqueda;
        }
        if (pagina == null)
        {
            pagina = 1;

        }
        if (cantidad == null)
        {
            cantidad = 10;
        }
        if (string.IsNullOrWhiteSpace(texto))
        {
            listaFiltroApi = listaOriginal.ToList();
            return;
        }

        listaFiltroApi = listaOriginal
            .Where(u =>
                (u.NombreModulo?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Descripcion?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.NombreUsuario?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)

            ).ToList();
    }


    private async Task BuscarEnServidor()
    {
         paginaActual = 1;
        cargando = true;

        var response = await _asignar.GetFiltrosAsync(_textoBusqueda, paginaActual, cantidadPorPagina);

        if (response.Valor?.Count > 0)
        {
            listaOriginal = response.Valor;
            listaFiltroApi = listaOriginal.ToList();
            totalRegistros = response.CantRegistros;
        }
        else if (response.Errores != null)
        {
            listaFiltroApi = new List<AsignarFiltrosReaderDto>();
            string errores = response.Errores != null && response.Errores.Any()
               ? string.Join("<br>", response.Errores)
               : "Ocurrió un error inesperado.";

            await js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = $"Error al consultar usuarios {response.Mensaje} ",
                text = $"{errores}",
                confirmButtonColor = "#6c1d1d"
            });
        }

        cargando = false;
    }
    private async Task IrPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1)
            return;

        paginaActual = nuevaPagina;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await CargarUsuarios();
        else
            await BuscarEnServidor();
    }

    protected override async Task OnInitializedAsync()
    {
    
        if (!_authService.HasPermission("Filtros.View"))
        {
            nav.NavigateTo("/no-autorizado");
            return;
        }
        try
        {
            await CargarUsuarios();
        }
        catch (Exception ex)
        {
            await logClient.GuardarErrorAsync(
                         ex.Message,
                         ex.StackTrace,
                         usuario: _authService.CurrentSession.UserName ?? "No encontrado",
                         metodo: nameof(OnInitializedAsync),
                         ruta: "/Configuracion/usuarios",
                         $"OnInitializedAsync Blazor",
                          nivel: "Error");
            await js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Error al inicializar la página",
                text = ex.Message
            });
        }
    }
    private void IrACrear() => nav.NavigateTo("/Filtros/Crear");

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            paginaActual = 1;
            await BuscarEnServidor();
        }
    }
    private void EditarFiltro(int IdFiltro)
    {
        nav.NavigateTo($"/Filtros/Editar/{IdFiltro}");
    }
  private void VerDetalleFiltro(int Id)
{
        nav.NavigateTo($"/Filtros-Detalle/{Id}");
}

    private async Task EliminarFiltro(int IdFiltro)
    {
        var result = await js.InvokeAsync<JsonElement>
            ("Swal.fire", new
            {
                title = "¿Estás seguro?",
                text = $"¿Deseas eliminar el usuario {IdFiltro}?",
                icon = "warning",
                showCancelButton = true,
                confirmButtonColor = "#d33",
                cancelButtonColor = "#3085d6",
                confirmButtonText = "Sí, eliminar",
                cancelButtonText = "Cancelar"
            });

        if (result.GetProperty("isConfirmed").GetBoolean())
        {
            var response = await _asignar.DeleteFiltrosAsync(IdFiltro);

            if (response.EsCorrecto)
            {
                await js.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "success",
                    title = "Usuario Eliminado",
                    text = response.Mensaje,
                    confirmButtonColor = "#6c1d1d"
                });

                await CargarUsuarios();
            }
            else
            {
                string erroresConcatenados = response.Errores != null && response.Errores.Any()
                ? string.Join("<br>", response.Errores)
                : "Ocurrió un error inesperado.";

                await js.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = "Error al eliminar el usuario",
                    html = erroresConcatenados,
                    confirmButtonColor = "#6c1d1d"
                });
            }
        }
    }
}
