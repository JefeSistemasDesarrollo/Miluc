@page "/Administrar/Empresa/Detalle/{id:int}"

@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.EmpresaDto

@inject NavigationManager nav
@inject IEmpresaClientSevice _empresaService
@inject IJSRuntime JS

<div class="Empresa-page p-4 animate__animated animate__fadeIn">
    <div class="container-fluid max-width-container">

        @* --- CABECERA DE LA PÁGINA --- *@
        <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
            <div>
                <h2 class="fw-extrabold text-black m-0 tracking-tight">
                    <i class="bi bi-eye me-2"></i>
                    Detalle de la Empresa
                </h2>
                <p class="text-muted mb-0 small mt-1">
                    Visualización de la empresa y su estado.
                </p>
            </div>

            <button class="btn btn-rojo btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i> Volver al listado
            </button>
        </div>

        @if (empresaDetalle == null)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-rojo" role="status">
                    <span class="visually-hidden">Cargando datos...</span>
                </div>
            </div>
        }
        else
        {
            @* --- VISTA DE DATOS (SOLO LECTURA) --- *@
            <div class="row g-4">

                @* --- BLOQUE 1: DATOS MAESTROS DE LA EMPRESA --- *@
                <div class="col-12">
                    <div class="card card-custom border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="section-title-container mb-4">
                                <span class="badge bg-vinotinto-light text-rojo rounded-pill mb-2 px-3 py-2 fw-bold text-uppercase tracking-wider">
                                    Información Empresa
                                </span>
                            </div>

                            <div class="row g-4">
                                <div class="col-md-4">
                                    <label class="form-label label-custom">Nombre Empresa</label>
                                    <input type="text" class="form-control input-custom-view" value="@empresaDetalle.NombreEmpresa" readonly />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom">NIT</label>
                                    <input type="text" class="form-control input-custom-view" value="@empresaDetalle.Nit" readonly />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom">Estado</label>
                                    <div class="mt-2">
                                        @if (empresaDetalle.Activo)
                                        {
                                            <i class="bi text-black bi-check2-circle fs-5"></i> <span class="ms-1">Activo</span>
                                        }
                                        else
                                        {
                                            <i class="bi text-rojo bi-x-circle fs-5"></i> <span class="ms-1">Inactivo</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- BLOQUE 2: INFORMACIÓN DE AUDITORÍA Y REGISTRO --- *@
                <div class="col-12 col-md-6">
                    <div class="card card-custom border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold text-dark mb-3">Identificador del Sistema</h5>
                            <div class="mb-3">
                                <label class="form-label label-custom">ID de Registro Interno</label>
                                <input type="text" class="form-control input-custom-view" value="@empresaDetalle.EmpresaId" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                @* --- INFORMACIÓN EXTRA ILUSTRATIVA / COMPLEMENTARIA --- *@
                <div class="col-12 col-lg-6 col-md-6 col-sm-12">
                    <div class="card card-info-banner border-0 shadow-sm rounded-4 h-100 p-4 position-relative overflow-hidden">
                        <div class="position-relative z-index-2 d-flex flex-column h-100 justify-content-center">
                            <h5 class="fw-bold text-rojo mb-2"><i class="bi bi-shield-lock-fill me-2"></i>Seguridad de los datos</h5>
                            <p class="text-secondary small mb-0 lh-lg">
                                Las empresas registradas en la plataforma son fundamentales para la estructura organizacional y la correcta administración de la nómina y el personal.
                            </p>
                        </div>
                        <div class="decorative-circle"></div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private EmpresaReaderDto? empresaDetalle;

    protected override async Task OnInitializedAsync()
    {
        await CargarEmpresa();
    }

    private async Task CargarEmpresa()
    {
        try
        {
            var respuesta = await _empresaService.GetEmpresaByIdAsync(id);

            if (respuesta != null && respuesta.EsCorrecto && respuesta.Valor != null)
            {
                empresaDetalle = respuesta.Valor;
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", "Atención", respuesta?.Mensaje ?? "No se encontraron los detalles de la empresa.", "warning");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", ex.Message, "error");
        }
    }

    private void Volver() => nav.NavigateTo("/Administrar/empresas");

    // Available if you add an Edit button to the UI later
    private void IrAEditar() => nav.NavigateTo($"/Administrar/Empresas/Editar/{id}");
}