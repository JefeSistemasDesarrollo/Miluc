@page "/Administrar/cargos"
@using Microsoft.AspNetCore.Components
@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.CargosDto
@using Miluc.Shared.Models.Response
@inject NavigationManager nav
@inject ICargosClientService _cargosService
@inject IJSRuntime js
@inject IAuthClientService _autcliente

@* CONTENEDOR PRINCIPAL *@
<div class="empresas-page animate__animated animate__fadeIn p-4">

    @* ENCABEZADO DE LA PÁGINA *@
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-black m-0">
                <i class="bi bi-buildings-fill me-2"></i> Gestionar Cargos
            </h2>
            <p class="m-0 text-muted">Administración de cargos</p>
        </div>

        @* Botón Volver *@
        <button class="btn btn-rojo btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
            <i class="bi bi-arrow-left me-2"></i> Volver
        </button>
    </div>

    @* Botón Nueva Empresa *@
    <button class="btn btn-rojo btn-nuevo rounded-pill px-4 shadow-sm mb-4" @onclick="IrACrearCargo">
        <i class="bi bi-plus-lg me-1"></i> Nuevo cargo
    </button>
</div>

@* SECCIÓN DE FILTROS *@
<div class="card shadow-sm border-0 mb-4 rounded-4">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">

            @* Barra de búsqueda *@
            <div class="col-lg-7">
                <div class="input-group input-group-lg search-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>

                    <input type="text" class="form-control border-start-0 shadow-none fs-6"
                           placeholder="Filtrar local o buscar en servidor..."
                           @bind="textoBusqueda" @bind:event="oninput" @onkeyup="HandleEnter" />

                    <button class="btn btn-rojo rounded-end-pill px-4" @onclick="BuscarEnServidor">
                        <i class="bi bi-search me-2"></i>
                    </button>
                </div>
            </div>

            @* Selector de paginación y Badge *@
            <div class="col-lg-5 text-lg-end">
                <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border">
                    <label class="mx-3 small fw-bold text-muted text-uppercase">Mostrar</label>

                    <select class="form-select form-select-sm rounded-pill border-0 bg-transparent fw-bold"
                            style="width: 80px;"
                            value="@cantidadPorPagina"
                            @onchange="CambiarCantidadPagina">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>

                    <span class="badge bg-rojo rounded-pill ms-2 px-3 py-2">
                        Total: @totalRegistros
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@* TABLA DE EMPRESAS *@
<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="bg-rojo text-white">
                <tr>
                    <th class="ps-4 py-3 text-center">Nombre Cargo</th>
                   
                    <th class="text-center">Activo</th>
                    <th class="text-center pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @if (cargando)
                {
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <div class="spinner-border text-rojo"></div>
                        </td>
                    </tr>
                }
                else if (listCargosAlServidor == null || !listCargosAlServidor.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            No se encontraron registros.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var em in listCargosAlServidor)
                    {
                        <tr>
                            <td>
                                <div class="x-small text-center text-uppercase">@em.CargoNombre</div>
                            </td>
                            
                            <td class="text-center">
                                @if (em.Activo)
                                {
                                    <i class="bi bi-check2-circle text-dark"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle text-rojo"></i>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group shadow-sm border rounded-pill bg-white overflow-hidden">
                                    <button class="btn-detail btn btn-dark btn-sm px-2 border-end" title="Ver Detalle" @onclick="() => VerDetalle(em.CargoId)">
                                        <i class="bi bi-eye text-dark"></i>
                                    </button>

                                    <button class="btn btn-white btn-sm px-2 border-end edit" title="Editar Cargo" @onclick="() => EditarCargo(em.CargoId)">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </button>

                                    <button class="btn btn-white btn-sm px-2 delete" title="Eliminar" @onclick="() => EliminarCargoAsync(em.CargoId)">
                                        <i class="bi bi-trash3 text-danger"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* PIE DE PÁGINA CON PAGINADOR *@
<div class="pagination-footer d-flex justify-content-between align-items-center mt-4 p-3">
    <div class="text-muted small border-0 bg-transparent">
        Página <b>@paginaActual</b> de @totalPaginas
    </div>

    <div class="pagination-container p-1 bg-white border rounded-pill shadow-sm">
        <button class="btn btn-sm rounded-circle @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)">
            <i class="bi bi-chevron-left"></i>
        </button>
        <span class="mx-3 fw-bold text-rojo">@paginaActual</span>
        <button class="btn btn-sm rounded-circle @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    // --- Estado Interno ---
    private List<CargosReaderDto> listCargosOrigen = new();      // Todos los registros traídos del servidor
    private List<CargosReaderDto> listCargosFiltrados = new();   // Registros filtrados por texto
    private List<CargosReaderDto> listCargosAlServidor = new();  // Registros visibles en la página actual

    private string _textoBusqueda = "";
    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            paginaActual = 1;
            AplicarFiltroYPaginacion();
        }
    }

    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private int totalRegistros = 0;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarCargosAsync();
    }

    // --- MÉTODOS DE CONSULTA Y BÚSQUEDA ---
    public async Task CargarCargosAsync()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            var respuesta = await _cargosService.GetCargosAsync(_textoBusqueda, paginaActual, cantidadPorPagina);

            if (respuesta != null && respuesta.EsCorrecto)
            {
                listCargosOrigen = respuesta.Valor ?? new List<CargosReaderDto>();

                // Si el API no devuelve CantRegistros, tomamos el conteo de la lista recibida
                totalRegistros = respuesta.CantRegistros > 0 ? respuesta.CantRegistros : listCargosOrigen.Count;

                AplicarFiltroYPaginacion();
            }
            else
            {
                listCargosOrigen = new List<CargosReaderDto>();
                listCargosFiltrados = new List<CargosReaderDto>();
                listCargosAlServidor = new List<CargosReaderDto>();
                totalRegistros = 0;

                string mensaje = respuesta?.Mensaje ?? "Sin respuesta del servidor.";
                await MostrarAlertaError("Error al consultar cargos", mensaje, respuesta?.Errores);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consultar cargos: {ex.Message}");
            await MostrarAlertaError("Error de comunicación", "No fue posible conectar con el servidor.");
        }

        cargando = false;
        StateHasChanged();
    }

    private void AplicarFiltroYPaginacion()
    {
        // 1. Filtrar localmente si existe texto en el campo de búsqueda
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            listCargosFiltrados = listCargosOrigen;
        }
        else
        {
            listCargosFiltrados = listCargosOrigen.Where(c =>
                (!string.IsNullOrEmpty(c.CargoNombre) && c.CargoNombre.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase)) 
          
            ).ToList();
        }

        // 2. Verificar si el servidor ya entregó los datos paginados o la lista completa
        bool servidorYaPagino = listCargosOrigen.Count <= cantidadPorPagina && totalRegistros > listCargosOrigen.Count;

        if (servidorYaPagino)
        {
            listCargosAlServidor = listCargosFiltrados;
        }
        else
        {
            // Paginación local si el servidor retorna todos los elementos
            totalRegistros = listCargosFiltrados.Count;

            int maxPaginas = totalPaginas;
            if (paginaActual > maxPaginas && maxPaginas > 0)
                paginaActual = maxPaginas;

            listCargosAlServidor = listCargosFiltrados
                .Skip((paginaActual - 1) * cantidadPorPagina)
                .Take(cantidadPorPagina)
                .ToList();
        }
    }

    public async Task BuscarEnServidor()
    {
        paginaActual = 1;
        await CargarCargosAsync();
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarEnServidor();
        }
    }

    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevaCantidad))
        {
            cantidadPorPagina = nuevaCantidad;
            paginaActual = 1;

            if (listCargosOrigen.Count > cantidadPorPagina)
            {
                AplicarFiltroYPaginacion();
            }
            else
            {
                await CargarCargosAsync();
            }
        }
    }

    private int totalPaginas
    {
        get
        {
            if (totalRegistros <= 0) return 1;
            return (int)Math.Ceiling((double)totalRegistros / cantidadPorPagina);
        }
    }

    private async Task IrPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > totalPaginas)
            return;

        paginaActual = nuevaPagina;

        // Si tenemos más datos cargados localmente que la cantidad por página, paginamos local
        if (listCargosOrigen.Count > cantidadPorPagina)
        {
            AplicarFiltroYPaginacion();
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_textoBusqueda))
                await CargarCargosAsync();
            else
                await BuscarEnServidor();
        }
    }

    // --- ACCIONES CRUD ---
    private async Task EliminarCargoAsync(int id)
    {
        var resultadoSwal = await js.InvokeAsync<System.Text.Json.JsonElement>("Swal.fire", new
        {
            title = "¿Deseas eliminar este cargo?",
            text = "Esta acción removerá el registro permanentemente si no cuenta con transacciones.",
            icon = "warning",
            showCancelButton = true,
            confirmButtonColor = "#D62F46",
            cancelButtonColor = "#FDC922",
            confirmButtonText = "Sí, eliminar",
            cancelButtonText = "Cancelar"
        });

        bool confirmado = resultadoSwal.ValueKind == System.Text.Json.JsonValueKind.Object &&
                          resultadoSwal.TryGetProperty("isConfirmed", out var propiedadConfirmado) &&
                          propiedadConfirmado.GetBoolean();

        if (!confirmado) return;

        cargando = true;
        StateHasChanged();

        try
        {
            var respuesta = await _cargosService.DeleteCargoAsync(id);

            if (respuesta != null && respuesta.EsCorrecto)
            {
                await js.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "success",
                    title = "¡Eliminado!",
                    text = "El cargo ha sido removido con éxito.",
                    confirmButtonText = "Aceptar",
                    confirmButtonColor = "#D62F46"
                });

                await CargarCargosAsync();
            }
            else
            {
                string mensajeServidor = respuesta?.Mensaje ?? "No se pudo procesar la solicitud.";
                await MostrarAlertaError("No se puede eliminar", mensajeServidor, respuesta?.Errores);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error durante el proceso de borrado: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    // --- AYUDANTES DE ALERTAS ---
    private async Task MostrarAlertaError(string titulo, string mensaje, IEnumerable<string>? errores = null)
    {
        string erroresHtml = errores != null && errores.Any() ? string.Join("<br>", errores) : "";
        await js.InvokeVoidAsync("Swal.fire", new
        {
            icon = "error",
            title = titulo,
            html = string.IsNullOrEmpty(erroresHtml) ? mensaje : $"{mensaje}<br>{erroresHtml}",
            confirmButtonColor = "#6c1d1d"
        });
    }

    // --- REDIRECCIONES ---
    private void IrACrearCargo() => nav.NavigateTo("/Administrar/Cargos/Crear");
    private void EditarCargo(int id) => nav.NavigateTo($"/Administrar/Cargos/Editar/{id}");
    private void Volver() => nav.NavigateTo("/administrar-Nomina");
    private void VerDetalle(int id) => nav.NavigateTo($"/Administrar/Cargos/Detalle/{id}");
}