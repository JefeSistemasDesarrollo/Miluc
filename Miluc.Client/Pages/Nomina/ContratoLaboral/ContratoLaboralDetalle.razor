@page "/api/ContratoLaboral/{idempleado:int}"

@using System.Text.Json
@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.ContratoLaboralDto
@using TuProyecto.Client.Services

@inject NavigationManager nav
@inject IContratoLaboralClientService _contratoService
@inject IEmpleadoClientService EmpleadoService
@inject IJSRuntime JS

<div class="empleado-page p-4 animate__animated animate__fadeIn">
    <div class="container-fluid max-width-container">

        @* --- CABECERA DE LA PÁGINA --- *@
        <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
            <div>
                <h2 class="fw-extrabold text-black m-0 tracking-tight">
                    <i class="bi bi-file-earmark-text me-2 header-icon"></i>
                    Detalle del Contrato Laboral
                </h2>
                <p class="text-muted mb-0 small mt-1">
                    Empleado: <strong class="text-dark fs-6">@nombreEmpleado</strong>
                </p>
            </div>
            <button class="btn btn-rojo btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i> Volver
            </button>
        </div>

        @if (cargando)
        {
            <div class="d-flex justify-content-center align-items-center my-5 py-5">
                <div class="spinner-border text-rojo" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Cargando datos...</span>
                </div>
            </div>
        }
        else
        {
            @* --- GRID DE TARJETAS DE CONTRATO --- *@
            <div class="row g-4 mb-4">
                @if (listaContratos != null && listaContratos.Any())
                {
                    @for (int i = 0; i < listaContratos.Count; i++)
                    {
                        var contrato = listaContratos[i];
                        bool estaActivo = contrato.Activo ?? true;

                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card h-100 shadow-sm border-0 border-start border-4">
                                <div class="card-body p-4 border-rojo rounded-4">
                                    <div class="d-flex align-items-center gap-2 mb-3 text-muted text-uppercase small fw-bold tracking-wider">
                                        <i class="bi bi-person-badge text-danger fs-5"></i> Datos Contrato
                                    </div>

                                    <h5 class="fw-bold text-dark mb-1">Contrato #@(i + 1)</h5>
                                    <p class="text-muted small mb-1">
                                        Empleado: <strong class="text-dark">@nombreEmpleado</strong>
                                    </p>
                                    <p class="text-muted small mb-2">Empresa: <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(contrato.NombreEmpresa) ? "No especificada" : contrato.NombreEmpresa)</span></p>

                                    <div class="d-flex flex-column gap-2 border-top pt-3 small">
                                        <div class="d-flex justify-content-between gap-2">
                                            <span class="text-muted">Tipo Contrato:</span>
                                            <strong class="text-dark">@(string.IsNullOrEmpty(contrato.NombreTipoContrato) ? "No especificado" : contrato.NombreTipoContrato)</strong>
                                        </div>

                                        <div class="d-flex justify-content-between gap-2">
                                            <span class="text-muted">Centro de Costo:</span>
                                            <strong class="text-dark">
                                                @(string.IsNullOrEmpty(contrato.NombreCentroCosto) 
                                                    ? (contrato.CentroCostoId > 0 ? $"Centro #{contrato.CentroCostoId}" : "Sin asignar") 
                                                    : contrato.NombreCentroCosto)
                                            </strong>
                                        </div>

                                        <div class="d-flex justify-content-between gap-2">
                                            <span class="text-muted">Cargo:</span>
                                            <strong class="text-dark">@(string.IsNullOrEmpty(contrato.NombreCargo) ? "Sin cargo" : contrato.NombreCargo)</strong>
                                        </div>

                                        <div class="d-flex justify-content-between gap-2">
                                            <span class="text-muted">Salario:</span>
                                            <strong class="text-dark">$@(contrato.Salario.ToString("N0", _culture))</strong>
                                        </div>

                                        <div class="d-flex justify-content-between gap-2">
                                            <span class="text-muted">Fecha Inicio:</span>
                                            <strong class="text-dark">@(contrato.FechaInicio?.ToString("dd/MM/yyyy") ?? "-")</strong>
                                        </div>

                                        <div class="d-flex justify-content-between gap-2">
                                            <span class="text-muted">Fecha Fin:</span>
                                            <strong class="text-dark">@(contrato.FechaFinalizacion?.ToString("dd/MM/yyyy") ?? "Indefinido")</strong>
                                        </div>

                                        <div class="d-flex justify-content-between gap-2">
                                            <span class="text-muted">Fecha Terminación:</span>
                                            <strong class="text-dark">@(contrato.FechaTerminacion?.ToString("dd/MM/yyyy") ?? "Vigente")</strong>
                                        </div>

                                        <div class="d-flex justify-content-between gap-2">
                                            <span class="text-muted">Observaciones:</span>
                                            <strong class="text-dark">@(string.IsNullOrEmpty(contrato.Observacion) ? "Sin observaciones" : contrato.Observacion)</strong>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center">
                                            <label class="form-label label-custom mb-0">Estado</label>

                                            @if (estaActivo)
                                            {
                                                <i class="bi text-black bi-check2-circle"></i>
                                            }
                                            else
                                            {
                                                <i class="bi text-rojo bi-x-circle me-1"></i>
                                            }
                                        </div>
                                    </div>

                                    @* Botón Editar *@
                                    <button class="btn btn-white btn-sm px-2 border-end edit mt-3"
                                            title="Editar Contrato"
                                            @onclick="() => EditarContrato(contrato.ContratoLaboralId)">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </button>

                                    @* Botón Terminar/Inhabilitar *@
                                    <button class="btn btn-white btn-sm px-2 border-end delete mt-3"
                                            title="Terminar Contrato"
                                            @onclick="() => InhabilitarContrato(contrato.ContratoLaboralId)">
                                        <i class="bi text-rojo bi-clipboard2-x "></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted py-5">
                        <p>No se encontraron contratos registrados para este empleado.</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* Modal Terminar Contrato *@
@if (mostrarModalInhabilitar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header bg-light border-bottom px-4 py-3">
                    <h5 class="modal-title fw-bold text-dark fs-6 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill text-rojo me-2 fs-5"></i> Terminar Contrato
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body p-4">
                    <EditForm Model="modeloInhabilitacion" OnValidSubmit="GuardarInhabilitacionAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Fecha de Terminación<span class="text-rojo">*</span></label>
                            <InputDate @bind-Value="modeloInhabilitacion.FechaTerminacion" class="form-control rounded-3" />
                            <ValidationMessage For="@(() => modeloInhabilitacion.FechaTerminacion)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Observación<span class="text-rojo">*</span></label>
                            <InputTextArea @bind-Value="modeloInhabilitacion.Observacion" class="form-control rounded-3" rows="3" placeholder="Motivo de la terminación..." />
                            <ValidationMessage For="@(() => modeloInhabilitacion.Observacion)" class="text-danger small mt-1" />
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                            <button type="button" class="btn btn-amarillo btn-miluc-amarillo rounded-pill px-3 py-2 fw-semibold small" @onclick="CerrarModal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-rojo btn-miluc rounded-pill px-3 py-2 fw-semibold small shadow-sm">
                                Confirmar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int idempleado { get; set; }

    private List<ContratoLaboralreaderDto> listaContratos = new();
    private string nombreEmpleado = string.Empty;
    private bool cargando = true;

    private bool mostrarModalInhabilitar = false;
    private int contratoIdSeleccionado;

    private InhabilitarContratoDto modeloInhabilitacion = new();

    private readonly System.Globalization.CultureInfo _culture = System.Globalization.CultureInfo.GetCultureInfo("es-CO");

    private void Volver() => nav.NavigateTo("/Administrar/contratoLaboral");

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        try
        {
            if (idempleado <= 0)
            {
                await JS.InvokeVoidAsync("Swal.fire", "Error", "ID de empleado no válido.", "error");
                Volver();
                return;
            }

            var tareaContratos = _contratoService.GetContratosPorEmpleadoAsync(idempleado);
            var tareaEmpleado = EmpleadoService.GetEmpleadoByIdAsync(idempleado);

            await Task.WhenAll(tareaContratos, tareaEmpleado);

            var responseEmpleado = await tareaEmpleado;
            if (responseEmpleado != null && responseEmpleado.EsCorrecto && responseEmpleado.Valor != null)
            {
                var emp = responseEmpleado.Valor;
                nombreEmpleado = $"{emp.PrimerNombre} {emp.SegundoNombre ?? ""} {emp.PrimerApellido} {emp.SegundoApellido ?? ""}".Replace("  ", " ").Trim();
            }
            else
            {
                nombreEmpleado = $"Colaborador #{idempleado}";
            }

            var responseContratos = await tareaContratos;
            if (responseContratos != null && responseContratos.EsCorrecto && responseContratos.Valor != null)
            {
                listaContratos = responseContratos.Valor;
            }
            else
            {
                listaContratos = new List<ContratoLaboralreaderDto>();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", $"Error al cargar los contratos: {ex.Message}", "error");
            nombreEmpleado = "Empleado";
            listaContratos = new List<ContratoLaboralreaderDto>();
        }
        finally
        {
            cargando = false;
        }
    }

    private void InhabilitarContrato(int contratoId)
    {
        contratoIdSeleccionado = contratoId;
        modeloInhabilitacion = new InhabilitarContratoDto
        {
            FechaTerminacion = DateTime.Today,
            Activo = false
        };
        mostrarModalInhabilitar = true;
    }

    private void CerrarModal()
    {
        mostrarModalInhabilitar = false;
        modeloInhabilitacion = new();
    }

    private async Task GuardarInhabilitacionAsync()
    {
        try
        {
            modeloInhabilitacion.ContratoLaboralId = contratoIdSeleccionado;
            modeloInhabilitacion.Activo = false;

            var response = await _contratoService.InhabilitarContratoAsync(modeloInhabilitacion);

            if (response != null && response.EsCorrecto)
            {
                await JS.InvokeVoidAsync("Swal.fire", "¡Éxito!", "El contrato ha sido inhabilitado correctamente.", "success");
                CerrarModal();
                await CargarDatosAsync();
            }
            else
            {
                var mensajeError = response?.Mensaje ?? "No se pudo completar la operación.";
                await JS.InvokeVoidAsync("Swal.fire", "Error", mensajeError, "error");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", $"Error de conexión: {ex.Message}", "error");
        }
    }

    private void EditarContrato(int contratoLaboralId)
    {
        nav.NavigateTo($"/Administrar/Contrato/Editar/{contratoLaboralId}");
    }
}