@page "/Administrar/contratoLaboral"
@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.EmpleadoDto
@using Miluc.Shared.DTOs.Nomina.ContratoLaboralDto
@inject NavigationManager nav
@inject IContratoLaboralClientService _contratoLaboralClientService
@inject IAfSeguridadSocialClientService afSeguridadSocialClientService
@inject IJSRuntime js

<div class="afiliaciónEmpleados-page animate__animated animate__fadeIn p-4">

    <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
        <div>
            <h2 class="fw-extrabold text-black m-0 tracking-tight">
                <i class="bi bi-people-fill"></i>
                Seguridad Social
            </h2>
            <p class="text-muted mb-0 small mt-1">
                Administración seguridad social del empleado.
            </p>
        </div>

        <button class="btn btn-rojo btn-nuevo rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
            <i class="bi bi-arrow-left me-2"></i> Volver
        </button>
    </div>
</div>

@* SECCIÓN DE FILTROS: Buscador y Selector de cantidad de registros *@
<div class="card shadow-sm border-0 mb-4 rounded-4">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">

            @* Barra de búsqueda *@
            <div class="col-lg-7">
                <div class="input-group input-group-lg search-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>

                    <input type="text" class="form-control border-start-0 shadow-none fs-6"
                           placeholder="Filtrar local o buscar en servidor..."
                           @bind="textoBusqueda" @bind:event="oninput" @onkeyup="HandleEnter" />

                    <button class="btn btn-rojo rounded-end-pill px-4" @onclick="BuscarEnServidor">
                        <i class="bi bi-search me-2"></i>
                    </button>
                </div>
            </div>

            @* Selector de paginación y Badge de Total *@
            <div class="col-lg-5 text-lg-end">
                <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border">
                    <label class="mx-3 small fw-bold text-muted text-uppercase">Mostrar</label>

                    <select class="form-select form-select-sm rounded-pill border-0 bg-transparent fw-bold"
                            style="width: 80px;"
                            value="@cantidadPorPagina"
                            @onchange="CambiarCantidadPagina">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>

                    <span class="badge bg-rojo rounded-pill ms-2 px-3 py-2">
                        Total: @totalRegistros
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@* TABLA DE AFILIACIONES *@
<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="bg-rojo text-white">
                <tr>
                    <th class="ps-4 py-3  text-rojo text-start">Empleado</th>
                    <th class="ps-4 py-3 text-rojo text-start">Documento</th>
                    <th class="text-center text-rojo">NombreEmpresa</th>
                    <th class="text-center text-rojo">NombreTipoContrato</th>
                    <th class="text-center text-rojo">Cargo</th>                    
                    <th class="text-center text-rojo">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white">

                @if (cargando)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="spinner-border text-vinotinto"></div>
                        </td>
                    </tr>
                }
                else if (!listempleadosAlservidor.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            No hay registros de contrato laboral encontrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var em in listempleadosAlservidor)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="text-dark fw-semibold small text-uppercase">@em.NombreEmpleado</div>
                            </td>
                            <td class="ps-4">
                                <div class="text-dark fw-semibold small text-uppercase">@em.Documento</div>
                            </td>
                            <td>
                                <div class="text-muted x-small text-uppercase text-center">@em.NombreEmpresa</div>
                            </td>
                            <td>
                                <div class="text-muted x-small text-uppercase text-center">@em.NombreTipoContrato</div>
                            </td>
                            <td>
                                <div class="text-muted x-small text-uppercase text-center">@em.Cargo</div>
                            </td>
                            

        
                            <td class="text-center">
                                @if (em.Activo ?? false)
                                {

                                    <i class="bi  text-black bi-check2-circle"></i>

                                }
                                else
                                {

                                    <i class="bi text-rojo bi-x-circle"></i>

                                }
                            </td> 

                            @* Columna de Acciones Limpia *@
                            <td class="text-center pe-4">
                                <div class="btn-group shadow-sm border rounded-pill bg-white overflow-hidden">
                                    <button class="btn  btn-sm px-3" title="Ver Detalle" @onclick="() => VerDetalle(em.EmpleadoId)">
                                        <i class="bi bi-eye text-black-"></i>
                                    </button>
                                    <button class="btn btn-white btn-sm px-3" title="Modificar Seguridad Social" @onclick="() => ModificarSeguridadSocial(em.EmpleadoId)">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }

                                  
                }
                }
            </tbody>
        </table>
    </div>

    
    @* SECCIÓN DE PAGINACIÓN (PIE DE TABLA) *@
    <div class="pagination-footer d-flex justify-content-between align-items-center mt-4 p-3">
        <div class=" text-amarillo small">Página <b>@paginaActual</b> de @totalPaginas</div>

        <div class="page-item.active pagination-container p-1 bg-white border rounded-pill shadow-sm">
            <button class="btn btn-sm rounded-circle @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)">
                <i class="bi bi-chevron-left"></i>
            </button>

            <span class="mx-3 fw-bold text-rojo">@paginaActual</span>

            <button class="btn btn-sm rounded-circle @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

@code {
    private List<ContratoLabralreaderDto> listempleadosOrigen = new List<ContratoLabralreaderDto>();
    private List<ContratoLabralreaderDto> listempleadosAlservidor = new List<ContratoLabralreaderDto>();

    private string _textoBusqueda = "";

    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            FiltrarLocal();
        }
    }

    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private int totalRegistros = 0;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await cargarAfiliaciones();
    }

    public async Task cargarAfiliaciones()
    {
        cargando = true;

        // Invocación a tu servicio de seguridad social con paginación
        var respuesta = await _contratoLaboralClientService.GetContratoLaboralAsync(textoBusqueda, paginaActual, cantidadPorPagina);

        if (respuesta != null && respuesta.EsCorrecto)
        {
            listempleadosOrigen = respuesta.Valor;
            listempleadosAlservidor = respuesta.Valor;
            totalRegistros = respuesta.CantRegistros;
        }

        cargando = false;
    }

    private void FiltrarLocal()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            listempleadosAlservidor = listempleadosOrigen;
        }
        else
        {
            listempleadosAlservidor = listempleadosOrigen.Where(e =>

                e.NombreEmpleado.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) /* || */
                // e.ContratoLaboralDetalleId.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                // e.EmpresaId.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                // e.TipoContratoId.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) 
                
            ).ToList();
        }
    }

    public async Task BuscarEnServidor()
    {
        paginaActual = 1;
        cargando = true;

        var respuesta = await _contratoLaboralClientService.GetContratoLaboralAsync(textoBusqueda, paginaActual, cantidadPorPagina);

        if (respuesta != null && respuesta.EsCorrecto)
        {
            listempleadosOrigen = respuesta.Valor;
            listempleadosAlservidor = respuesta.Valor;
            totalRegistros = respuesta.CantRegistros;
        }
        else
        {
            listempleadosOrigen = new List<ContratoLabralreaderDto>();
            listempleadosAlservidor = new List<ContratoLabralreaderDto>();
            totalRegistros = 0;

            string erroresConcatenados = respuesta?.Errores != null && respuesta.Errores.Any()
               ? string.Join("<br>", respuesta.Errores)
               : "Ocurrió un error inesperado.";

            await js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = $"Error al consultar la seguridad social",
                text = $"{erroresConcatenados}",
                confirmButtonColor = "#6c1d1d"
            });
        }

        cargando = false;
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            paginaActual = 1;
            await BuscarEnServidor();
        }
    }

    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        cantidadPorPagina = int.Parse(e.Value!.ToString()!);
        paginaActual = 1;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            await cargarAfiliaciones();
        }
        else
        {
            await BuscarEnServidor();
        }
    }

    private int totalPaginas
    {
        get
        {
            var total = string.IsNullOrWhiteSpace(_textoBusqueda)
                ? totalRegistros
                : listempleadosAlservidor.Count;

            return (int)Math.Ceiling((double)total / cantidadPorPagina);
        }
    }

    private async Task IrPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > totalPaginas)
            return;

        paginaActual = nuevaPagina;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await cargarAfiliaciones();
        else
            await BuscarEnServidor();
    }

    private void VerDetalle(int idempleado)
    {
        nav.NavigateTo($"/nomina/detalle/{idempleado}");
    }

    private void ModificarSeguridadSocial(int idempleado)
    {

        nav.NavigateTo($"/nomina/seguridad-social/editar/{idempleado}");
    }

    private void Volver() => nav.NavigateTo("/Gestionar/Afiliaciones");
}
