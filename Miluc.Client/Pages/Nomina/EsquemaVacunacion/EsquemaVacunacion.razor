@page "/esquema-vacunacion"
@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.EsquemaVacunbacionDto
@inject NavigationManager nav
@inject IEsquemaVacunacionClientService _esquemaVacunacionService
@inject IJSRuntime js

<div class="EsquemaVacunacion-page animate__animated animate__fadeIn p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-vinotinto m-0">
                <i class="bi bi-shield-plus-fill me-2"></i>Gestionar Esquema de Vacunación
            </h2>
            <p class="m-0 text-muted">Administración de esquemas de vacunación</p>
        </div>
        <button class="btn btn-vinotinto rounded-pill px-4 shadow-sm" @onclick="IrACrearEsquemaVacunacion">
            <i class="bi bi-plus"></i> Crear Esquema
        </button>
    </div>

    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-lg-7">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input class="form-control"
                               placeholder="Filtrar local o buscar en servidor..."
                               @bind="textoBusqueda"
                               @bind:event="oninput"
                               @onkeyup="HandleEnter" />
                        <button class="btn btn-vinotinto" @onclick="BuscarEnServidor">
                            Buscar
                        </button>
                    </div>
                </div>

                <div class="col-lg-5 text-end">
                    <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill">
                        <label class="mx-2 small">Mostrar</label>
                        <select class="form-select form-select-sm" style="width:80px" value="@cantidadPorPagina" @onchange="CambiarCantidadPagina">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                        <span class="badge bg-vinotinto ms-2">
                            Total: @totalRegistros
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="bg-vinotinto text-white">
                    <tr>
                        <th class="text-center">Empleado</th>
                        <th class="text-center">vacuna</th>
                        <th class="text-center">Fecha Vacuna</th>
                        <th class="text-center" style="width: 150px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="2" class="text-center py-5">
                                <div class="spinner-border text-vinotinto"></div>
                            </td>
                        </tr>
                    }
                    else if (!listaEsquemaVacunacion.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center py-5">
                                No hay esquemas de vacunación registrados
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in listaEsquemaVacunacion)
                        {
                            <tr>
                                <td class="text-center align-middle">@item.NombreEmpleado</td>
                                <td class="text-center" align-middle">@item.VacunaName</td>
                                <td class="text-center"align-middle">@item.FechaVacuna</td>
                                


                                <td class="text-center align-middle">
                                    <div class="btn-group shadow-sm border rounded-pill bg-white">
                                        <button class="btn btn-sm btn-dark" @onclick="() => VerDetalle(item.EsquemaVacunacionId)" title="Ver Detalle">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-white border-end" @onclick="() => Editar(item.EsquemaVacunacionId)" title="Editar">
                                            <i class="bi bi-pencil-square text-primary"></i>
                                        </button>
                                        <button class="btn btn-sm btn-white" @onclick="() => Eliminar(item.EsquemaVacunacionId)" title="Eliminar">
                                            <i class="bi bi-trash3 text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <div class="pagination-footer d-flex justify-content-between align-items-center p-3 border-top">
                <div class="small text-muted">
                    Página <b>@paginaActual</b> de @totalPaginas
                </div>
                <div class="p-1 bg-white border rounded-pill shadow-sm">
                    <button class="btn btn-sm @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="mx-2 fw-bold text-vinotinto">@paginaActual</span>
                    <button class="btn btn-sm @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<EsquemaVacunacionReaderDto> listaOrigen = new();
    private List<EsquemaVacunacionReaderDto> listaEsquemaVacunacion = new();

    private string _textoBusqueda = "";
    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            FiltrarLocal();
        }
    }

    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private int totalRegistros = 0;
    private bool cargando = false;

    private int totalPaginas => totalRegistros == 0 ? 1 : (int)Math.Ceiling((double)totalRegistros / cantidadPorPagina);

    protected override async Task OnInitializedAsync()
    {
        await CargarEsquemaVacunacion();
    }

    private async Task CargarEsquemaVacunacion()
    {
        cargando = true;
        try
        {
            var response = await _esquemaVacunacionService.GetEsquemaAsync(textoBusqueda, paginaActual, cantidadPorPagina);
            if (response != null && response.EsCorrecto)
            {
                listaOrigen = response.Valor ?? new();
                listaEsquemaVacunacion = listaOrigen.ToList();
                totalRegistros = response.CantRegistros;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar esquemas: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void FiltrarLocal()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            listaEsquemaVacunacion = listaOrigen.ToList();
        }
        else
        {
            listaEsquemaVacunacion = listaOrigen.Where(x =>
                x.NombreEmpleado != null && x.NombreEmpleado.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)||
                x.VacunaName.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevaCantidad))
        {
            cantidadPorPagina = nuevaCantidad;
            paginaActual = 1;
            await CargarEsquemaVacunacion();
        }
    }

    private async Task BuscarEnServidor()
    {
        paginaActual = 1;
        await CargarEsquemaVacunacion();
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarEnServidor();
        }
    }

    private async Task IrPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= totalPaginas)
        {
            paginaActual = nuevaPagina;
            await CargarEsquemaVacunacion();
        }
    }

    private void IrACrearEsquemaVacunacion() => nav.NavigateTo("/esquema-vacunacion/crear");
    private void VerDetalle(int id) => nav.NavigateTo($"/esquema-vacunacion/detalle/{id}");
    private void Editar(int id) => nav.NavigateTo($"/esquema-vacunacion/editar/{id}");

    private async Task Eliminar(int id)
    {
        bool confirmado = await js.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar este esquema de vacunación?");
        if (confirmado)
        {
            // await _esquemaVacunacionService.DeleteAsync(id);
            await CargarEsquemaVacunacion();
        }
    }
}