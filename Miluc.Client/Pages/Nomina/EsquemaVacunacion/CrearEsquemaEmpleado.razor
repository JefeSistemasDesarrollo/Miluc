@page "/nomina/crear/esquemaVacunacion/{idempleado:int}"
@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.EsquemaVacunacionDto
@using Miluc.Shared.DTOs.Nomina.Vacunacion
@using Miluc.Shared.DTOs.Nomina.EmpleadoDto

@inject NavigationManager nav
@inject IEmpleadoClientService _empleadoService
@inject IEsquemaVacunacionClienteService _esquemaVacunacionService
@inject IVacunaClientService _vacunaService
@inject IJSRuntime JS

<div class="empleado-page p-4 animate__animated animate__fadeIn">
    <div class="container-fluid max-width-container">

        @* --- HEADER --- *@
        <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
            <div>
                <h2 class="fw-extrabold text-black m-0 tracking-tight">
                    <i class="bi bi-shield-plus me-2 header-icon"></i>
                    Registrar Esquema de Vacunación
                </h2>
                <p class="text-muted mb-0 small mt-1">
                    Gestione el registro del esquema de vacunación del empleado. Los campos marcados con <span class="text-danger">*</span> son requeridos.
                </p>
            </div>
            <button class="btn btn-rojo btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i> Volver al listado
            </button>
        </div>

        @* --- FORMULARIO PARA AGREGAR A LA LISTA TEMPORAL --- *@
        <EditForm Model="createEsquema" OnValidSubmit="AgregarAListaTemporal">
            <DataAnnotationsValidator />

            <div class="col-12">
                <div class="card card-custom border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <div class="section-title-container mb-4">
                            <span class="badge bg-vinotinto-light text-vinotinto rounded-pill mb-2 px-3 py-2 fw-bold text-uppercase tracking-wider">Paso 1</span>
                            <h5 class="fw-bold text-dark m-0">Selección de Vacunación</h5>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label label-custom"><span class="input-icon"><i class="bi bi-capsule"></i></span> Vacuna<span class="text-danger">*</span></label>
                                <div class="input-group-custom">
                                    <InputSelect @bind-Value="createEsquema.VacunaId" class="form-control input-custom">
                                        <option value="0">-- Seleccionar vacuna --</option>
                                        @foreach (var vacuna in listVacuna)
                                        {
                                            <option value="@vacuna.VacunaId">@vacuna.VacunaName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <ValidationMessage For="@(() => createEsquema.VacunaId)" class="text-danger small mt-1 d-block fw-medium" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label label-custom"><span class="input-icon"><i class="bi bi-calendar-event"></i></span> Fecha de Vacunación<span class="text-danger">*</span></label>
                                <div class="input-group-custom">
                                    <InputDate class="form-control input-custom" @bind-Value="createEsquema.FechaVacuna" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <ValidationMessage For="@(() => createEsquema.FechaVacuna)" class="text-danger small mt-1 d-block fw-medium" />
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-light d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-rojo rounded-pill px-4">
                            <i class="bi bi-plus-circle me-2"></i> Añadir a la Lista Temporal
                        </button>
                    </div>
                </div>
            </div>
        </EditForm>

        @* --- TABLA: COLA TEMPORAL POR REGISTRAR (PENDIENTES DE GUARDAR) --- *@
        @if (listaesquema.Any())
        {
            <div class="col-12 mt-4">
                <div class="card shadow-sm border-0 border-start border-warning border-4">
                    <div class="card-header bg-gris py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 text-black fw-bold">
                            <i class="bi bi-exclamation-circle-fill me-2 text-warning"></i> Vacunas pendientes por guardar (@listaesquema.Count)
                        </h6>

                        <button type="button"
                                class="btn btn-rojo rounded-pill px-4 fw-semibold"
                                @onclick="PersistirEnBaseDeDatos"
                                disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Guardando en Servidor...</span>
                            }
                            else
                            {
                                <span>Guardar</span>
                            }
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-rojo small text-uppercase">
                                <tr>
                                    <th>Vacuna</th>
                                    <th>Fecha de Aplicación</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var temp in listaesquema)
                                {
                                    bool esReemplazo = listaEsquemaReader.Any(x => x.VacunaId == temp.VacunaId && (x.Activo ?? false));

                                    <tr>
                                        <td class="fw-semibold">
                                            @temp.NombreVacuna
                                            @if (esReemplazo)
                                            {
                                                <span class="badge bg-warning text-dark ms-2" title="Inactivará la dosis registrada anteriormente y activará esta nueva fecha">
                                                    <i class="bi bi-arrow-repeat me-1"></i> Nueva dosis (Inactiva anterior)
                                                </span>
                                            }
                                        </td>
                                        <td>@(temp.FechaVacuna?.ToString("dd/MM/yyyy") ?? "Sin Fecha")</td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-rojo rounded-pill" @onclick="() => RemoveDeListaTemporal(temp)">
                                                <i class="bi bi-x-circle me-1"></i> Quitar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @* Botón de cancelación *@
        <div class="mt-4 d-flex justify-content-end">
            <button type="button" class="btn btn-secondary rounded-pill px-4 py-2 fw-semibold" @onclick="Volver">
                Cancelar
            </button>
        </div>

    </div>
</div>

@code {
    [Parameter] public int idempleado { get; set; }

    private CreateEsquemaVacunacionDto createEsquema = new();
    private List<EsquemaVacunacionReaderDto> listaEsquemaReader = new();
    private List<CreateEsquemaVacunacionDto> listaesquema = new();
    private List<VacunaReaderDto> listVacuna = new();
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        ResetFormulario();
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        try
        {
            var respuestaVacunas = await _vacunaService.GetVacunaAsync();
            if (respuestaVacunas != null && respuestaVacunas.EsCorrecto && respuestaVacunas.Valor != null)
            {
                listVacuna = respuestaVacunas.Valor;
            }
            else
            {
                Console.WriteLine($"[ERROR CATALOGO VACUNAS]: {respuestaVacunas?.Mensaje ?? "Respuesta nula del servidor."}");
            }

            var respuestaEsquemas = await _esquemaVacunacionService.GetEsquemaVacunacionByIdAsync(idempleado);
            if (respuestaEsquemas != null && respuestaEsquemas.EsCorrecto && respuestaEsquemas.Valor != null)
            {
                listaEsquemaReader = respuestaEsquemas.Valor;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[EXCEPCIÓN CARGA INICIAL]: {ex.Message}");
        }
    }

    private void AgregarAListaTemporal()
    {
        if (createEsquema.VacunaId <= 0)
        {
            JS.InvokeVoidAsync("Swal.fire", "Advertencia", "Debe seleccionar una vacuna válida.", "warning");
            return;
        }

        // Se valida ÚNICAMENTE contra la lista temporal actual para evitar duplicados en el mismo envío
        if (listaesquema.Any(f => f.VacunaId == createEsquema.VacunaId))
        {
            JS.InvokeVoidAsync("Swal.fire", "Error", "La vacuna ya se encuentra agregada en la lista pendiente por guardar.", "error");
            return;
        }

        var vacunaSeleccionada = listVacuna.FirstOrDefault(x => x.VacunaId == createEsquema.VacunaId);

        var nuevoItem = new CreateEsquemaVacunacionDto
        {
            EmpleadoId = idempleado,
            VacunaId = createEsquema.VacunaId,
            NombreVacuna = vacunaSeleccionada?.VacunaName ?? "Vacuna Seleccionada",
            FechaVacuna = createEsquema.FechaVacuna ?? DateTime.Today
        };

        listaesquema.Add(nuevoItem);
        ResetFormulario();
        StateHasChanged();
    }

    private void RemoveDeListaTemporal(CreateEsquemaVacunacionDto dto)
    {
        listaesquema.Remove(dto);
        StateHasChanged();
    }

    private async Task PersistirEnBaseDeDatos()
    {
        if (isProcessing || !listaesquema.Any()) return;
        isProcessing = true;

        try
        {
            var respuesta = await _esquemaVacunacionService.CreateEsquemaVacunacionAsync(listaesquema);

            if (respuesta != null && respuesta.EsCorrecto)
            {
                await JS.InvokeVoidAsync("Swal.fire", "¡Éxito!", "El esquema de vacunación se ha registrado correctamente.", "success");

                // Limpiar cola temporal y recargar registros actualizados del empleado
                listaesquema.Clear();
                await CargarDatosIniciales();
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", "Error", $"No se pudo guardar el esquema: {respuesta?.Mensaje ?? "Error del servidor"}", "error");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error Fatal", $"Ocurrió un error inesperado: {ex.Message}", "error");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void ResetFormulario()
    {
        createEsquema = new CreateEsquemaVacunacionDto
        {
            EmpleadoId = idempleado,
            VacunaId = 0,
            NombreVacuna = null,
            FechaVacuna = DateTime.Today
        };
    }

    private void Volver() => nav.NavigateTo("/api/EsquemaVacunacion/Esquemas");
}