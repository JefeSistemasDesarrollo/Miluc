@page "/editar/api/Afp/{afpid:int}"

@using System.Linq
@using Miluc.Client.Interfaces.Nomina.SeguridadSocial
@using Miluc.Shared.DTOs.Nomina.AfpDto

@inject NavigationManager nav
@inject IAfpClientService _afpService
@inject IJSRuntime JS

<div class="empleado-page p-4 animate__animated animate__fadeIn">
    <div class="container-fluid max-width-container">

        @* --- HEADER --- *@
        <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
            <div>
                <h2 class="fw-extrabold text-vinotinto m-0 tracking-tight">
                    <i class="bi bi-pencil-square me-2 header-icon"></i>
                    Editar Afp
                </h2>
                <p class="text-muted mb-0 small mt-1">
                    Modifique la información de la entidad Administradora de Fondos de Pensiones. Los campos marcados con <span class="text-danger">*</span> son requeridos.
                </p>
            </div>

            <button class="btn btn-vinotinto btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i> Volver al listado
            </button>
        </div>

        @if (updateAfp == null)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-vinotinto" role="status">
                    <span class="visually-hidden">Cargando datos de la Afp...</span>
                </div>
            </div>
        }
        else
        {
            @* --- FORMULARIO DE EDICIÓN --- *@
            <EditForm Model="updateAfp" OnValidSubmit="ActualizarAfp">
                <DataAnnotationsValidator />

                <div class="col-12">
                    <div class="card card-custom border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="section-title-container mb-4">
                                <h5 class="fw-bold text-dark m-0">Datos de la Afp</h5>
                            </div>

                            <div class="row g-4">
                                @* Nombre de la EPS *@
                                <div class="col-md-4">
                                    <label class="form-label label-custom"><span class="input-icon"><i class="bi bi-hospital"></i></span> Nombre de la AFP*</label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="updateAfp.Nombre" placeholder="Ej: PROTECCION AFP" />
                                    </div>
                                    <ValidationMessage For="@(() => updateAfp.Nombre)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>

                                @* Código de Entidad *@
                                <div class="col-md-4">
                                    <label class="form-label label-custom"><span class="input-icon"><i class="bi bi-barcode"></i></span> Código de Entidad*</label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="updateAfp.Codigo" placeholder="Ej: Afp001" />
                                    </div>
                                    <ValidationMessage For="@(() => updateAfp.Codigo)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>

                                @* Estado (Switch Activo/Inactivo) *@
                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom">Estado</label>
                                    <div class="card card-custom border-0 shadow-sm rounded-4">
                                        <div class="card-body input-custom py-2">
                                            <div class="form-check form-switch switch-lg d-flex align-items-center gap-2">
                                                <InputCheckbox class="form-check-input mt-0" @bind-Value="updateAfp.Activo" id="switchActivo" />
                                                <label class="form-check-label fw-semibold" for="switchActivo">
                                                    @if (updateAfp.Activo)
                                                    {
                                                        <span class="text-success">Activo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">Inactivo</span>
                                                    }
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* --- BOTONES DE ACCIÓN --- *@
                            <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-3">
                                <button type="button" class="btn btn-light-custom rounded-pill px-4 py-2.5 fw-semibold" @onclick="Volver">
                                    Cancelar
                                </button>

                                <button type="submit" class="btn btn-vinotinto btn-secondary rounded-pill px-4" disabled="@isProcessing">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Actualizando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-cloud-upload-fill me-2"></i>
                                        <span>Guardar Cambios</span>
                                    }
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public int AfpId { get; set; }

    private UpdateAfp updateAfp;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarAfp();
    }

    private async Task CargarAfp()
    {
        var resAfp = await _afpService.GetByAfpAsync(AfpId);

        if (resAfp != null && resAfp.EsCorrecto && resAfp.Valor != null)
        {
            var afpObtenida = resAfp.Valor;

            updateAfp = new UpdateAfp
            {
                AfpId = afpObtenida.AfpId,
                Nombre = afpObtenida.Nombre,
                Codigo = afpObtenida.Codigo,
                Activo = afpObtenida.Activo
            };
        }
        else
        {
            var msj = resAfp?.Mensaje ?? "No se encontró la Afp solicitada.";
            await JS.InvokeVoidAsync("Swal.fire", "Error", msj, "error");
            Volver();
        }
    }

    private async Task ActualizarAfp()
    {
        if (isProcessing) return;
        isProcessing = true;

        try
        {
            var respuesta = await _afpService.UpdateAfpAsync(updateAfp);

            if (!respuesta.EsCorrecto)
            {
                await JS.InvokeVoidAsync("Swal.fire", "Error", $"No se pudo actualizar: {respuesta.Mensaje}", "error");
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", "Éxito", "La AFP ha sido actualizada correctamente.", "success");
                Volver();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Fatal Error", $"Excepción interna: {ex.Message}", "error");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void Volver() => nav.NavigateTo("/api/Afp/Afp");
}