@page "/api/Afp/Afp"

@using Miluc.Client.Interfaces.Nomina.SeguridadSocial
@using Miluc.Client.Pages.Nomina.GestionDeAfiliaciones.Afp;
@using Miluc.Shared.DTOs.Nomina.Afp.Dto;
@inject HttpClient Http
@inject NavigationManager nav
@inject IJSRuntime js
@inject IAfpClientService _afpClientService

<div class="eps-page animate__animated animate__fadeIn p-4">

    @* ENCABEZADO Y BOTONES SUPERIORES *@
    <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
        <div>
            <h2 class="fw-extrabold text-vinotinto m-0 tracking-tight">
                <i class="bi bi-people-fill"></i>
                Gestión AFP
            </h2>
            <p class="text-muted mb-0 small mt-1">
                Administración de Administradora de Fondos de Pensiones.
            </p>
        </div>

        <button class="btn btn-vinotinto btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
            <i class="bi bi-arrow-left me-2"></i> Volver
        </button>
    </div>

    <button class="btn btn-vinotinto btn-nuevo rounded-pill px-4 shadow-sm mb-4" @onclick="IrACrearAfp">
        <i class="bi bi-plus-lg me-1"></i> Nueva AFP
    </button>

    @* SECCIÓN DE FILTROS: Buscador y Selector de cantidad de registros *@
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">

                @* Barra de búsqueda *@
                <div class="col-lg-7">
                    <div class="input-group input-group-lg search-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>

                        <input type="text" class="form-control border-start-0 shadow-none fs-6"
                               placeholder="Filtrar local o buscar en servidor..."
                               @bind="textoBusqueda" @bind:event="oninput" @onkeyup="HandleEnter" />

                        <button class="btn btn-vinotinto rounded-end-pill px-4" @onclick="BuscarEnServidor">
                            <i class="bi bi-search me-2"></i>
                        </button>
                    </div>
                </div>

                @* Selector de paginación y Badge de Total *@
                <div class="col-lg-5 text-lg-end">
                    <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border">
                        <label class="mx-3 small fw-bold text-muted text-uppercase">Mostrar</label>

                        <select class="form-select form-select-sm rounded-pill border-0 bg-transparent fw-bold"
                                style="width: 80px;"
                                value="@cantidadPorPagina"
                                @onchange="CambiarCantidadPagina">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>

                        <span class="badge bg-vinotinto rounded-pill ms-2 px-3 py-2">
                            Total: @totalRegistros
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* TABLA DE AFP *@
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="bg-vinotinto text-white">
                    <tr>
                        <th class="ps-4 py-3 text-start">Nombre</th>
                        <th class="ps-4 py-3 text-start">Código</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">

                    @if (cargando)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="spinner-border text-vinotinto"></div>
                            </td>
                        </tr>
                    }
                    else if (!listaAfpAlservidor.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var em in listaAfpAlservidor)
                        {
                            <tr>
                                <td class="ps-4 align-middle">
                                    <div class="text-dark fw-semibold small text-uppercase">@em.Nombre</div>
                                </td>
                                <td class="ps-4 align-middle">
                                    <div class="text-dark fw-semibold small text-uppercase">@em.Codigo</div>
                                </td>
                                <td class="text-center align-middle">
                                    @if (em.Activo)
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill">
                                            <i class="bi bi-x-circle me-1"></i> Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-center pe-4 align-middle">
                                    <div class="btn-group shadow-sm border rounded-pill bg-white overflow-hidden">
                                        <button class="btn btn-sm px-3" title="Ver Detalle" @onclick="() => VerDetalle(em.AfpId)">
                                            <i class="bi bi-eye text-dark"></i>
                                        </button>
                                        <button class="btn btn-white btn-sm px-3" title="Modificar AFP" @onclick="() => ModificarAfp(em.AfpId)">
                                            <i class="bi bi-pencil-square text-primary"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

    @* SECCIÓN DE PAGINACIÓN (PIE DE TABLA) *@
    <div class="pagination-footer d-flex justify-content-between align-items-center mt-4 p-3">
        <div class="page-link text-muted small border-0 bg-transparent">
            Página <b>@paginaActual</b> de @totalPaginas
        </div>

        <div class="pagination-container p-1 bg-white border rounded-pill shadow-sm">
            <button class="btn btn-sm rounded-circle @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)">
                <i class="bi bi-chevron-left"></i>
            </button>

            <span class="mx-3 fw-bold text-vinotinto">@paginaActual</span>

            <button class="btn btn-sm rounded-circle @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

@code {
    private List<AfpReaderDto> listaAfpOrigen = new List<AfpReaderDto>();
    private List<AfpReaderDto> listaAfpAlservidor = new List<AfpReaderDto>();

    private string _textoBusqueda = "";

    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            FiltrarLocal();
        }
    }

    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private int totalRegistros = 0;
    private bool cargando = false;

    private int totalPaginas
    {
        get
        {
            if (totalRegistros <= 0) return 1;
            return (int)Math.Ceiling((double)totalRegistros / cantidadPorPagina);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await cargarAfiliaciones();
    }

    public async Task cargarAfiliaciones()
    {
        cargando = true;

        var respuesta = await _afpClientService.GetAfpAsyc(_textoBusqueda, paginaActual, cantidadPorPagina);

        if (respuesta != null && respuesta.EsCorrecto)
        {
            listaAfpOrigen = respuesta.Valor ?? new List<AfpReaderDto>();
            totalRegistros = respuesta.CantRegistros;
        }
        else
        {
            listaAfpOrigen = new List<AfpReaderDto>();
            totalRegistros = 0;
        }

        FiltrarLocal();

        cargando = false;
    }

    private void FiltrarLocal()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            listaAfpAlservidor = listaAfpOrigen;
        }
        else
        {
            listaAfpAlservidor = listaAfpOrigen.Where(e =>
                (!string.IsNullOrEmpty(e.Codigo) && e.Codigo.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.Nombre) && e.Nombre.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    public async Task BuscarEnServidor()
    {
        paginaActual = 1;
        await cargarAfiliaciones();
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarEnServidor();
        }
    }

    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevaCantidad))
        {
            cantidadPorPagina = nuevaCantidad;
            paginaActual = 1;
            await cargarAfiliaciones();
        }
    }

    private async Task IrPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > totalPaginas)
            return;

        paginaActual = nuevaPagina;
        await cargarAfiliaciones();
    }

    private void VerDetalle(int idAfp)
    {
        nav.NavigateTo($"/nomina/detalle/{idAfp}");
    }

    private void ModificarAfp(int afpid)
    {
        nav.NavigateTo($"/editar/api/Afp/{afpid}");
    }

    private void Volver() => nav.NavigateTo("administrar-entidadesSeguridadSocial");
    private void IrACrearAfp() => nav.NavigateTo("/api/Afp/CrearAfp");
}