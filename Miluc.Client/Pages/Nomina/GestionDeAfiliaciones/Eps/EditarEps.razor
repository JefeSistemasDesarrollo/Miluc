@page "/editar/api/Eps/{epsid:int}"

@using System.Linq
@using Miluc.Client.Interfaces.Nomina.SeguridadSocial
@using Miluc.Shared.DTOs.Nomina.EpsDto

@inject NavigationManager nav
@inject IEpsClientService _epsService
@inject IJSRuntime JS

<div class="empleado-page p-4 animate__animated animate__fadeIn">
    <div class="container-fluid max-width-container">

        @* --- HEADER --- *@
        <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
            <div>
                <h2 class="fw-extrabold text-vinotinto m-0 tracking-tight">
                    <i class="bi bi-pencil-square me-2 header-icon"></i>
                    Editar EPS
                </h2>
                <p class="text-muted mb-0 small mt-1">
                    Modifique la información de la entidad promotora de salud. Los campos marcados con <span class="text-danger">*</span> son requeridos.
                </p>
            </div>

            <button class="btn btn-rojo btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i> Volver al listado
            </button>
        </div>

        @if (epsDto == null)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-rojo" role="status">
                    <span class="visually-hidden">Cargando datos de la EPS...</span>
                </div>
            </div>
        }
        else
        {
            @* --- FORMULARIO DE EDICIÓN --- *@
            <EditForm Model="epsDto" OnValidSubmit="ActualizarEps">
                <DataAnnotationsValidator />

                <div class="card card-custom border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="section-title-container mb-4">
                            <h5 class="fw-bold text-dark m-0">Datos de la EPS</h5>
                        </div>

                        <div class="row g-4 mb-4">
                            @* Nombre de la EPS *@
                            <div class="col-md-4">
                                <label class="form-label label-custom"><span class="input-icon"><i class="bi bi-hospital"></i></span> Nombre de la EPS<span class="text-danger">*</span></label>
                                <div class="input-group-custom">
                                    <InputText class="form-control input-custom" @bind-Value="epsDto.Nombre" placeholder="Ej: Sura EPS" />
                                </div>
                                <ValidationMessage For="@(() => epsDto.Nombre)" TValue="string" class="text-danger small mt-1 d-block fw-medium" />
                            </div>

                            @* Código de Entidad *@
                            <div class="col-md-4">
                                <label class="form-label label-custom"><span class="input-icon"><i class="bi bi-barcode"></i></span> Código de Entidad<span class="text-danger">*</span></label>
                                <div class="input-group-custom">
                                    <InputText class="form-control input-custom" @bind-Value="epsDto.Codigo" placeholder="Ej: EPS001" />
                                </div>
                                <ValidationMessage For="@(() => epsDto.Codigo)" TValue="string" class="text-danger small mt-1 d-block fw-medium" />
                            </div>

                            @* Estado (Switch Activo/Inactivo) *@
                            <div class="col-md-4">
                                <label class="form-label label-custom text-muted-custom">Estado<span class="text-danger">*</span></label>
                                <div class="card card-custom border-0 shadow-sm rounded-4">
                                    <div class="card-body input-custom py-2 d-flex align-items-center">
                                        <div class="form-check form-switch switch-lg d-flex align-items-center gap-2 m-0">
                                            <InputCheckbox class="form-check-input mt-0" @bind-Value="epsDto.Activo" id="switchActivo" />
                                            <label class="form-check-label fw-semibold" for="switchActivo">
                                                @if (epsDto.Activo)
                                                {
                                                    <i class="bi  text-black bi-check2-circle"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi text-rojo bi-x-circle"></i>
                                                }
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Banner informativo *@
                        <div class="card card-info-banner border-0 shadow-sm rounded-4 p-4 position-relative overflow-hidden">
                            <div class="position-relative z-index-2 d-flex flex-column justify-content-center">
                                <h5 class="fw-bold text-rojo mb-2">
                                    <i class="bi bi-shield-lock-fill me-2"></i>Seguridad de las Entidades
                                </h5>
                                <p class="small mb-0 lh-lg">
                                    Asegúrese de que el código asignado corresponda al código oficial registrado de la EPS ante el Ministerio de Salud y Protección Social para evitar inconsistencias en la planilla PILA o reportes de novedades.
                                </p>
                            </div>
                            <div class="decorative-circle"></div>
                        </div>
                    </div>

                    @* --- ACCIONES --- *@
                    <div class="card-footer bg-light p-4 d-flex justify-content-end gap-3 rounded-bottom-4 border-0">
                        <button type="button" class="btn btn-light-custom rounded-pill px-4 py-2.5 fw-semibold" @onclick="Volver">
                            Cancelar
                        </button>

                        <button type="submit" class="btn btn-rojo rounded-pill px-4 py-2.5 fw-semibold" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                            
                                <span>Guardar</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>


@code {
    [Parameter] public int epsid { get; set; }

    private UpdateEpsDto epsDto;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarEps();
    }

    private async Task CargarEps()
    {
        var resEps = await _epsService.GetByEpsAsync(epsid);

        if (resEps != null && resEps.EsCorrecto && resEps.Valor != null)
        {
            var epsObtenida = resEps.Valor;

            epsDto = new UpdateEpsDto
            {
                EpsId = epsObtenida.EpsId,
                Nombre = epsObtenida.Nombre,
                Codigo = epsObtenida.Codigo,
                Activo = epsObtenida.Activo 
            };
        }
        else
        {
            var msj = resEps?.Mensaje ?? "No se encontró la EPS solicitada.";
            await JS.InvokeVoidAsync("Swal.fire", "Error", msj, "error");
            Volver();
        }
    }

    private async Task ActualizarEps()
    {
        if (isProcessing) return;
        isProcessing = true;

        try
        {
            var respuesta = await _epsService.UpdateEpsAsync(epsDto);

            if (!respuesta.EsCorrecto)
            {
                await JS.InvokeVoidAsync("Swal.fire", "Error", $"No se pudo actualizar: {respuesta.Mensaje}", "error");
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", "Éxito", "La EPS ha sido actualizada correctamente.", "success");
                Volver();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Fatal Error", $"Excepción interna: {ex.Message}", "error");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void Volver() => nav.NavigateTo("/api/Eps/Eps");
}