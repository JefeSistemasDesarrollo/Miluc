@page "/api/Eps/Eps"

@using Miluc.Client.Interfaces.Nomina

@using Miluc.Client.Interfaces.Nomina.SeguridadSocial
@using Miluc.Shared.DTOs.Nomina.EpsDto

@inject NavigationManager nav
@inject IEpsClientService _epsService
@inject IAfSeguridadSocialClientService afSeguridadSocialClientService
@inject IJSRuntime js

<div class="eps-page animate__animated animate__fadeIn p-4">

    <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
        <div>
            <h2 class="fw-extrabold text-black m-0 tracking-tight">
                <i class="bi bi-people-fill me-2"></i>
                Gestión EPS
            </h2>
            <p class="text-muted mb-0 small mt-1">
                Administración de Entidades Promotoras de Salud.
            </p>
        </div>

        <button class="btn btn-rojo btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
            <i class="bi bi-arrow-left me-2"></i> Volver
        </button>
    </div>

    <button class="btn btn-rojo btn-nuevo rounded-pill px-4 shadow-sm mb-4" @onclick="IrACrearEps">
        <i class="bi bi-plus-lg me-1"></i> Nueva EPS
    </button>
</div>

   

    @* SECCIÓN DE FILTROS: Buscador y Selector de cantidad de registros *@
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">

                @* Barra de búsqueda *@
                <div class="col-lg-7">
                    <div class="input-group input-group-lg search-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>

                        <input type="text" class="form-control border-start-0 shadow-none fs-6"
                               placeholder="Filtrar local o buscar en servidor..."
                               @bind="textoBusqueda" @bind:event="oninput" @onkeyup="HandleEnter" />

                        <button class="btn btn-rojo rounded-end-pill px-4" @onclick="BuscarEnServidor">
                            <i class="bi bi-search me-2"></i>
                        </button>
                    </div>
                </div>

                @* Selector de paginación y Badge de Total *@
                <div class="col-lg-5 text-lg-end">
                    <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border">
                               <label class="mx-3 small fw-bold text-muted text-uppercase">Mostrar</label>

                        <select class="form-select form-select-sm rounded-pill border-0 bg-transparent fw-bold"
                                style="width: 80px;"
                                value="@cantidadPorPagina"
                                @onchange="CambiarCantidadPagina">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>

                        <span class="badge bg-rojo rounded-pill ms-2 px-3 py-2">
                            Total: @totalRegistros
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* TABLA DE EPS *@
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="bg-rojo text-white">
                    <tr>
                        <th class="ps-4 py-3 text-start">Nombre</th>
                        <th class="ps-4 py-3 text-start">Código</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    
                   
                    </tr>
                </thead>
                <tbody class="bg-white">
                
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="spinner-border text-rojo"></div>
                            </td>
                        </tr>
                    }
                    else if (!listaEpsAlservidor.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                No se encontraron registros de EPS.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var em in listaEpsAlservidor)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="text-dark fw-semibold small text-uppercase">@em.Nombre</div>
                                </td>
                                <td class="ps-4">
                                    <div class="text-dark fw-semibold small text-uppercase">@em.Codigo</div>
                                </td>

                            
        
                        
                                <td class="text-center">
                                    @if (em.Activo )
                                    {
                                    <i class="bi  text-black bi-check2-circle"></i>
                                    }
                                    else
                                    {
                                            <i class="bi text-rojo bi-x-circle"></i>
                                    }
                                </td>

                            @* Columna de Acciones Limpia *@
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm border rounded-pill bg-white overflow-hidden">
                                        <button class="btn-detail btn btn-dark btn-sm px-2 border-end" title="Ver Detalle" @onclick="() => VerDetalle(em.EpsId)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-white btn-sm px-2 border-end edit" title="Editar EPS" @onclick="() => EditarEps(em.EpsId)">
                                            <i class="bi bi-pencil-square text-primary"></i>
                                        </button
                                        <button class="btn btn-white btn-sm px-2 delete" title="Eliminar EPS" @onclick="() => EliminarEps (em.EpsId)">
                                            <i class="bi bi-trash3 text-danger"></i>
                                        </button
                                    </div>
                                </td>
                            </tr>
                        }
                                  
                           
                }
                    }
                </tbody>
            </table>
        </div>

        @* SECCIÓN DE PAGINACIÓN *@
    <div class="pagination-footer d-flex justify-content-between align-items-center mt-4 p-3">
        <div class=" text-amarillo small">Página <b>@paginaActual</b> de @totalPaginas</div>

            <div class="pagination-container p-1 bg-white border rounded-pill shadow-sm">
                <button class="btn btn-sm rounded-circle @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <span class="mx-3 fw-bold text-rojo">@paginaActual</span>

                <button class="btn btn-sm rounded-circle @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>


@code {
    private List<EpsReaderDto> listaEpsOrigen = new List<EpsReaderDto>();
    private List<EpsReaderDto> listaEpsAlservidor = new List<EpsReaderDto>();

    private string _textoBusqueda = "";

    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            FiltrarLocal();
        }
    }

    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private int totalRegistros = 0;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await cargarEps();
    }

    public async Task cargarEps()
    {
        cargando = true;

        // Invocación al servicio de Eps con paginación
        var respuesta = await _epsService.GetEpsAsync(textoBusqueda, paginaActual, cantidadPorPagina);

        if (respuesta != null && respuesta.EsCorrecto)
        {
            listaEpsOrigen = respuesta.Valor ?? new List<EpsReaderDto>();
            listaEpsAlservidor = listaEpsOrigen;
            totalRegistros = respuesta.CantRegistros;
        }

        cargando = false;
    }

    private void FiltrarLocal()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            listaEpsAlservidor = listaEpsOrigen;
        }
        else
        {
            listaEpsAlservidor = listaEpsOrigen.Where(e =>
                (!string.IsNullOrEmpty(e.Codigo) && e.Codigo.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.Nombre) && e.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    public async Task BuscarEnServidor()
    {
        paginaActual = 1;
        cargando = true;

        var respuesta = await _epsService.GetEpsAsync(textoBusqueda, paginaActual, cantidadPorPagina);

        if (respuesta != null && respuesta.EsCorrecto)
        {
            listaEpsOrigen = respuesta.Valor ?? new List<EpsReaderDto>();
            listaEpsAlservidor = listaEpsOrigen;
            totalRegistros = respuesta.CantRegistros;
        }
        else
        {
            listaEpsOrigen = new List<EpsReaderDto>();
            listaEpsAlservidor = new List<EpsReaderDto>();
            totalRegistros = 0;

            string erroresConcatenados = respuesta?.Errores != null && respuesta.Errores.Any()
               ? string.Join("<br>", respuesta.Errores)
               : "Ocurrió un error inesperado.";

            await js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Error al consultar la seguridad social",
                html = erroresConcatenados,
                confirmButtonColor = "#6c1d1d"
            });
        }

        cargando = false;
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            paginaActual = 1;
            await BuscarEnServidor();
        }
    }

    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevaCantidad))
        {
            cantidadPorPagina = nuevaCantidad;
            paginaActual = 1;

            if (string.IsNullOrWhiteSpace(_textoBusqueda))
            {
                await cargarEps();
            }
            else
            {
                await BuscarEnServidor();
            }
        }
    }

    private int totalPaginas
    {
        get
        {
            var total = string.IsNullOrWhiteSpace(_textoBusqueda)
                ? totalRegistros
                : listaEpsAlservidor.Count;

            if (total == 0) return 1;

            return (int)Math.Ceiling((double)total / cantidadPorPagina);
        }
    }

    private async Task IrPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > totalPaginas)
            return;

        paginaActual = nuevaPagina;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await cargarEps();
        else
            await BuscarEnServidor();
    }
      private async Task eliminarEps(int id)
    {
        var resultadoSwal = await js.InvokeAsync<System.Text.Json.JsonElement>("Swal.fire", new

        {
            title = "¿Deseas eliminar esta eps?",
            text = "Esta acción removerá el registro permanentemente si no cuenta con transacciones.",
            icon = "warning",            
            showCancelButton = true,
            confirmButtonColor = "#D62F46",
            cancelButtonColor = "#FDC922",
            confirmButtonText = "Sí, eliminar",
            cancelButtonText = "Cancelar"
        });

        // Extrae el valor booleano resultante del JSON devuelto por JavaScript para comprobar si se confirmó la acción
        bool confirmado = false;
        if (resultadoSwal.ValueKind == System.Text.Json.JsonValueKind.Object &&
            resultadoSwal.TryGetProperty("isConfirmed", out var propiedadConfirmado))
        {
            confirmado = propiedadConfirmado.GetBoolean();
        }

        if (confirmado)
        {
            cargando = true;
            StateHasChanged();

            try
            {
                // Invocación al cliente HTTP para eliminar físicamente el id seleccionado
                var respuesta = await _epsService.DeleteEpsAsync(id);

               if (respuesta != null && respuesta.EsCorrecto)
            {
                await js.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "success",
                    title = "¡Eliminado!",
                 
                    text = "La EPS ha sido removida con éxito.", 
                    confirmButtonText = "Aceptar",
                    confirmButtonColor = "#D62F46"
                });

                await cargarEps();
            }
                else
                {
                    string mensajeServidor = respuesta != null ? respuesta.Mensaje : "No se pudo procesar la solicitud.";

                    await js.InvokeVoidAsync("Swal.fire", new
                    {
                        icon = "error",
                        title = "No se puede eliminar",
                        text = mensajeServidor,
                        confirmButtonText = "Aceptar",
                        confirmButtonColor = "#D62F46"
                    });
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error durante el proceso de borrado: {ex.Message}");
            }
            finally
            {
                cargando = false;
                StateHasChanged();
            }
        }
    }

    private void VerDetalle(int id) => nav.NavigateTo($"/api/Eps/{id}");
    private void Volver() => nav.NavigateTo("administrar-entidadesSeguridadSocial");
    private void IrACrearEps() => nav.NavigateTo("/api/Eps/CrearEps");
    private void EditarEps(int epsId) => nav.NavigateTo($"/editar/api/Eps/{epsId}");
    private async Task EliminarEps(int id) => await eliminarEps(id);
}

