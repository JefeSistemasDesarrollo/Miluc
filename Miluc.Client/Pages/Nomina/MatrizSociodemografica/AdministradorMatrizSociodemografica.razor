@page "/Administrar/MatrizSociodemografica"
@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.MatrizSocioDemograficaDto
@inject IMatrizSociodemograficaClientService _matrizSociodemograficaService
@inject NavigationManager nav
@inject IJSRuntime jsRuntime

 <div class="empleados-page animate__animated animate__fadeIn p-4">

        
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-vinotinto m-0 ">
                <i class="bi bi-person-badge-fill me-2"> Gestionar Matriz Sociodemográfica</i>
            </h2>
            <p class="m-0 text-muted">Administración Matriz Sociodemográfica</p>
        </div>
        
        
        <button class="btn btn-vinotinto btn-nuevo rounded-pill px-4 shadow-sm" @onclick=IrACrearMatrizSociodemografica>
            <i class="bi bi-plus-lg me-1"></i> Nuevo MatrizSociodemografica
        </button>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 rounded-4">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            
            
            <div class="col-lg-7">
                <div class="input-group input-group-lg search-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>

                    <input type="text" class="form-control border-start-0 shadow-none fs-6"
                           placeholder="Filtrar local o buscar en servidor..."
                           @bind="textoBusqueda" @bind:event="oninput" @onkeyup="HandleEnter" />

                     
                    <button class="btn btn-vinotinto rounded-end-pill px-4" @onclick="BuscarEnServidor">
                        <i class="bi bi-search me-2"></i>
                    </button>
                </div>
            </div> 
            <div class="col-lg-5 text-lg-end">
                <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border">

                    <label class="mx-3 small fw-bold text-muted text-uppercase">Mostrar</label>
                    <select class="form-select form-select-sm rounded-pill border-0 bg-transparent fw-bold"
                            style="width: 80px;"
                            value="@cantidadPorPagina"
                            @onchange="CambiarCantidadPagina">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    
                    @* Muestra el total de registros encontrados *@
                    <span class="badge bg-vinotinto rounded-pill ms-2 px-3 py-2">
                        Total: @totalRegistros
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="bg-vinotinto text-white">
                <tr>
                    
                    
                            <th scope="col">Nombre Empleado</th>
                            <th scope="col">Título Obtenido</th>
                            <th scope="col">Nacionalidad</th>
                            <th scope="col">Género</th>
                            <th scope="col" class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
              
            <tbody class="bg-white">
                
                @if (cargando)
                {
                    @* ESTADO 1: Si la variable 'cargando' es verdadera, dibuja un spinner de carga *@
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="spinner-border text-vinotinto"></div>
                        </td>
                    </tr>
                }
                else if (!listmatrizSociodemograficaAlservidor.Any())
                {
                    @* ESTADO 2: Si terminó de cargar pero la lista está totalmente vacía *@
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            No hay empleados registrados
                        </td>
                    </tr>
                }
                else
                {    @* ESTADO 3: Si hay datos en la lista, dibuja las filas normalmente *@
                    @foreach (var item in listmatrizSociodemograficaAlservidor)
                    {
                        <tr>
                           
                            <td>@item.NombreEmpleado</td>
                            <td>@item.TituloObtenido</td>
                            <td>@item.Nacionalidad</td>
                            <td>@item.NombreGenero</td>
                           
                            <td class="text-center">
                                <button class="btn btn-sm btn-primary me-1" @onclick="() => VerDetalle(item.MatrizSociodemograficaID)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => EditarEmpleado(item.MatrizSociodemograficaID)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarEmpleado(item.MatrizSociodemograficaID)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                 </tbody>
        </table>
    </div>

    @* SECCIÓN DE PAGINACIÓN (PIE DE TABLA) *@
    <div class="pagination-footer d-flex justify-content-between align-items-center mt-4 p-3">
        <div class="page-link text-muted small">Página <b>@paginaActual</b> de @totalPaginas</div>
        
        <div class="page-item.active pagination-container p-1 bg-white border rounded-pill shadow-sm">
            @* Botón Anterior: Se deshabilita si estamos en la primera página *@
            <button class="btn btn-sm rounded-circle @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)">
                <i class="bi bi-chevron-left"></i>
            </button>
            
            <span class="mx-3 fw-bold text-vinotinto">@paginaActual</span>
            
            
            <button class="btn btn-sm rounded-circle @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>









@code {
    private List<MatrizSociodemograficaReaderDto> listmatrizSociodemograficaOrigen = new List<MatrizSociodemograficaReaderDto>();
    private List<MatrizSociodemograficaReaderDto> listmatrizSociodemograficaAlservidor = new List<MatrizSociodemograficaReaderDto>();

    private string _textoBusqueda = "";

    // Propiedad pública usada en el enlace @bind="textoBusqueda"
    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            if (_textoBusqueda == value) return;
            _textoBusqueda = value;
            FiltrarLocal();
        }
    }

    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private int totalRegistros = 0;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarMatrizSociodemografica();
    }
    public async Task CargarMatrizSociodemografica()
    {
        cargando = true;

        var respuesta = await _matrizSociodemograficaService.GetMatrizSociodemograficaAsync(textoBusqueda, paginaActual, cantidadPorPagina);
        if (respuesta != null && respuesta.EsCorrecto)
        {
            listmatrizSociodemograficaOrigen = respuesta.Valor ?? new List<MatrizSociodemograficaReaderDto>();
            listmatrizSociodemograficaAlservidor = respuesta.Valor ?? new List<MatrizSociodemograficaReaderDto>();
            totalRegistros = respuesta.CantRegistros;
        }
        cargando = false;
    }
    private void FiltrarLocal()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            listmatrizSociodemograficaAlservidor = listmatrizSociodemograficaOrigen;
        }
        else
        {
            listmatrizSociodemograficaAlservidor = listmatrizSociodemograficaOrigen
                .Where(m => m.NombreEmpleado.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)

                ).ToList();
        }
    }
    public async Task BuscarEnServidor()
    {
        paginaActual = 1; // Reiniciar a la primera página al buscar
        cargando = true;

        var respuesta = await _matrizSociodemograficaService.GetMatrizSociodemograficaAsync(textoBusqueda, paginaActual, cantidadPorPagina);

        if (respuesta != null && respuesta.EsCorrecto)
        {
            listmatrizSociodemograficaOrigen = respuesta.Valor ?? new List<MatrizSociodemograficaReaderDto>();
            listmatrizSociodemograficaAlservidor = respuesta.Valor ?? new List<MatrizSociodemograficaReaderDto>();
            totalRegistros = respuesta.CantRegistros;
        }
        else
        {
            listmatrizSociodemograficaAlservidor = new List<MatrizSociodemograficaReaderDto>();
            listmatrizSociodemograficaOrigen = new List<MatrizSociodemograficaReaderDto>();

            string erroresConcatenados = (respuesta?.Errores != null && respuesta.Errores.Any())
              ? string.Join("<br>", respuesta.Errores)
              : "Ocurrió un error inesperado.";
            await jsRuntime.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = $"Error al consultar matriz sociodemográfica {respuesta?.Mensaje} ",
                text = $"{erroresConcatenados}",
                confirmButtonColor = "#6c1d1d"
            });
        }

        cargando = false;
    }
    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            paginaActual = 1;
            await BuscarEnServidor();
        }
    }
    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        // Convierte el valor seleccionado en el HTML a un entero C#
        cantidadPorPagina = int.Parse(e.Value!.ToString()!);
        paginaActual = 1; // Resetea a la página uno

        // Decide qué método de recarga usar según si hay texto o no en el buscador
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            await CargarMatrizSociodemografica();
        }
        else
        {
            await BuscarEnServidor();
        }
    }
    private int totalPaginas
    {
        get
        {
            var total = string.IsNullOrWhiteSpace(_textoBusqueda)
                ? totalRegistros
                : listmatrizSociodemograficaAlservidor
               .Count;

            // Math.Ceiling redondea hacia arriba en caso de decimales (ej: 10.2 páginas se convierte en 11 páginas)
            return (int)Math.Ceiling((double)total / cantidadPorPagina);
        }
    }

    // Gestiona el cambio de página desde los botones Anterior / Siguiente
    private async Task IrPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1)
            return;

        paginaActual = nuevaPagina;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await CargarMatrizSociodemografica();
        else
            await BuscarEnServidor();
    }

    // MÉTODOS DE REDIRECCIÓN Y NAVEGACIÓN (Utilizan NavigationManager 'nav')
    

    // Redirige a la pantalla del formulario de creación
    private void IrACrearMatrizSociodemografica()
    {
        nav.NavigateTo("/nomina/MatrizSociodemografica/crear");
    }

    // Redirige al Detalle usando interpolación de cadenas para mandar el ID en la URL
    private void VerDetalle(int id)
    {
        nav.NavigateTo($"/Administrar/MatrizSociodemografica/Detalle/{id}");
    }

    // Redirige al formulario de Edición pasando el ID por la URL
    private void EditarEmpleado(int id)
    {
        nav.NavigateTo($"/Administrar/MatrizSociodemografica/Editar/{id}");
    }

    // Redirige a la pantalla de confirmación de Eliminación pasando el ID por la URL
    private void EliminarEmpleado(int id)
    {
        nav.NavigateTo($"/Administrar/MatrizSociodemografica/Eliminar/{id}");
    }


    }
