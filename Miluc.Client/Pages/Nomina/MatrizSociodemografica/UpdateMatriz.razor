    private void SiguientePaginaNacionalidad() { if (paginaActualNacionalidad < TotalPaginasNacionalidad) paginaActualNacionalidad++; }

    private void IrPaginaPais(int pagina) => paginaActualPais = pagina;
    private void PaginaAnteriorPais() { if (paginaActualPais > 1) paginaActualPais--; }
