@page "/Administrar/MatrizSociodemografica/Editar/{id:int}"

@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.MatrizSocioDemograficaDto
@using Miluc.Shared.DTOs.Nomina.ClaseVivienda
@using Miluc.Shared.DTOs.Nomina.CondicionMedica
@using Miluc.Shared.DTOs.Nomina.DeporteRederDto;
@using Miluc.Shared.DTOs.Nomina.GeneroDto;
@using Miluc.Shared.DTOs.Nomina.MedioTransporteDto;
@using Miluc.Shared.DTOs.Nomina.NivelAcademico;
@using Miluc.Shared.DTOs.Nomina.PaisDto;
@using Miluc.Shared.DTOs.Nomina.TipoVivienda;
@using Syncfusion.Blazor.Calendars
@using Miluc.Shared.DTOs.Nomina.NacionalidadDto


@inject IClaseViviendaClientService _iClaseVivienda
@inject INacionalidadClienteService _iNacionalidad
@inject ICondicionMedicaClientService _iCondicionMedica
@inject IDeportesClientService _iDeportes
@inject IGeneroClientService _iGenero
@inject IMedioTransporteClientService _iMedioTransporte
@inject INivelAcademicoClientService _iNivelAcademico
@inject IPaisClientService _iPais
@inject ITipoViviendaClientService _iTipoVivienda
@inject IMatrizSociodemograficaClientService _iMatriz
@inject IEmpleadoClientService _iEmpleado
@inject NavigationManager nav
@inject IJSRuntime JS
@inject IAuthClientService _authClientService

<div class="empleado-page p-4 animate__animated animate__fadeIn">
    <div class="container-fluid max-width-container">

        @* --- CABECERA DE LA PÁGINA --- *@
        <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
            <div>
                <h2 class="fw-extrabold text-black m-0 tracking-tight">
                    <i class="bi bi-pencil-square"></i>
                    Editar Matriz Sociodemográfica
                </h2>
                <p class="text-muted mb-0 small mt-1">
                    Modificación de la hoja de vida y datos maestros del colaborador.
                </p>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-amarillo btn-outline-secondary rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver" disabled="@isSaving">
                    <i class="bi bi-arrow-left me-2"></i> Cancelar
                </button>
                <button form="form-matriz" type="submit" class="btn btn-rojo rounded-pill px-4 py-2 transition-all fw-semibold" disabled="@(isSaving || matrizNoEncontrada)">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-save me-2"></i> <span>Guardar </span>
                    }
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-rojo" role="status">
                    <span class="visually-hidden">Cargando datos...</span>
                </div>
            </div>
        }
        else if (matrizNoEncontrada)
        {
            @* --- VISTA DE ERROR --- *@
            <div class="card border-0 shadow-sm rounded-4 text-center p-5 my-4">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-triangle text-warning" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Error al cargar la Matriz</h4>
                    <p class="text-muted mb-4 max-w-md mx-auto">
                        El colaborador seleccionado no cuenta con una matriz sociodemográfica para editar.
                    </p>
                    <button class="btn btn-rojo rounded-pill px-4 py-2 fw-semibold" @onclick="Volver">
                        <i class="bi bi-arrow-left me-2"></i> Regresar al Listado
                    </button>
                </div>
            </div>
        }
        else
        {
            @* --- INICIO DEL EDITFORM --- *@
            <EditForm id="form-matriz" Model="matriz" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="row g-4">
                    @* --- BLOQUE 1: INFORMACIÓN BÁSICA Y PERSONALES --- *@
                    <div class="col-12">
                        <div class="card card-custom border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-rojo mb-3"><i class="bi bi-person"></i> Empleado</h5>

                                <div class="section-title-container mb-4">
                                    <span class="badge bg-vinotinto-light text-vinotinto rounded-pill px-3 py-2 fw-bold text-uppercase tracking-wider">
                                        Información Básica
                                    </span>
                                </div>

                                <div class="mb-4 p-3 border rounded bg-light">
                                    <h6 class="fw-bold text-rojo">Autorización para el Tratamiento de Datos Personales</h6>
                                    <p class="small text-muted mb-3">
                                        Al firmar o enviar este formulario, autorizo de manera voluntaria, previa, expresa e informada a Avícola Miluc para recolectar, almacenar, usar y tratar mis datos personales suministrados.
                                    </p>

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="consentimientoSwitch" @bind="matriz.ConsentimientoInformado">
                                        <label class="form-check-label fw-semibold @(matriz.ConsentimientoInformado ? "text-amarillo" : "text-rojo")" for="consentimientoSwitch">
                                            @(matriz.ConsentimientoInformado ? " Consentimiento Firmado" : " Pendiente Consentimiento")
                                        </label>
                                    </div>
                                    <ValidationMessage For="@(() => matriz.ConsentimientoInformado)" class="text-danger small" />
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-4">
                                        <label class="form-label label-custom">Nombre Completo Empleado</label>
                                        <input type="text" class="form-control" value="@matriz.NombreEmpleado" readonly />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label label-custom">Edad</label>
                                        <input type="number" class="form-control" @bind="matriz.Edad" />
                                        <ValidationMessage For="@(() => matriz.Edad)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label label-custom">Género</label>
                                        <select class="form-select" @bind="matriz.GeneroId">
                                            <option value="0">Seleccione...</option>
                                            @foreach (var item in generoList)
                                            {
                                                <option value="@item.GeneroId">@item.Nombre</option>
                                            }
                                        </select>
                                        <ValidationMessage For="@(() => matriz.GeneroId)" class="text-danger small fw-bold" />
                                    </div>

                                    @* --- NACIONALIDAD (CON MODAL) --- *@
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">Nacionalidad</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="bi bi-flag"></i></span>
                                            <input type="text" class="form-control cursor-pointer" readonly @onclick="AbrirModalNacionalidad"
                                                   value="@(nacionalidadSeleccionada.NacionalidadNombre ?? "Seleccionar nacionalidad...")" />
                                            <button class="btn btn-maroon btn-rojo" type="button" @onclick="AbrirModalNacionalidad">
                                                <i class="bi bi-search"></i>
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => matriz.NacionalidadId)" class="text-danger small fw-bold mt-1 d-block" />
                                    </div>

                                    @* --- PAÍS DE NACIMIENTO (CON MODAL) --- *@
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">País de Nacimiento</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="bi bi-globe-americas"></i></span>
                                            <input type="text" class="form-control cursor-pointer" readonly @onclick="AbrirModalPais"
                                                   value="@(paisSeleccionado.pais ?? "Seleccionar país...")" />
                                            <button class="btn btn-maroon btn-rojo" type="button" @onclick="AbrirModalPais">
                                                <i class="bi bi-search"></i>
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => matriz.PaisNacimientoId)" class="text-danger small fw-bold mt-1 d-block" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- BLOQUE 2: SALUD Y HÁBITOS DE VIDA --- *@
                    <div class="col-12 col-md-6">
                        <div class="card card-custom border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-rojo mb-3"><i class="bi bi-heart-pulse me-2"></i>Salud y Estilo de Vida</h5>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">Condición Médica</label>
                                        <select class="form-select" @bind="matriz.CondicionMedicaId">
                                            <option value="0">Seleccione...</option>
                                            @foreach (var item in condicionMedicaList)
                                            {
                                                <option value="@item.CondicionMedicaId">@item.Nombre</option>
                                            }
                                        </select>
                                        <ValidationMessage For="@(() => matriz.CondicionMedicaId)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">Deporte Practicado</label>
                                        <select class="form-select" @bind="matriz.DeporteId">
                                            <option value="0">Seleccione...</option>
                                            @foreach (var item in deportesList)
                                            {
                                                <option value="@item.DeporteId">@item.Nombre</option>
                                            }
                                        </select>
                                        <ValidationMessage For="@(() => matriz.DeporteId)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label label-custom">Hobbies / Aficiones</label>
                                        <input type="text" class="form-control" @bind="matriz.Hobbies" />
                                        <ValidationMessage For="@(() => matriz.Hobbies)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label label-custom">¿Fuma?</label>
                                        <select class="form-select" @bind="FumaString">
                                            <option value="">Seleccione...</option>
                                            <option value="true">Sí</option>
                                            <option value="false">No</option>
                                        </select>
                                        <ValidationMessage For="@(() => matriz.Fuma)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">¿Cuántas veces al mes fuma?</label>
                                        <input type="number" class="form-control" @bind="matriz.FumaVecesAlMes" disabled="@(matriz.Fuma != true)" />
                                        <ValidationMessage For="@(() => matriz.FumaVecesAlMes)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">¿Consume Alcohol?</label>
                                        <select class="form-select" @bind="AlcoholString">
                                            <option value="">Seleccione...</option>
                                            <option value="true">Sí</option>
                                            <option value="false">No</option>
                                        </select>
                                        <ValidationMessage For="@(() => matriz.Alcohol)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">¿Frecuencia de alcohol (al mes)?</label>
                                        <input type="number" class="form-control" @bind="matriz.BebeVecesAlAño" disabled="@(matriz.Alcohol != true)" />
                                        <ValidationMessage For="@(() => matriz.BebeVecesAlAño)" class="text-danger small fw-bold" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- BLOQUE 3: VIVIENDA Y TRANSPORTE --- *@
                    <div class="col-12 col-md-6">
                        <div class="card card-custom border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-rojo mb-3"><i class="bi bi-house-door me-2"></i>Vivienda y Transporte</h5>
                                <div class="mb-3">
                                    <label class="form-label label-custom">Medio de Transporte</label>
                                    <select class="form-select" @bind="matriz.MedioDeTransporteId">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var item in medioTransporteList)
                                        {
                                            <option value="@item.MedioTransporteId">@item.Nombre</option>
                                        }
                                    </select>
                                    <ValidationMessage For="@(() => matriz.MedioDeTransporteId)" class="text-danger small fw-bold" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label label-custom">Clase de Vivienda</label>
                                    <select class="form-select" @bind="matriz.ClaseDeViviendaId">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var item in claseViviendaList)
                                        {
                                            <option value="@item.ClaseDeViviendaId">@item.Nombre</option>
                                        }
                                    </select>
                                    <ValidationMessage For="@(() => matriz.ClaseDeViviendaId)" class="text-danger small fw-bold" />
                                </div>
                                <div class="mb-0">
                                    <label class="form-label label-custom">Tipo de Vivienda</label>
                                    <select class="form-select" @bind="matriz.TipoDeViviendaId">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var item in tipoViviendaList)
                                        {
                                            <option value="@item.TipoViviendaId">@item.Nombre</option>
                                        }
                                    </select>
                                    <ValidationMessage For="@(() => matriz.TipoDeViviendaId)" class="text-danger small fw-bold" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- BLOQUE 4: FORMACIÓN ACADÉMICA --- *@
                    <div class="col-12 col-md-6">
                        <div class="card card-custom border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-rojo mb-3"><i class="bi bi-journal-bookmark me-2"></i>Formación Académica</h5>
                                <div class="mb-3">
                                    <label class="form-label label-custom">Nivel Académico</label>
                                    <select class="form-select" @bind="matriz.NivelAcademicoId">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var item in nivelAcademicoList)
                                        {
                                            <option value="@item.NivelAcademicoId">@item.Nombre</option>
                                        }
                                    </select>
                                    <ValidationMessage For="@(() => matriz.NivelAcademicoId)" class="text-danger small fw-bold" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label label-custom">Entidad Educativa</label>
                                    <input type="text" class="form-control" @bind="matriz.EntidadEducativa" />
                                    <ValidationMessage For="@(() => matriz.EntidadEducativa)" class="text-danger small fw-bold" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label label-custom">Título Obtenido</label>
                                    <input type="text" class="form-control" @bind="matriz.TituloObtenido" />
                                    <ValidationMessage For="@(() => matriz.TituloObtenido)" class="text-danger small fw-bold" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label label-custom">Fecha de Culminación de Estudios</label>
                                    <SfDatePicker TValue="DateTime?" @bind-Value="matriz.AñoFinalizacionEducacion" Format="dd/MM/yyyy" Placeholder="dd/mm/aaaa" Width="100%"></SfDatePicker>
                                    <ValidationMessage For="@(() => matriz.AñoFinalizacionEducacion)" class="text-danger small fw-bold" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- BLOQUE 5: ANTECEDENTES LABORALES --- *@
                    <div class="col-12 col-md-6">
                        <div class="card card-custom border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-rojo mb-3"><i class="bi bi-briefcase me-2"></i>Última Experiencia Laboral</h5>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">Última Empresa</label>
                                        <input type="text" class="form-control" @bind="matriz.UltimaEmpresaTrabajo" />
                                        <ValidationMessage For="@(() => matriz.UltimaEmpresaTrabajo)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">Cargo Desempeñado</label>
                                        <input type="text" class="form-control" @bind="matriz.CargoDesempeñado" />
                                        <ValidationMessage For="@(() => matriz.CargoDesempeñado)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">Fecha fin ultimo Empleo</label>
                                        <SfDatePicker TValue="DateTime?" @bind-Value="matriz.FechaUltimoEmpleo" Format="dd/MM/yyyy" Placeholder="dd/mm/aaaa" Width="100%"></SfDatePicker>
                                        <ValidationMessage For="@(() => matriz.FechaUltimoEmpleo)" class="text-danger small fw-bold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label label-custom">Último Salario</label>
                                        <input type="text" class="form-control" value="@(matriz.UltimoSalario?.ToString("N0") ?? "")" @oninput="@(e => OnSalarioChanged(e.Value?.ToString() ?? string.Empty))" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                                        <ValidationMessage For="@(() => matriz.UltimoSalario)" class="text-danger small fw-bold" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- BLOQUE 6: CONTACTO DE EMERGENCIA --- *@
                    <div class="col-12 col-md-6">
                        <div class="card card-custom border-0 shadow-sm rounded-4 h-100 border-start border-4 border-roja">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-rojo mb-3"><i class="bi bi-telephone-outbound me-2"></i>Contacto de Emergencia</h5>
                                <div class="mb-3">
                                    <label class="form-label label-custom">Persona de Contacto</label>
                                    <input type="text" class="form-control" @bind="matriz.PersonaEnCasoDeEmergencia" />
                                    <ValidationMessage For="@(() => matriz.PersonaEnCasoDeEmergencia)" class="text-danger small fw-bold" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label label-custom">Teléfono de Contacto</label>
                                    <input type="text" class="form-control" @bind="matriz.TelefonoEmergencia" />
                                    <ValidationMessage For="@(() => matriz.TelefonoEmergencia)" class="text-danger small fw-bold" />
                                </div>
                                <div class="mb-0">
                                    <label class="form-label label-custom">Dirección del Contacto</label>
                                    <input type="text" class="form-control" @bind="matriz.DireccionPersonaEmergencia" />
                                    <ValidationMessage For="@(() => matriz.DireccionPersonaEmergencia)" class="text-danger small fw-bold" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- BLOQUE 7: SEGURIDAD DE DATOS (BANNER) --- *@
                    <div class="col-12 col-md-6">
                        <div class="card card-info-banner border-0 shadow-sm rounded-4 h-100 p-4 position-relative overflow-hidden">
                            <div class="position-relative z-index-2 d-flex flex-column h-100 justify-content-center">
                                <h5 class="fw-bold text-rojo mb-2"><i class="bi bi-shield-lock-fill me-2"></i>Seguridad de los datos</h5>
                                <p class="text-secondary small mb-0 lh-lg">
                                    Estás editando información confidencial. Asegúrate de verificar los datos con el colaborador.
                                    La organización garantiza la seguridad de estos registros para fines administrativos y legales.
                                </p>
                            </div>
                            <div class="decorative-circle"></div>
                        </div>
                    </div>

                </div>

                @* --- BOTONES DE ACCIÓN --- *@
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-amarillo btn-outline-secondary rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver" disabled="@isSaving">
                        <i class="bi bi-arrow-left me-2"></i> Cancelar
                    </button>

                    <button type="submit" class="btn btn-rojo rounded-pill px-4 py-2 transition-all fw-semibold" disabled="@(isSaving || matrizNoEncontrada)">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-2"></i>
                            <span>Guardar</span>
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@* --- MODAL DE NACIONALIDADES --- *@
<div class="modal fade @(mostrarModalNacionalidad ? "show d-block" : "")" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-maroon-modal text-modal">
                <h5 class="modal-title mb-0">
                    <i class="bi bi-flag-fill me-2"></i> Buscar Nacionalidad
                </h5>
                <button type="button" class="btn-close text-modal ms-auto" @onclick="CerrarModalNacionalidad"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" placeholder="Buscar nacionalidad..."
                           @bind="textoBusquedaNacionalidad" @bind:event="oninput" @onkeyup="HandleEnterNacionalidad">
                    <button type="button" class="btn btn-maroon" @onclick="() => buscarEnServidorNacionalidad()">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-muted">
                        Registros encontrados: <strong>@cantidadDeNacionalidadesEncontradas</strong>
                    </small>
                </div>
                <div class="list-group" style="max-height: 350px; overflow-y: auto;">
                    @if (listaNacionalidades.Any())
                    {
                        @foreach (var item in listaNacionalidades
                           .Skip((paginaActualNacionalidad - 1) * CantidadRegistrosPorNacionalidad)
                           .Take(CantidadRegistrosPorNacionalidad))
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action"
                                    @onclick="() => SeleccionarNacionalidad(item)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-maroon">@item.NacionalidadNombre</strong>
                                    <small class="text-muted">ID: @item.NacionalidadId</small>
                                </div>
                            </button>
                        }
                    }
                   
                 
                </div>
                @if (cantidadDeNacionalidadesEncontradas > 0)
                {
                    <div class="d-flex justify-content-center mt-3">
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(paginaActualNacionalidad == 1)" @onclick="PaginaAnteriorNacionalidad">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            @for (int i = Math.Max(1, paginaActualNacionalidad - 2); i <= Math.Min(TotalPaginasNacionalidad, paginaActualNacionalidad + 2); i++)
                            {
                                var pagina = i;
                                <button class="btn @(paginaActualNacionalidad == pagina ? "btn-maroon text-white" : "btn-outline-secondary") btn-sm" @onclick="() => IrPaginaNacionalidad(pagina)">
                                    @pagina
                                </button>
                            }
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(paginaActualNacionalidad == TotalPaginasNacionalidad)" @onclick="SiguientePaginaNacionalidad">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* --- MODAL DE PAÍSES --- *@
<div class="modal fade @(mostrarModalPais ? "show d-block" : "")" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-maroon-modal text-modal">
                <h5 class="modal-title mb-0">
                    <i class="bi bi-globe-americas me-2"></i> Buscar País de Nacimiento
                </h5>
                <button type="button" class="btn-close text-modal ms-auto" @onclick="CerrarModalPais"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" placeholder="Buscar país..."
                           @bind="textoBusquedaPais" @bind:event="oninput" @onkeyup="HandleEnterPais">
                    <button type="button" class="btn btn-maroon" @onclick="() => buscarEnServidorPais()">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-muted">
                        Registros encontrados: <strong>@cantidadDePaisesEncontrados</strong>
                    </small>
                </div>
                <div class="list-group" style="max-height: 350px; overflow-y: auto;">
                    @if (listaPaises.Any())
                    {
                        @foreach (var item in listaPaises
                                .Skip((paginaActualPais - 1) * CantidadRegistrosPorPais)
                                .Take(CantidadRegistrosPorPais))
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action"
                                        @onclick="() => SeleccionarPais(item)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="text-maroon">@item.pais</strong>
                                        <small class="text-muted">ID: @item.PaisId</small>
                                    </div>
                                </button>
                            }
                        }
                    
                    
                </div>
                @if (cantidadDePaisesEncontrados > 0)
                {
                    <div class="d-flex justify-content-center mt-3">
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(paginaActualPais == 1)" @onclick="PaginaAnteriorPais">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            @for (int i = Math.Max(1, paginaActualPais - 2); i <= Math.Min(TotalPaginasPais, paginaActualPais + 2); i++)
                            {
                                var pagina = i;
                                <button class="btn @(paginaActualPais == pagina ? "btn-maroon text-white" : "btn-outline-secondary") btn-sm" @onclick="() => IrPaginaPais(pagina)">
                                    @pagina
                                </button>
                            }
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(paginaActualPais == TotalPaginasPais)" @onclick="SiguientePaginaPais">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

