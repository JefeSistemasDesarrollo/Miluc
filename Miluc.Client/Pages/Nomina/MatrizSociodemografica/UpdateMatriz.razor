    private async Task Guardar()
    {
        if (isSaving) return;
        isSaving = true;

        try
        {
            var response = await _iMatriz.updateMatrizAsync(matriz);
            if (response?.EsCorrecto == true)
            {
                await JS.InvokeVoidAsync("Swal.fire", "¡Éxito!", "Matriz actualizada correctamente.", "success");
                Volver();
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", "Error", response?.Mensaje ?? "No se pudo actualizar.", "error");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", ex.Message, "error");
        }
        finally
        {
            isSaving = false;
        }
