@page "/nomina/empleado/crear"

@using Syncfusion.Blazor.Calendars
@using global::Miluc.Client.Interfaces
@using global::Miluc.Client.Interfaces.Nomina
@using global::Miluc.Shared.DTOs.Nomina.EmpleadoDto
@using global::Miluc.Shared.DTOs.Nomina.EmpresaDto
@using global::Miluc.Shared.DTOs.Nomina.EstadoCivilDto
@using global::Miluc.Shared.DTOs.Nomina.MunicipioDto
@using global::Miluc.Shared.DTOs.Nomina.TipoDocumento

@inject NavigationManager nav
@inject IDepartamentosClientService _municipioClientService
@inject ITipoDocumentoClienteService _tipoDocumentoClientService
@inject IEmpleadoClientService _empleadoService
@inject IEstadoCivilClientService _estadoCivil
@inject IJSRuntime JS
@inject IEmpresaClientSevice _empresaClientSevice
@inject IAuthClientService _authClientServic

<div class="empleado-page p-4 animate__animated animate__fadeIn">
    <div class="container-fluid max-width-container">

        @* --- CABECERA DE LA PÁGINA --- *@
        <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
            <div>
                <h2 class="fw-extrabold text-dark m-0 tracking-tight">
                    <i class="bi bi-person-plus-fill me-2 header-icon"></i>
                    Registrar Empleado
                </h2>
                <p class="text-muted mb-0 small mt-1">
                    Gestione la vinculación de nuevo personal. Los campos marcados con <span class="text-danger">*</span> son requeridos.
                </p>
            </div>

            <button class="btn btn-rojo btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i> Volver al listado
            </button>
        </div>
        @* Modal de autorización de tratamiento de datos personales *@
        @if (mostrarModalTratamientoDatos)
        {
            <div class="modal fade show d-block"
                 tabindex="-1"
                 style="background-color: rgba(0,0,0,.6);">

                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content border-0 shadow">

                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                <i class="bi bi-shield-check me-2"></i>
                                Autorización de Tratamiento de Datos Personales
                            </h5>
                        </div>

                        <div class="modal-body">
                            <p>
                                En cumplimiento de la <strong>Ley 1581 de 2012</strong>, el
                                <strong>Decreto 1377 de 2013</strong> y las demás normas que regulan la
                                protección de datos personales en Colombia, AVÍCOLA MILUC S.A.S. informa
                                que los datos suministrados por el colaborador serán recolectados,
                                almacenados, consultados, actualizados, transmitidos y tratados de forma
                                segura, confidencial y responsable para el desarrollo de la relación
                                laboral y el cumplimiento de las obligaciones legales y contractuales de la
                                compañía.
                            </p>

                            <h6 class="fw-bold text-danger">
                                Finalidades del tratamiento de la información
                            </h6>

                            <ul class="mb-3">
                                <li>Procesos de selección, vinculación, contratación y administración laboral.</li>
                                <li>Gestión de nómina, salarios, prestaciones sociales, liquidaciones y beneficios corporativos.</li>
                                <li>Afiliaciones, novedades y trámites ante EPS, AFP, ARL, Caja de Compensación Familiar y demás entidades del Sistema de Seguridad Social.</li>
                                <li>Administración de información familiar, beneficiarios, contactos de emergencia y personas registradas por el colaborador.</li>
                                <li>Gestión de incapacidades, exámenes médicos ocupacionales, esquemas de vacunación y programas de Seguridad y Salud en el Trabajo (SST).</li>
                                <li>Administración de condiciones médicas, restricciones laborales y demás información necesaria para la protección y bienestar del trabajador.</li>
                                <li>Elaboración, seguimiento y conservación de contratos laborales, certificaciones, novedades y demás documentos relacionados con la relación laboral.</li>
                                <li>Gestión de programas de bienestar, capacitaciones, actividades organizacionales y matrices sociodemográficas.</li>
                                <li>Creación, administración y control de usuarios en plataformas, aplicativos y sistemas de información corporativos.</li>
                                <li>Verificación de identidad, control de acceso físico y lógico a instalaciones, equipos, aplicaciones y recursos empresariales.</li>
                                <li>Cumplimiento de obligaciones legales, regulatorias, tributarias, contables, laborales y administrativas.</li>
                                <li>Atención de requerimientos realizados por autoridades judiciales, administrativas o entidades de control legalmente facultadas.</li>
                                <li>Conservación de la historia laboral y documental del colaborador durante los plazos establecidos por la legislación vigente.</li>
                            </ul>

                            <h6 class="fw-bold text-danger">
                                Derechos del titular de la información
                            </h6>

                            <ul class="mb-3">
                                <li>Conocer, actualizar y rectificar sus datos personales.</li>
                                <li>Solicitar prueba de la autorización otorgada.</li>
                                <li>Ser informado sobre el uso dado a su información.</li>
                                <li>Presentar consultas, peticiones, quejas o reclamos.</li>
                                <li>Solicitar la supresión de información cuando legalmente sea procedente.</li>
                                <li>Revocar la autorización otorgada, salvo cuando exista un deber legal o contractual que lo impida.</li>
                            </ul>

                            <div class="alert alert-warning mb-0">
                                <strong>Declaración de autorización:</strong><br />

                                Declaro que he leído y comprendido la presente autorización y autorizo de
                                manera libre, previa, expresa e informada a AVÍCOLA MILUC S.A.S. para el
                                tratamiento de mis datos personales, familiares, laborales, administrativos,
                                médicos ocupacionales y de seguridad social, conforme a las finalidades
                                anteriormente descritas y a la normativa vigente sobre protección de datos
                                personales en Colombia.
                            </div>

                            <div class="form-check mt-3">
                                <input class="form-check-input"
                                       type="checkbox"
                                       @bind="aceptaTerminos" />

                                <label class="form-check-label">
                                    He leído y acepto el tratamiento de mis datos personales.
                                </label>
                            </div>

                        </div>

                        <div class="modal-footer">

                            <button class="btn btn-secondary"
                                    @onclick="CancelarTratamientoDatos">
                                Cancelar
                            </button>

                            <button class="btn btn-danger"
                                    disabled="@(!aceptaTerminos)"
                                    @onclick="AceptarTratamientoDatos">
                                Aceptar y Continuar
                            </button>

                        </div>

                    </div>
                </div>
            </div>
        }
        @* --- FORMULARIO PRINCIPAL --- *@
        <EditForm Model="nuevoEmpleado" OnValidSubmit="EjecutarGuardado">
            <DataAnnotationsValidator />

            <div class="row g-4">

                @* --- BLOQUE 1: DATOS PERSONALES --- *@
                <div class="col-12">
                    <div class="card card-custom border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="section-title-container mb-4">
                                <span class="badge bg-vinotinto-light text-vinotinto rounded-pill mb-2 px-3 py-2 fw-bold text-uppercase tracking-wider">Paso 1</span>
                                <h5 class="fw-bold text-dark m-0">Datos de Identificación</h5>
                            </div>

                            <div class="row g-4">
                                <div class="col-md-4">
                                    <label class="form-label label-custom"><i class="bi bi-person-fill-add"></i> Primer Nombre<span class="text-danger">*</span> </label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.PrimerNombre" placeholder="Ej: Juan" />
                                    </div>
                                    <ValidationMessage For="@(() => nuevoEmpleado.PrimerNombre)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"><i class="bi bi-person-fill-add"></i> Segundo Nombre</label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoNombre" placeholder="Opcional" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-fill-add"></i> Primer Apellido<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.PrimerApellido" placeholder="Primer Apellido" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.PrimerApellido)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-fill-add"></i> Segundo Apellido</label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoApellido" placeholder="Segundo apellido" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-calendar-date"></i> Fecha nacimiento<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <SfDatePicker TValue="DateTime?"
                                                      @bind-Value="nuevoEmpleado.FechaNacimiento"
                                                      Format="dd/MM/yyyy"
                                                      Placeholder="dd/mm/aaaa"
                                                      Width="100%">
                                        </SfDatePicker>
                                        <ValidationMessage For="@(() => nuevoEmpleado.FechaNacimiento)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-vcard"></i> Tipo de documento<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <InputSelect @bind-Value="nuevoEmpleado.TipoDocumentoId" class="form-select">
                                            <option value="">Seleccionar tipo de documento</option>
                                            @foreach (var m in listDocumento)
                                            {
                                                <option value="@m.TipoDocumentoId">@m.Nombre</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => nuevoEmpleado.TipoDocumentoId)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom"><i class="bi bi-person-vcard"></i> Número de Documento <span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.Documento" placeholder="Ej: 100023456" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                                    </div>
                                    <ValidationMessage For="@(() => nuevoEmpleado.Documento)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-calendar-date"></i> Fecha Expedición Documento<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <SfDatePicker TValue="DateTime?"
                                                      @bind-Value="nuevoEmpleado.FechaExpedicionDoc"
                                                      Format="dd/MM/yyyy"
                                                      Placeholder="dd/mm/aaaa"
                                                      Width="100%">
                                        </SfDatePicker>
                                        <ValidationMessage For="@(() => nuevoEmpleado.FechaExpedicionDoc)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-hearts"></i> Estado Civil<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <div class="select2-wrapper">
                                            <InputSelect @bind-Value="nuevoEmpleado.EstadoCivilId" class="form-select">
                                                <option value="">Seleccionar estado civil</option>
                                                @foreach (var estado in listEstadoCivil)
                                                {
                                                    <option value="@estado.EstadoCivilId">@estado.Nombre</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>
                                    <ValidationMessage For="@(() => nuevoEmpleado.EstadoCivilId)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-phone"></i> Celular</label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.Celular" placeholder="Celular" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.Celular)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"><i class="bi bi-phone"></i> Celular Alterno</label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.CelularAlterno" placeholder="Celular Alterno" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.CelularAlterno)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"><i class="bi bi-envelope-at"></i> Correo<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.CorreoElectronico" placeholder="Correo" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.CorreoElectronico)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-dash text-muted"></i> Dirección</label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.Direccion" placeholder="Direccion" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.Direccion)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-dash text-muted"></i> Barrio</label>
                                    <div class="input-group-custom">
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.Barrio" placeholder="Barrio" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.Barrio)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                @* Empresa *@
                                <div class="col-md-4">
                                    <label class="form-label label-custom"><span class="input-icon"><i class="bi bi-building">Seleccione la empresa  </i></span><span class="text-danger">*</span></label>
                                    <div class="select2-wrapper">
                                    <InputSelect @bind-Value="nuevoEmpleado.EmpresaId"
                                                             class="form-select"
                                                             disabled="@EsUsuarioTemporal">

                                                    <option value="">Seleccionar empresa</option>

                                                    @foreach (var empresa in listEmpresas)
                                                    {
                                                        <option value="@empresa.EmpresaId">
                                                            @empresa.EmpresaId - @empresa.NombreEmpresa
                                                        </option>
                                                    }
                                     </InputSelect>
                                                                                    </div>
                                    <ValidationMessage For="@(() => nuevoEmpleado.EmpresaId)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>


                                @* Estado Activo (Switch con icono dinámico) *@
                                <div class="col-md-4 d-flex align-items-center">
                                    <div class="w-100">
                                        <label class="form-label label-custom">Estado del Empleado</label>

                                        <div class="form-check form-switch d-flex align-items-center mt-2">
                                            <InputCheckbox class="form-check-input"
                                                           @bind-Value="nuevoEmpleado.Activo"
                                                           id="activoSwitch"
                                                           style="transform:scale(1.3); cursor:pointer;" />

                                            <label class="form-check-label ms-3 fw-semibold"
                                                   for="activoSwitch"
                                                   style="cursor:pointer;">
                                                @if (nuevoEmpleado.Activo)
                                                {
                                                    <span class="text-black d-flex align-items-center gap-2">
                                                        <i class="bi bi-check-circle-fill fs-5"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger d-flex align-items-center gap-2">
                                                        <i class="bi bi-x-circle-fill fs-5"></i>
                                                    </span>
                                                }
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- BLOQUE 2: UBICACIÓN --- *@
                <div class="col-12 col-lg-6">
                    <div class="card card-custom border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="section-title-container mb-4">
                                    <span class="badge bg-vinotinto-light text-vinotinto rounded-pill mb-2 px-3 py-2 fw-bold text-uppercase tracking-wider">Paso 2</span>
                                    <h5 class="fw-bold text-rojo m-0">Ubicación y Empresa</h5>
                                </div>

                                @* Municipio (Select2 con JS) *@
                                <div class="mb-3">
                                    <label class="form-label label-custom" <span class="input-icon"><i class="bi bi-geo-alt"></i></span> Seleccione el municipio  <span class="text-danger">*</span></label>
                                    <div class="select2-wrapper">
                                        <select id="municipiosSelect" class="form-select input-custom">
                                            <option value="">Buscar municipio...</option>
                                            @foreach (var m in listmunicipios)
                                            {
                                                <option value="@m.Codigo">@m.Nombre - @m.NombreDepartamento</option>
                                            }
                                        </select>
                                    </div>
                                    <ValidationMessage For="@(() => nuevoEmpleado.CodigoMunicipio)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- INFORMACIÓN EXTRA ILUSTRATIVA / COMPLEMENTARIA --- *@
                <div class="col-12 col-lg-6">
                    <div class="card card-info-banner border-0 shadow-sm rounded-4 h-100 p-4 position-relative overflow-hidden">
                        <div class="position-relative z-index-2 d-flex flex-column h-100 justify-content-center">
                            <h5 class="fw-bold text-rojo mb-2"><i class="bi bi-shield-lock-fill me-2"></i>Seguridad de los datos</h5>
                            <p class="text-secondary text-dark small mb-0 lh-lg">
                                Al registrar un nuevo colaborador, asegúrese de validar que el número de identificación coincida exactamente con el documento en físico para mitigar errores en las futuras afiliaciones de seguridad social.
                            </p>
                        </div>
                        <div class="decorative-circle"></div>
                    </div>
                </div>

            </div>

            @* --- VALIDATION SUMMARY SEPARADO CON MARGEN AMPLIADO --- *@
            <div class="mt-5 mb-4">
                <div class="alert alert-warning d-flex align-items-start shadow-sm border-0 rounded-4 p-4">
                    <i class="bi bi-exclamation-triangle-fill me-3 fs-4 text-warning"></i>
                    <div>
                        <strong class="d-block mb-1 text-dark">Por favor revise los siguientes campos antes de continuar:</strong>
                        <div class="validation-summary-container text-muted small">
                            <ValidationSummary />
                        </div>
                    </div>
                </div>
            </div>

            @* --- BARRA DE ACCIONES / BOTÓN GUARDAR --- *@
            <div class="pt-3 border-top d-flex justify-content-end gap-3">
                <button type="button" class="btn btn-light-custom rounded-pill px-4 py-2.5 fw-semibold transition-all" @onclick="Volver">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-rojo btn-lg px-5 rounded-pill shadow-sm fw-bold transition-all d-flex align-items-center" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Procesando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill me-2 "></i>
                        <span>Finalizar Registro</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private EmpleadoCreateDto nuevoEmpleado = new();
    private List<MunicipioReaderDto> listmunicipios = new();
    private List<TipoDocumentoReaderDto> listDocumento = new();
    private List<EstadoCivilReaderDto> listEstadoCivil = new();
    private List<EmpresaReaderDto> listEmpresas = new();
    private bool mostrarModalTratamientoDatos = true;
    private bool aceptaTerminos = false;

    private bool isProcessing = false;
    private bool EsUsuarioTemporal = false;

    public string _correo = "";
    private void AceptarTratamientoDatos()
    {
        aceptaTerminos = true;
        mostrarModalTratamientoDatos = false;

        nuevoEmpleado.AceptaTratamientoDatos = true;
        nuevoEmpleado.FechaAceptacionTratamientoDatos = DateTime.Now;
    }

    private void CancelarTratamientoDatos()
    {
        nav.NavigateTo("/Administrar/Empleado");
    }

    private void Volver() => nav.NavigateTo("/Administrar/Empleado");

    [JSInvokable]
    public void ActualizarMunicipioDesdeJS(string codigo)
    {
        nuevoEmpleado.CodigoMunicipio = codigo;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _correo = _authClientServic.CurrentSession.UserName;

        if (!_authClientServic.HasPermission("Employee.Create"))
        {
            nav.NavigateTo("/no-autorizado");
            return;
        }

        var respuestaMunicipios = await _municipioClientService.GetMunicipiosAsync();
        if (respuestaMunicipios.Valor != null)
            listmunicipios = respuestaMunicipios.Valor;

        var respuestaTipoDocumento = await _tipoDocumentoClientService.GetTipoDocumentosAsync();
        if (respuestaTipoDocumento.Valor != null)
            listDocumento = respuestaTipoDocumento.Valor;

        var respuestaEstado = await _estadoCivil.GetEstadosCivilesAsync();
        if (respuestaEstado.EsCorrecto)
            listEstadoCivil = respuestaEstado.Valor;

        var respuestaEmpresas = await _empresaClientSevice.GetEmpresasAsync(string.Empty, 1, 100);

        if (respuestaEmpresas.EsCorrecto)
        {
            listEmpresas = respuestaEmpresas.Valor;

            int idEmpresa = 0;

            if (_authClientServic.HasPermission("Modulo.Nomina") &&
                _authClientServic.HasFiltro("Modulo.Nomina"))
            {
                var filtroEmpresa = _authClientServic.CurrentSession.Filtros
                    .FirstOrDefault(f => f.NombreModulo == "Modulo.Nomina");

                if (filtroEmpresa != null &&
                    int.TryParse(filtroEmpresa.Filtro, out idEmpresa) &&
                    idEmpresa > 0)
                {
                    EsUsuarioTemporal = true;

                    nuevoEmpleado.EmpresaId = idEmpresa;

                    listEmpresas = listEmpresas
                        .Where(x => x.EmpresaId == idEmpresa)
                        .ToList();
                }
                nuevoEmpleado.AceptaTratamientoDatos = false;
            }
        }

        nuevoEmpleado.FechaNacimiento = null;
        nuevoEmpleado.FechaExpedicionDoc = null;
        nuevoEmpleado.AceptaTratamientoDatos = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetHelper = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("inicializarSelect2", dotNetHelper);
        }
    }

    public async Task EjecutarGuardado()
    {
        if (!nuevoEmpleado.AceptaTratamientoDatos)
        {
            await JS.InvokeVoidAsync(
                "Swal.fire",
                "Atención",
                "Debe aceptar el tratamiento de datos personales para continuar.",
                "warning");

            return;
        }
        isProcessing = true;

        try
        {
            nuevoEmpleado.Usuario.Nombres = $"{nuevoEmpleado.PrimerNombre} {nuevoEmpleado.SegundoNombre}";
            nuevoEmpleado.Usuario.Apellidos = $"{nuevoEmpleado.PrimerApellido} {nuevoEmpleado.SegundoApellido}";
            nuevoEmpleado.Usuario.Email = nuevoEmpleado.CorreoElectronico;
            nuevoEmpleado.Usuario.Telefono = nuevoEmpleado.Celular;
            nuevoEmpleado.Usuario.Password = PasswordGenerator();
            nuevoEmpleado.Usuario.ConfirmarPassword = nuevoEmpleado.Usuario.Password;
            nuevoEmpleado.Usuario.DebeCambiarPassword = true;
            nuevoEmpleado.Usuario.HoraInicio = TimeOnly.Parse("08:00 AM");
            nuevoEmpleado.Usuario.HoraFin = TimeOnly.Parse("05:00 PM");
            nuevoEmpleado.Usuario.CodVendedorSAP = -1;
            nuevoEmpleado.Usuario.TwoFactorEnabled = false;
            nuevoEmpleado.Usuario.TiposUsuarioIds = [2];
            nuevoEmpleado.Usuario.RolesIds = [2];
            nuevoEmpleado.Usuario.IdTipoUsuario = 2;

            var respuesta = await _empleadoService.createEmpleadosAsync(nuevoEmpleado);

            if (respuesta.EsCorrecto)
            {
                await JS.InvokeVoidAsync(
                    "Swal.fire",
                    "Éxito",
                    "La información del empleado ha sido registrada correctamente.",
                    "success");

                Volver();
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "Swal.fire",
                    "Error",
                    respuesta.Mensaje,
                    "error");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "Swal.fire",
                "Fatal Error",
                $"Excepción Interna: {ex.Message}",
                "error");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public string PasswordGenerator()
    {
        const string minusculas = "abcdefghijklmnopqrstuvwxyz";
        const string mayusculas = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string numeros = "0123456789";
        const string caracteresEspeciales = "!@#$%^&*()_+-=[]{}|;:,.<>?";

        const int passwordLength = 8;

        var random = new Random();
        var password = new char[passwordLength];

        for (int i = 0; i < password.Length; i++)
        {
            if (i < 2)
                password[i] = mayusculas[random.Next(mayusculas.Length)];
            else if (i < 4)
                password[i] = numeros[random.Next(numeros.Length)];
            else if (i < 6)
                password[i] = caracteresEspeciales[random.Next(caracteresEspeciales.Length)];
            else
                password[i] = minusculas[random.Next(minusculas.Length)];
        }

        return new string(password);
    }
}
