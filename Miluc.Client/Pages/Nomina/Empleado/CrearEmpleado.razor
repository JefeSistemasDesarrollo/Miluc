@page "/nomina/empleado/crear"

@using Miluc.Client.Interfaces.Nomina
@using Miluc.Shared.DTOs.Nomina.EmpleadoDto
@using Miluc.Shared.DTOs.Nomina.EstadoCivilDto
@using Miluc.Shared.DTOs.Nomina.MunicipioDto
@using Miluc.Shared.DTOs.Nomina.TipoDocumento

@inject NavigationManager nav
@inject IDepartamentosClientService _municipioClientService
@inject ITipoDocumentoClienteService _tipoDocumentoClientService
@inject IEmpleadoClientService _empleadoService
@inject IEstadoCivilClientService _estadoCivil
@inject IJSRuntime JS

<div class="empleado-page p-4 animate__animated animate__fadeIn">
    <div class="container-fluid max-width-container">

        @* --- CABECERA DE LA PÁGINA --- *@
        <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-4">
            <div>
                <h2 class="fw-extrabold text-vinotinto m-0 tracking-tight">
                    <i class="bi bi-person-plus-fill me-2 header-icon"></i>
                    Registrar Empleado
                </h2>
                <p class="text-muted mb-0 small mt-1">
                    Gestione la vinculación de nuevo personal. Los campos marcados con <span class="text-danger">*</span> son requeridos.
                </p>
            </div>

            <button class="btn btn-vinotinto btn-outline-custom rounded-pill px-4 py-2 transition-all fw-semibold" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i> Volver al listado
            </button>
        </div>

        @* --- FORMULARIO PRINCIPAL --- *@
        <EditForm Model="nuevoEmpleado" OnValidSubmit="EjecutarGuardado">
            <DataAnnotationsValidator />

            <div class="row g-4">

                @* --- BLOQUE 1: DATOS PERSONALES --- *@
                <div class="col-12">
                    <div class="card card-custom border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="section-title-container mb-4">
                                <span class="badge bg-vinotinto-light text-vinotinto rounded-pill mb-2 px-3 py-2 fw-bold text-uppercase tracking-wider">Paso 1</span>
                                <h5 class="fw-bold text-dark m-0">Datos de Identificación</h5>
                            </div>

                            <div class="row g-4">



                                <div class="col-md-4">
                                    <label class="form-label label-custom"><i class="bi bi-person-fill-add"></i> Primer Nombre<span class="text-danger">*</span> </label>
                                    <div class="input-group-custom">
                                
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.PrimerNombre" placeholder="Ej: Juan" />
                                    </div>
                                    @* esto es para hacer las validaciones  que esta en el dto  *@
                                    <ValidationMessage For="@(() => nuevoEmpleado.PrimerNombre)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"><i class="bi bi-person-fill-add"></i> Segundo Nombre</label>
                                    <div class="input-group-custom">
                                   
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoNombre" placeholder="Opcional" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-fill-add"></i> Primer Apellido<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                    
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.PrimerApellido" placeholder="Primer Apellido" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.PrimerApellido)" class="text-danger small mt-1 d-block fw-medium" />

                                    </div>
                                </div>



                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-fill-add"></i> Segundo Apellido</label>
                                    <div class="input-group-custom">
                                       
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoApellido" placeholder="Segundo apellido" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-calendar-date"></i> Fecha nacimiento<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <InputDate class="form-control input-custom"
                                                   @bind-Value="nuevoEmpleado.FechaNacimiento"
                                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                   
                                        <ValidationMessage For="@(() => nuevoEmpleado.FechaNacimiento)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>


                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-vcard"></i> Tipo de documento<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                      

                                        <InputSelect @bind-Value="nuevoEmpleado.TipoDocumentoId" class="form-control input-custom">
                                            <option value="">Seleccionar tipo de documento</option>
                                            @foreach (var m in listDocumento)
                                            {
                                                <option value="@m.TipoDocumentoId">@m.Nombre</option>
                                            }
                                        </InputSelect>

                                 
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom"><i class="bi bi-person-vcard"></i> Número de Documento <span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.Documento" placeholder="Ej: 100023456" />
                                    </div>
                                    <ValidationMessage For="@(() => nuevoEmpleado.Documento)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-calendar-date"></i> Fecha Expedición Documento<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                        <InputDate class="form-control input-custom"
                                                   @bind-Value="nuevoEmpleado.FechaExpedicionDoc" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.FechaExpedicionDoc)" class="text-danger small mt-1 d-block fw-medium" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-hearts"></i> Estado Civil<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                    

                                        <div class="select2-wrapper">

                                            <InputSelect @bind-Value="nuevoEmpleado.EstadoCivilId" class="form-control input-custom">
                                                <option value="">Seleccionar estado civil</option>
                                                @foreach (var estado in listEstadoCivil)
                                                {
                                                    <option value="@estado.EstadoCivilId">@estado.Nombre</option>
                                                }
                                            </InputSelect>
                                                                                   
                                        </div>
                                    </div>
                                    <ValidationMessage For="@(() => nuevoEmpleado.EstadoCivilId)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-phone"></i> Celular</label>
                                    <div class="input-group-custom">
                                        @*<span class="input-icon"><i class="bi bi-person-dash text-muted"></i></span>*@

                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.Celular" placeholder="Celular" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.Celular)" class="text-danger small mt-1 d-block fw-medium" />
                                        @* <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoApellido" placeholder="Segundo apellido" /> *@
                                    </div>
                                </div>


                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"><i class="bi bi-phone"></i> Celular Alterno</label>
                                    <div class="input-group-custom">
                                    
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.CelularAlterno" placeholder="Celular Alterno" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.CelularAlterno)" class="text-danger small mt-1 d-block fw-medium" />
                                        @* <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoApellido" placeholder="Segundo apellido" /> *@
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"><i class="bi bi-envelope-at"></i> Correo<span class="text-danger">*</span></label>
                                    <div class="input-group-custom">
                                      
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.CorreoElectronico" placeholder="Correo" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.CorreoElectronico)" class="text-danger small mt-1 d-block fw-medium" />
                                        @* <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoApellido" placeholder="Segundo apellido" /> *@
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-dash text-muted"></i> Dirección</label>
                                    <div class="input-group-custom">
                                        

                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.Direccion" placeholder="Direccion" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.Direccion)" class="text-danger small mt-1 d-block fw-medium" />
                                        @* <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoApellido" placeholder="Segundo apellido" /> *@
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label label-custom text-muted-custom"> <i class="bi bi-person-dash text-muted"></i> Barrio</label>
                                    <div class="input-group-custom">
                                        
                                        <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.Barrio" placeholder="Barrio" />
                                        <ValidationMessage For="@(() => nuevoEmpleado.Barrio)" class="text-danger small mt-1 d-block fw-medium" />
                                        @* <InputText class="form-control input-custom" @bind-Value="nuevoEmpleado.SegundoApellido" placeholder="Segundo apellido" /> *@
                                    </div>
                                </div>



                                
                            </div>
                        </div>
                    </div>
                </div>

                @* --- BLOQUE 2: UBICACIÓN --- *@
                <div class="col-12 col-lg-6">
                    <div class="card card-custom border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="section-title-container mb-4">
                                    <span class="badge bg-vinotinto-light text-vinotinto rounded-pill mb-2 px-3 py-2 fw-bold text-uppercase tracking-wider">Paso 2</span>
                                    <h5 class="fw-bold text-dark m-0">Ubicación y Residencia</h5>
                                </div>
                                @*munucipio*@
                                <div class="mb-2">
                                    <label class="form-label label-custom">Seleccione el municipio <span class="text-danger">*</span></label>
                                    <div class="select2-wrapper">

                                        
                                         

                                        <select id="municipiosSelect" class="form-select input-custom">
                                            <option value="">Buscar municipio...</option>
                                            @foreach (var m in listmunicipios)
                                            {
                                                <option value="@m.Codigo">@m.Nombre - @m.NombreDepartamento</option>
                                            }
                                        </select>
                                    </div>
                                    <ValidationMessage For="@(() => nuevoEmpleado.CodigoMunicipio)" class="text-danger small mt-1 d-block fw-medium" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- INFORMACIÓN EXTRA ILUSTRATIVA / COMPLEMENTARIA --- *@
                <div class="col-12 col-lg-6">
                    <div class="card card-info-banner border-0 shadow-sm rounded-4 h-100 p-4 position-relative overflow-hidden">
                        <div class="position-relative z-index-2 d-flex flex-column h-100 justify-content-center">
                            <h5 class="fw-bold text-vinotinto mb-2"><i class="bi bi-shield-lock-fill me-2"></i>Seguridad de los datos</h5>
                            <p class="text-secondary small mb-0 lh-lg">
                                Al registrar un nuevo colaborador, asegúrese de validar que el número de identificación coincida exactamente con el documento en físico para mitigar errores en las futuras afiliaciones de seguridad social.
                            </p>
                        </div>
                        <div class="decorative-circle"></div>
                    </div>
                </div>

            </div>

            @* --- BARRA DE ACCIONES / BOTÓN GUARDAR --- *@
            <div class="mt-5 pt-3 border-top d-flex justify-content-end gap-3">
                <button type="button" class="btn btn-light-custom rounded-pill px-4 py-2.5 fw-semibold transition-all" @onclick="Volver">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-vinotinto btn-lg px-5 rounded-pill shadow-sm fw-bold transition-all d-flex align-items-center" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Procesando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <span>Finalizar Registro</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>


@code {
    private EmpleadoCreateDto nuevoEmpleado = new();
    private List<MunicipioReaderDto> listmunicipios = new();
    private List<TipoDocumentoReaderDto> listDocumento = new();
    private List<EstadoCivilReaderDto> listEstadoCivil = new();
    private bool isProcessing = false;

    private void Volver() => nav.NavigateTo("/Administrar/Empleado");


    [JSInvokable]
    public void ActualizarMunicipioDesdeJS(string codigo)
    {
        nuevoEmpleado.CodigoMunicipio = codigo;
        StateHasChanged();
    }
    //cuando se inicializala aplicacion por primera vez 
    //aca vamos acargar todos las tablas dependientes paara crear empleados 

    protected override async Task OnInitializedAsync()
    {
        var respuestaMunicipios = await _municipioClientService.GetMunicipiosAsync();
        if (respuestaMunicipios.Valor != null)
            listmunicipios = respuestaMunicipios.Valor;

        // //aca vamos a caragar el tipo de documento para mostrarlo en el select
        var respuestaTipoDocumento = await _tipoDocumentoClientService.GetTipoDocumentosAsync();
        if (respuestaTipoDocumento.Valor != null)
            listDocumento = respuestaTipoDocumento.Valor;

        var respuestaEstado = await _estadoCivil.GetEstadosCivilesAsync();
        if (respuestaEstado.EsCorrecto)
            listEstadoCivil = respuestaEstado.Valor;

        // Deja que arranquen en null para que el [Required] funcione en la UI
        nuevoEmpleado.FechaNacimiento = null;
        nuevoEmpleado.FechaExpedicionDoc = null;


    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetHelper = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("inicializarSelect2", dotNetHelper);
        }
    }

    public async Task EjecutarGuardado()
    {
        isProcessing = true;
        try
        {
            var respuesta = await _empleadoService.createEmpleadosAsync(nuevoEmpleado);
            if (respuesta.EsCorrecto)
            {
                await JS.InvokeVoidAsync("Swal.fire", "Éxito", "La información del empleado ha sido registrada correctamente.", "success");
                Volver();
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", "Error", $"No se pudo crear: {respuesta.Mensaje}", "error");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Fatal Error", $"Excepción Interna: {ex.Message}", "error");
        }
        finally
        {
            isProcessing = false;
        }
        finally { isProcessing = false; }
    }
}

@* --- LÓGICA JAVASCRIPT --- *@
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    window.inicializarSelect2 = (dotNetHelper) => {
        const select = $('#municipiosSelect');

        select.select2({
            placeholder: "Buscar municipio...",
            allowClear: true,
            width: '100%'
        });

        select.on('change', function() {
            dotNetHelper.invokeMethodAsync('ActualizarMunicipioDesdeJS', $(this).val());
        });
    };
</script>