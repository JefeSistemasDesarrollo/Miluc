@page "/Usuarios"
@using Miluc.Client.Interfaces
@using Miluc.Client.Interfaces.UsuariosRolesPermisos
@using Miluc.Shared.DTOs.Usuarios
@using System.Text.Json
@inject NavigationManager Nav
@inject IUsuarioClientService _usuarioClientService;
@inject IJSRuntime js
@inject IAuthClientService authService
@inject ILogClientService logClient
<div class="usuarios-page animate__animated animate__fadeIn p-4">
    @* header *@
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-vinotinto m-0 ">
                <i class="bi bi-person-badge-fill me-2"> Gestionar Usuarios</i>
            </h2>
            <p class="m-0 text-muted">Administrcion de usuarios</p>
        </div>
        @if (authService.HasPermission("Usuario.Create"))
        {
            <button class="btn btn-vinotinto  btn-nuevo rounded-pill px-4 shadow-sm" @onclick=IrACrear>
                <i class="bi bi-plus-lg me-1"></i> Nuevo
            </button>
        }
    </div>

    @* --- BARRA DE BÚSQUEDA --- *@
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-lg-7">
                    <div class="input-group input-group-lg search-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        @* para actualizar en tiempo real cada vez que precione una tecla
                                no HACERLO contenteditable EL ONCHAGE *@
                        <input type="text" class="form-control border-start-0 shadow-none fs-6"
                               placeholder="Filtrar local o buscar en servidor..."
                               @bind="textoBusqueda" @bind:event="oninput" @onkeyup="HandleEnter" />
                        <button class="btn btn-vinotinto rounded-end-pill px-4" @onclick="BuscarEnServidor">
                            <i class="bi bi-search me-2"></i>
                        </button>
                    </div>
                </div>
                <div class="col-lg-5 text-lg-end">
                    <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border">
                        <label class="mx-3 small fw-bold text-muted text-uppercase">Mostrar</label>
                        <select class="form-select form-select-sm rounded-pill border-0 bg-transparent fw-bold"
                                style="width: 80px;"
                                value="@cantidadPorPagina"
                                @onchange="CambiarCantidadPagina">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                        <span class="badge bg-vinotinto rounded-pill ms-2 px-3 py-2">
                            Total: @totalRegistros
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* vamos a mostrar la tabla de usuarios aqui *@

    @if (authService.HasPermission("Usuario.View"))
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

            <div class="table-responsive">
                <table class=" table table-striped table table-hover mb-0">
                    <thead class="bg-vinotinto text-white">
                        <tr>
                            <th class="ps-4 py-3">Perfil</th>
                            <th class="text-center">Usuario</th>
                            <th class="text-lg-center">Nombres</th>
                            <th class="text-center">Tipo </th>
                            <th class="text-center">Roles</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center pe-4">Acciones</th>

                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        @* Aquí se iteraría sobre la lista de usuarios *@
                        @* Ejemplo de fila de usuario *@
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="spinner-border text-vinotinto"></div>
                                </td>
                            </tr>
                        }
                        else if (!listUsuariosApi.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    No hay usuarios registrados
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in listUsuariosApi)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="position-relative">

                                                @if (user.Foto != null && user.Foto.Length > 0)
                                                {
                                                    <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(user.Foto)}")" alt="Foto de perfil" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                        <i class="bi bi-person-fill fs-4"></i>
                                                    </div>
                                                }
                                                <span class="position-absolute bottom-0 end-0 p-1 @(user.Activo ? "bg-success" : "bg-danger") border border-light rounded-circle"></span>
                                            </div>
                                            <div class="ms-3">
                                                <div class="fw-bold text-dark small mb-0">@user.Nombres @user.Apellidos</div>
                                                <div class="text-muted x-small">ID: #@user.IdUsuario</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@user.UserName</span>
                                        <span class="badge bg-light text-dark border">@user.Email</span>
                                    </td>
                                    <td>
                                        <div class="text-muted x-small">@user.NombreCompleto</div>
                                    </td>
                                    <td>
                                        @if (user.NombresTiposUsuario != null)
                                        {
                                            @foreach (var tipo in user.NombresTiposUsuario)
                                            {
                                                <span class="badge text-bg-secondary  rounded-pill x-small me-1">@tipo</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (user.NombresRoles != null)
                                        {
                                            @foreach (var roles in user.NombresRoles)
                                            {
                                                <span class=" badge badge-rol me-1  bg-warning-subtle text-bg-warning border border-warning-subtle rounded-pill x-small me-1">@roles</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="status-badge status-pill @(user.Activo ? "Activo" : "DesActivado")">
                                            @(user.Activo ? "Activo" : "DesActivado")
                                        </span>
                                    </td>
                                    @*VER EL DETALLE *@
                                    <td class="text-center pe-4">

                                        @if (authService.HasPermission("Usuario.Detail"))

                                        {
                                            <div class="btn-group shadow-sm border rounded-pill bg-white overflow-hidden">
                                                <button class=" btn-detail btn btn-dark btn-sm px-2 border-end " title="Ver Detalle" @onclick="() => VerDetalle(user.IdUsuario)">
                                                    <i class="bi bi-eye text-dark"></i>
                                                </button>
                                            </div>
                                        }
                                        @* EDITAR *@
                                        @if (authService.HasPermission("Usuario.Update"))
                                        {
                                            <button class="btn btn-white btn-sm px-2 border-end edit" title="Editar Usuario" @onclick="() => EditarUsuario(user.IdUsuario)">
                                                <i class="bi bi-pencil-square text-primary"></i>
                                            </button>
                                        }
                                        @* CAMBIAR ESTADO (ACTIVAR/DESACTIVAR) *@
                                        @*   <button class="btn btn-white btn-sm px-2 border-end" title="Cambiar Estado" @onclick="() => AlternarEstado(user)">
                                    <i class="bi @(user.Activo ? "bi-person-x text-warning" : "bi-person-check text-success")"></i>
                                </button> *@
                                        @* ELIMINAR *@

                                        @if (authService.HasPermission("Usuario.Delete"))
                                        {
                                            <button class="btn btn-white btn-sm px-2 delete" title="Eliminar" @onclick="() => EliminarUsuario(user.IdUsuario)">
                                                <i class="bi bi-trash3 text-danger"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <div class="pagination-footer d-flex justify-content-between align-items-center mt-4">
        <div class=" page-link text-muted small">Página <b>@paginaActual</b> de @totalPaginas</div>
        <div class="page-item.active pagination-container p-1 bg-white border rounded-pill shadow-sm">
            <button class="btn btn-sm rounded-circle @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)"><i class="bi bi-chevron-left"></i></button>
            <span class="mx-3 fw-bold text-vinotinto">@paginaActual</span>
            <button class="btn btn-sm rounded-circle @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)"><i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
</div>
@code
{
    private List<UsuarioReadDto> listaOriginal = new();
    private List<UsuarioReadDto> listUsuariosApi = new();

    private string _textoBusqueda = "";
    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            FiltrarLocal();
        }
    }

    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private int totalRegistros = 0;
    private bool cargando = false;

    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        cantidadPorPagina = int.Parse(e.Value!.ToString()!);
        paginaActual = 1;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await CargarUsuarios();
        else
            await BuscarEnServidor();
    }
    //para qyue funcione para las dos busquedas tanto local como en servidor
    private int totalPaginas
    {
        get
        {
            var total = string.IsNullOrWhiteSpace(_textoBusqueda)
                ? totalRegistros
                : listUsuariosApi.Count;

            return (int)Math.Ceiling((double)total / cantidadPorPagina);
        }
    }

    //aca cargo las lista una para mantener el original y otra para mostrar los resultados filtrados
    private async Task CargarUsuarios()
    {
        try
        {
            cargando = true;
            var response = await _usuarioClientService
                .ListarUsuariosAsync("", paginaActual, cantidadPorPagina); //  SIN textoBusqueda

            if (response != null)
            {
                listaOriginal = response.Valor;
                listUsuariosApi = listaOriginal.ToList();
                totalRegistros = response.CantRegistros;
            }

            cargando = false;
        }
        catch (Exception ex)
        {
            cargando = false;

             await logClient.GuardarErrorAsync(
                       ex.Message,
                       ex.StackTrace,
                      usuario: authService.CurrentSession.UserName ?? "No encontrado",
                     metodo: "CargarUsuarios",
                       ruta: $"/Usuarios",
                       origen: "Blazor cliente",
                       nivel: "error");


            await js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Error al cargar usuarios",
                text = ex.Message
            });
        }
    }

    private void FiltrarLocal()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            listUsuariosApi = listaOriginal.ToList();
            return;
        }

        listUsuariosApi = listaOriginal
            .Where(u =>
                (u.Nombres?.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Apellidos?.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.UserName?.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Email?.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)
            )
            .ToList();
    }


    private async Task BuscarEnServidor()
    {
        paginaActual = 1;
        cargando = true;

        var response = await _usuarioClientService
            .ListarUsuariosAsync(_textoBusqueda, paginaActual, cantidadPorPagina);

        if (response != null)
        {
            listaOriginal = response.Valor;
            listUsuariosApi = listaOriginal.ToList();
            totalRegistros = response.CantRegistros;
        }
        else
        {
            listUsuariosApi = new List<UsuarioReadDto>();
            string errores = response.Errores != null && response.Errores.Any()
               ? string.Join("<br>", response.Errores)
               : "Ocurrió un error inesperado.";

            await js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = $"Error al consultar usuarios {response.Mensaje} ",
                text = $"{errores}",
                confirmButtonColor = "#6c1d1d"
            });
        }

        cargando = false;
    }
    private async Task IrPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1)
            return;

        paginaActual = nuevaPagina;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await CargarUsuarios();
        else
            await BuscarEnServidor();
    }



    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private void IrACrear() =>
    Nav.NavigateTo("/Usuarios/Crear");

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            paginaActual = 1;
            await BuscarEnServidor();
        }
    }

    private void EditarUsuario(int IdUsuario)
    {
        Nav.NavigateTo($"/Usuarios/Editar/{IdUsuario}");
    }
    private void VerDetalle(int IdUsuario)
    {
        Nav.NavigateTo($"/Usuarios/Detalle/{IdUsuario}");
    }

    private async Task EliminarUsuario(int IdUsuario)
    {
        var result = await js.InvokeAsync<JsonElement>
            ("Swal.fire", new
            {
                title = "¿Estás seguro?",
                text = $"¿Deseas eliminar el usuario {IdUsuario}?",
                icon = "warning",
                showCancelButton = true,
                confirmButtonColor = "#d33",
                cancelButtonColor = "#3085d6",
                confirmButtonText = "Sí, eliminar",
                cancelButtonText = "Cancelar"
            });

        if (result.GetProperty("isConfirmed").GetBoolean())
        {
            var response = await _usuarioClientService.EliminarUsuarioAsync(IdUsuario);

            if (response.EsCorrecto)
            {
                await js.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "success",
                    title = "Usuario Eliminado",
                    text = response.Mensaje,
                    confirmButtonColor = "#6c1d1d"
                });

                await CargarUsuarios();
            }
            else
            {
                string erroresConcatenados = response.Errores != null && response.Errores.Any()
                ? string.Join("<br>", response.Errores)
                : "Ocurrió un error inesperado.";

                await js.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = "Error al eliminar el usuario",
                    html = erroresConcatenados,
                    confirmButtonColor = "#6c1d1d"
                });
            }
        }
    }
}
