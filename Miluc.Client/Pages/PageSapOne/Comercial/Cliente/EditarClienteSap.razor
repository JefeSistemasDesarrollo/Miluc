        sapClienteCreateDto.U_HBT_MailRecep_FE = cliente.EmailAddress;
        sapClienteCreateDto.ZipCode = cliente.ZipCode;

        if (cliente.validFor == false)
        {
            sapClienteCreateDto.Valid = "tNO";
            sapClienteCreateDto.Frozen = "tYES";
        }
        else
        {
            sapClienteCreateDto.Valid = "tYES";
            sapClienteCreateDto.Frozen = "tNO";
        }

        sapClienteCreateDto.BPAddresses.Add(new AddressClienteDto
        {
            AddressName = "PRINCIPAL",
            Street = direccionFactura.Street,
            Block = direccionFactura.Block,
            ZipCode = cliente.ZipCode,
            City = "BOGOTA",
            County = "BOGOTÁ (D.C)",
            Country = "CO",
            AddressType = "bo_BillTo",
            U_HBT_MunMed = cliente.U_HBT_MunMed,
            U_HBT_DirMM = "Y"
        });

        sapClienteCreateDto.BPAddresses.Add(new AddressClienteDto
        {
            AddressName = "PRINCIPAL",
            Street = direccionDespacho.Street,
            Block = direccionDespacho.Block,
            ZipCode = cliente.ZipCode,
            City = "BOGOTA",
            County = "BOGOTÁ (D.C)",
            Country = "CO",
            AddressType = "bo_ShipTo",
            U_HBT_MunMed = cliente.U_HBT_MunMed,
            U_HBT_DirMM = "N"
        });

        if (cliente.U_AplicaBolsaMercantilcheck == false)
        {
            sapClienteCreateDto.U_AplicaBolsaMercantil = "N";
        }
        else
        {
            sapClienteCreateDto.U_AplicaBolsaMercantil = "Y";
        }


        var listtapropiedadesSelecionadas = listaPropiedades.Where(x => x.Activa == true).ToList();

        foreach (var propiedad in listaPropiedades)
        {
            var info = sapClienteCreateDto.GetType().GetProperty(propiedad.Propiedad);

            if (info != null && info.CanWrite)
            {
                info.SetValue(sapClienteCreateDto, propiedad.Activa ? "tYES" : "tNO");
            }
        }
        sapClienteCreateDto.FreeText = cliente.FreeText;

        foreach (var impuestos in listretencionDtos)
        {
            if (impuestos.Activa == true)
            {

                sapClienteCreateDto.BPWithholdingTaxCollection.Add(new SapBPWithholdingTaxDto
                {
                    WTCode = impuestos.WTCode,
                    BPCode = sapClienteCreateDto.CardCode
                });
            }
        }
        var response = await _sapOcrdClientService.ActualizarClienteAsync(cardCode, sapClienteCreateDto);


        if (response.EsCorrecto == true)
        {
            await _jsRuntime.InvokeVoidAsync("Swal.fire",
                          "Correcto",
                          $"El cliente se ha creado correctamente: {response.Valor.CardCode}",
                          "success");
            _nav.NavigateTo("/administrar-cliente/sap", forceLoad: true);
        }
        else
        {
            string errores = response.Errores != null && response.Errores.Any()
            ? string.Join("<br>", response.Errores)
            : "Ocurrió un error inesperado.";

            await _jsRuntime.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = $"Error al consultar socio de negocio",
                text = $"{errores}",
                confirmButtonColor = "#6c1d1d"
            });
        }
    }
