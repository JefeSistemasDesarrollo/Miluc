    public List<HbtActividadEconomicaDto> listOriginalActividadEconomica = new();
    public List<TipoEntidadPersonaDto> listTipoEntidad = new();
    public List<NacionalidadClienteDto> listNacionalidad = new();
    public List<SapMediosDePagoDto> lisMediosDePago = new();
    public List<SapInformacionTributariaDto> lisInformacionTributaria = new();
    public List<SapResponsabilidadFiscalDto> lisregimenfiscal1 = new();
    public List<RecidenteDto> listResidente = new();
    //codigo postal
    public AddressClienteDto direccionFactura = new AddressClienteDto();
    public AddressClienteDto direccionDespacho = new AddressClienteDto();
    private bool mostrarCodigoPostal = false;
    private bool mostrarActividadEconomica = false;
    private bool mostrarModalMunicipio = false;
    public int PaginaActualCodigo = 1;
    public int PaginaActualMunicipio = 1;
    public int PaginaActualActividadEconomica = 1;
    private int CantidadDeActividadEconomicaEncontrados = 0;
    private int CantidadDeCodigosPostalesEncontrados = 0;
    private int CantidadDeMunicipiosEncontrados = 0;
    private int CantidadPorPaginaCodigo = 10; // Cantidad de registros por página
    private int CantidadPorPaginaMunicipio = 10; // Cantidad de registros por página
    private int CantidadPorPaginaActividadEconomica = 10; // Cantidad de registros por página
    private bool cargandoCodigoPostal = false;
    private bool cargandoMunicipio = false;
    private string textoBusquedaActividadEconomica
    {
        get => _textoBusquedaActividadEconomica;
        set
        {
            if (_textoBusquedaActividadEconomica != value)
            {
                _textoBusquedaActividadEconomica = value;
                FiltrarActividadEconomica();
            }
        }
    }
    private string textoBusquedaCodigo
    {
        get => _textoBusquedaCodigo;
        set
        {
            if (_textoBusquedaCodigo != value)
            {
                _textoBusquedaCodigo = value;
                FiltrarCodigoPostal();
            }
        }
    }
    private string textoBusquedaMunicipio
    {
        get => _textoBusquedaMunicipio;
        set
        {
            if (_textoBusquedaMunicipio != value)
            {
                _textoBusquedaMunicipio = value;
                FiltrarMunicipio();
            }
        }
    }
    public int TotalPaginasCodigo => (int)Math.Ceiling((double)CantidadDeCodigosPostalesEncontrados / CantidadPorPaginaCodigo);
    private int TotalPaginasActividadEconomica => (int)Math.Ceiling((double)CantidadDeActividadEconomicaEncontrados / CantidadPorPaginaActividadEconomica);
    private int TotalPaginasMunicipio => (int)Math.Ceiling((double)CantidadDeMunicipiosEncontrados / CantidadPorPaginaMunicipio);
    private string DigitoVerificacion => string.IsNullOrWhiteSpace(cliente.FederalTaxID) ? "" : CalcularDV(cliente.FederalTaxID).ToString();
    private async Task PaginaAnteriorCodigo()
    {
        if (PaginaActualCodigo > 1)
        {
            PaginaActualCodigo--;
            await BuscarEnServidorCodigoPostal(_textoBusquedaCodigo, PaginaActualCodigo, CantidadPorPaginaCodigo);
        }
    }
    private async Task PaginaSiguienteCodigo()
    {
        if (PaginaActualCodigo < TotalPaginasCodigo)
        {
            PaginaActualCodigo++;
            await BuscarEnServidorCodigoPostal(_textoBusquedaCodigo, PaginaActualCodigo, CantidadPorPaginaCodigo);
        }
    }
    private async Task IrPaginaCodigo(int pagina)
    {
        PaginaActualCodigo = pagina;
        await BuscarEnServidorCodigoPostal(_textoBusquedaCodigo, PaginaActualCodigo, CantidadPorPaginaCodigo);
    }
    private async Task IrPaginaActividadEconomica(int pagina)
    {
        PaginaActualActividadEconomica = pagina;
        await BuscarEnServidorActividadEconomica(_textoBusquedaActividadEconomica, PaginaActualActividadEconomica, CantidadPorPaginaActividadEconomica);
    }
    private async Task PaginaSiguienteActividadEconomica()
    {
        if (PaginaActualActividadEconomica < TotalPaginasActividadEconomica)
        {
            PaginaActualActividadEconomica++;
            await BuscarEnServidorActividadEconomica(_textoBusquedaActividadEconomica, PaginaActualActividadEconomica, CantidadPorPaginaActividadEconomica);
        }
    }
    public async Task PaginaAnteriorActividadEconomica()
    {
        if (PaginaActualActividadEconomica > 1)
        {
            PaginaActualActividadEconomica--;
            await BuscarEnServidorActividadEconomica(_textoBusquedaActividadEconomica, PaginaActualActividadEconomica, CantidadPorPaginaActividadEconomica);
        }
    }
    //municipio
    private async Task PaginaAnteriorMunicipio()
    {
        if (PaginaActualMunicipio > 1)
        {
            PaginaActualMunicipio--;
            await BuscarEnServidorMunicipio(_textoBusquedaMunicipio, PaginaActualMunicipio, CantidadPorPaginaMunicipio);
        }
    }
    private async Task PaginaSiguienteMunicipio()
    {
        if (PaginaActualMunicipio < TotalPaginasMunicipio)
        {
            PaginaActualMunicipio++;
            await BuscarEnServidorMunicipio(_textoBusquedaMunicipio, PaginaActualMunicipio, CantidadPorPaginaMunicipio);
        }
    }
    private async Task IrPaginaMunicipio(int pagina)
    {
        PaginaActualMunicipio = pagina;
        await BuscarEnServidorMunicipio(_textoBusquedaMunicipio, PaginaActualMunicipio, CantidadPorPaginaMunicipio);
    }

    //seleccionar
    private void SeleccionarCodigoPostal(HBT_codigosPostalesDto codigo)
    {
        if (codigo.Code != null)
        {
            cliente.ZipCode = codigo.Code;
            CerrarModalCodigoPostal();
        }
    }
    private void SeleccionarMunicipio(HbtMunicipiosDto municipio)
    {
        if (municipio.Code != null)
        {
            cliente.U_HBT_MunMed = municipio.Code;
            CerrarModalMunicipio();
        }
    }
    private void SeleccionarActividadEconomica(HbtActividadEconomicaDto actividad)
    {
        if (actividad.Code != null)
        {
            cliente.U_HBT_ActEco = actividad.Code;
            CerrarModalActividadEconomica();
        }
    }
    //filtrar
    private void FiltrarActividadEconomica()
    {
        if (string.IsNullOrEmpty(_textoBusquedaActividadEconomica))
        {
            listActividadEconomicaApi = listOriginalActividadEconomica.ToList();
            return;
        }
        listActividadEconomicaApi = listOriginalActividadEconomica
            .Where(a => a.Code.Contains(_textoBusquedaActividadEconomica, StringComparison.OrdinalIgnoreCase) ||
                        a.Name.Contains(_textoBusquedaActividadEconomica, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
    private void FiltrarCodigoPostal()
    {
        if (string.IsNullOrEmpty(_textoBusquedaCodigo))
        {
            listCodigosPostalesApi = listOiginalCodigosPostales.ToList();
            return;
        }
        listCodigosPostalesApi = listOiginalCodigosPostales
            .Where(c => c.Code.Contains(_textoBusquedaCodigo, StringComparison.OrdinalIgnoreCase) ||
                        c.U_HBT_Lugar.Contains(_textoBusquedaCodigo, StringComparison.OrdinalIgnoreCase) ||
                        c.Name.Contains(_textoBusquedaCodigo, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void FiltrarMunicipio()
    {
        if (string.IsNullOrEmpty(_textoBusquedaMunicipio))
        {
            listaMunicipiosApi = listaOriginalMunicipios.ToList();
            return;
        }

        listaMunicipiosApi = listaOriginalMunicipios
            .Where(m => m.Code.Contains(_textoBusquedaMunicipio, StringComparison.OrdinalIgnoreCase) ||
                        m.Name.Contains(_textoBusquedaMunicipio, StringComparison.OrdinalIgnoreCase))
            .ToList();


    }

    private async Task HandleEnterCodigoPostal(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
