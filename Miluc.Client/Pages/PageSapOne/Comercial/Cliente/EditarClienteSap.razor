@page "/Administrar-Cliente/Sap/Editar/{cardCode}"
@using Miluc.Client.Interfaces.SapInterfaces.Cliente
@using Miluc.Shared.DTOs.Sap.Cliente
@using Miluc.Shared.DTOs.Sap.GrupoDeVenta
@using Miluc.Client.Interfaces.SapInterfaces.LocalizacionSap
@using Shared.DTOs.Sap.RegimenFiscal
@using Shared.DTOs.Sap.Retenciones
@using Miluc.Client.Interfaces.SapInterfaces.Oslp
@using Miluc.Shared.DTOs.Sap.Cliente.RegimeNTributario
@using Shared.DTOs.Sap.Credito
@using Shared.DTOs.Sap.Vendedor
@using Shared.DTOs.Sap.Opln
@using Miluc.Client.Interfaces.SapInterfaces.Rutas
@using Miluc.Client.Interfaces.SapInterfaces.Octg
@using Miluc.Client.Interfaces.SapInterfaces.Opln
@using Shared.DTOs.Sap.Rutas
@using Shared.DTOs.Sap.ActividadEconomica
@using Shared.DTOs.Sap.Cliente.EntidadCliente
@using Shared.DTOs.Sap.Cliente.MediosDePago
@using Shared.DTOs.Sap.Cliente.InformacionTributaria
@using Shared.DTOs.Sap.Cliente.HBT_RESPFISCAL
@using Shared.DTOs.Sap.Impuesto
@using Shared.DTOs.Sap.DireccionCliente
@inject NavigationManager _nav
@inject IJSRuntime _jsRuntime
@inject ILocalizacionClientSap _sapLocalizacionService
@inject ISapOcrdClientService _sapOcrdClientService
@inject ISapOslpService _sapOslpClienteService
@inject ISapObppClientService _sapObppClienteService
@inject ISapOctgClientService _sapoctgClienteService
@inject ISapOplnClientService _sapOplnClientService
<div class="container-fluid py-4 bg-light-gradient min-vh-100 animate__animated animate__fadeIn">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="p-3 bg-rojo-suave text-rojo rounded-3 fs-3">
                <i class="bi bi-person-fill-add"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0 fs-3">Maestro de Clientes (SAP B1)</h2>
                <p class="m-0 text-muted small">Edición y sincronización de Socios de Negocio</p>
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-outline-secondary btn-lg rounded-pill px-4 shadow-sm w-100 w-sm-auto fs-6 fw-semibold transition-all mb-lg-2 " @onclick='() => _nav.NavigateTo("/administrar-cliente/sap")'>
                <i class="bi bi-arrow-left me-2"></i> Volver
            </button>

            <span class="badge bg-vinotinto-suave text-vinotinto border border-vinotinto-subtle rounded-pill px-3 py-2 fw-bold">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Editar socio en SAP
            </span>
        </div>
    </div>
    <EditForm Model="@cliente" OnValidSubmit="EditarClienteAsync">
        <DataAnnotationsValidator />

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white border-0 p-0">
                <ul class="nav nav-tabs nav-justified border-bottom-0" id="sapTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active py-3 fw-semibold text-secondary @(activeTab == "general" ? "active-sap-tab text-vinotinto" : "")"
                                @onclick='() => CambiarTab("general")' type="button">
                            <i class="bi bi-info-circle-fill me-2"></i>General
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-3 fw-semibold text-secondary @(activeTab == "fiscales" ? "active-sap-tab text-vinotinto" : "")"
                                @onclick='() => CambiarTab("fiscales")' type="button">
                            <i class="bi bi-file-earmark-gavel me-2"></i>Datos Fiscales
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-3 fw-semibold text-secondary @(activeTab == "propiedades" ? "active-sap-tab text-vinotinto" : "")"
                                @onclick='() => CambiarTab("propiedades")' type="button">
                            <i class="bi bi-tags-fill me-2"></i>Propiedades y Comentarios
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-4 bg-white">
                <div class="tab-content">

                    @* - TAB 1: GENERAL - *@
                    <div class="tab-pane fade @(activeTab == "general" ? "show active" : "")">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Tipo Documento *</label>
                                <InputSelect @bind-Value="cliente.U_HBT_TipDoc" class="form-select form-select-sm">
                                    <option value="@int.MinValue"> Seleccione Tipo Documento</option>
                                    @foreach (var tipo in listaTiposDocumento)
                                    {
                                        <option value="@tipo.Code">@tipo.Code - @tipo.Name  </option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => cliente.U_HBT_TipDoc)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Número Documento *</label>
                                <div class="input-group input-group-sm">

                                    <input type="text" class="form-control" @bind="cliente.FederalTaxID" @bind:event="oninput" />
                                    <span class="input-group-text bg-light">-</span>
                                    <input readonly class="form-control" value="@DigitoVerificacion" style="max-width:45px;" />
                                </div>
                                <ValidationMessage For="@(() => cliente.FederalTaxID)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <InputCheckbox @bind-Value="cliente.validFor" class="form-check-input check-rojo" id="chkActivo" />
                                    <label class="form-check-label fw-semibold text-dark small" for="chkActivo">Cliente Activo</label>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-semibold">Razón Social *</label>
                                <InputText @bind-Value="cliente.CardName" class="form-control form-control-sm" placeholder="Nombre completo o Empresa" />
                                <ValidationMessage For="@(() => cliente.CardName)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-semibold">Grupo *</label>
                                <InputSelect @bind-Value="cliente.GroupCode" class="form-select form-select-sm">
                                    <option value="@int.MinValue">Seleccione Canal de ventas</option>
                                    @foreach (var grupo in listaGrupoDeclientes)
                                    {
                                        <option value="@grupo.GroupCode">@grupo.GroupCode-@grupo.GroupName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => cliente.GroupCode)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Sucursal </label>
                                <InputText @bind-Value="cliente.CardForeignName" class="form-control form-control-sm" />
                                <ValidationMessage For="@(() => cliente.CardForeignName)" class="text-danger small" />

                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Nombres </label>
                                <InputText @bind-Value="cliente.U_HBT_Nombres" class="form-control form-control-sm" disabled="@EsPersonaJuridica()" />
                            

                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Primer Apellido </label>
                                <InputText @bind-Value="cliente.U_HBT_Apellido1" class="form-control form-control-sm" disabled="@EsPersonaJuridica()" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Segundo Apellido </label>
                                <InputText @bind-Value="cliente.U_HBT_Apellido2" class="form-control form-control-sm" disabled="@EsPersonaJuridica()" />

                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Teléfono 1 *</label>
                                <InputText @bind-Value="cliente.Phone1" class="form-control form-control-sm" />
                                <ValidationMessage For="@(() => cliente.Phone1)" class="text-danger small" />

                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Móvil</label>
                                <InputText @bind-Value="cliente.Cellular" class="form-control form-control-sm" />
                                <ValidationMessage For="@(() => cliente.Cellular)" class="text-danger small" />

                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Correo Electrónico *</label>
                                <InputText @bind-Value="cliente.EmailAddress" class="form-control form-control-sm" />
                                <ValidationMessage For="@(() => cliente.EmailAddress)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Vendedor *</label>

                                <InputSelect @bind-Value="cliente.SalesPersonCode" class="form-select form-select-sm">

                                    <option value="@int.MinValue"> Seleccione Vendedor</option>
                                    @foreach (var o in listaOslp)
                                    {
                                        <option value="@o.SlpCode">@o.SlpCode - @o.SlpName </option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => cliente.SalesPersonCode)" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Condición de Pago *</label>

                                <InputSelect @bind-Value="cliente.PayTermsGrpCode" class="form-select form-select-sm">
                                    <option> Seleccione Condición de pago</option>
                                    @foreach (var dias in listDias)
                                    {
                                        <option value="@dias.GroupNum">@dias.GroupNum-@dias.PymntGroup</option>
                                    }
                                </InputSelect>

                                <ValidationMessage For="@(() => cliente.PayTermsGrpCode)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-semibold">Lista de Precios *</label>
                                <InputSelect @bind-Value="cliente.PriceListNum" class="form-select form-select-sm">
                                    <option> Seleccione Lista de precios</option>
                                    @foreach (var opl in listOpln)
                                    {
                                        <option value="@opl.ListNum">@opl.ListNum-@opl.ListName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => cliente.PriceListNum)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4">
                            </div>
                            <div class="col-12 col-lg-6 mt-4">
                                <div class="card bg-light border-0 rounded-3 p-3 h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold text-vinotinto m-0 small"><i class="bi bi-geo-alt-fill me-1"></i> Dirección Factura</h6>
                                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" @onclick="CopiarADespacho" style="font-size: 0.75rem;">
                                            Copiar a Despacho <i class="bi bi-arrow-right-short"></i>
                                        </button>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label text-muted small fw-semibold">Código Postal *</label>
                                            <InputText class="form-control cursor-pointer" readonly @onclick="AbrirModalCodigoPostal" @bind-Value="cliente.ZipCode" />
                                            <ValidationMessage For="@(() => cliente.ZipCode)" class="text-danger small" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label text-muted xx-small mb-1">Calle / Número / Conjunto</label>
                                            <InputText @bind-Value="direccionFactura.Street" class="form-control form-control-sm" />
                                            <ValidationMessage For="@(() => direccionFactura.Street)" class="text-danger small" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label text-muted xx-small mb-1">Barrio</label>
                                            <InputText @bind-Value="direccionFactura.Block" class="form-control form-control-sm" />
                                            <ValidationMessage For="@(() => direccionFactura.Block)" class="text-danger small" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label text-muted xx-small mb-1">Departamento/Ciudad</label>
                                            <InputText @bind-Value="direccionFactura.County" class="form-control form-control-sm" />
                                            <ValidationMessage For="@(() => direccionFactura.County)" class="text-danger small" />
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label text-muted small fw-semibold">Municipio*</label>
                                            <InputText class="form-control cursor-pointer" readonly @onclick="AbrirModalMunicipio" @bind-Value="cliente.U_HBT_MunMed" />
                                            <ValidationMessage For="@(() => cliente.U_HBT_MunMed)" class="text-danger small" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 mt-4">
                                <div class="card bg-light border-0 rounded-3 p-3 h-100">
                                    <h6 class="fw-bold text-danger m-0 mb-2 small"><i class="bi bi-truck me-1"></i> Dirección Despacho</h6>
                                    <div class="row g-2">

                                        <div class="col-12">
                                            <label class="form-label text-muted xx-small mb-1">Calle / Número / Conjunto</label>
                                            <InputText @bind-Value="direccionDespacho.Street" class="form-control form-control-sm" />
                                            <ValidationMessage For="@(() => direccionDespacho.Street)" class="text-danger small" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label text-muted xx-small mb-1">Barrio</label>
                                            <InputText @bind-Value="direccionDespacho.Block" class="form-control form-control-sm" />
                                            <ValidationMessage For="@(() => direccionDespacho.Block)" class="text-danger small" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label text-muted xx-small mb-1">Departamento/Ciudad</label>
                                            <InputText @bind-Value="direccionDespacho.County" class="form-control form-control-sm" />
                                            <ValidationMessage For="@(() => direccionDespacho.County)" class="text-danger small" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label text-muted small fw-semibold">Ruta *</label>

                                            <InputSelect @bind-Value="cliente.Priority" class="form-select form-select-sm">
                                                <option> Seleccione Ruta</option>
                                                @foreach (var ruta in listObpp)
                                                {
                                                    <option value="@ruta.PrioCode"> @ruta.PrioCode-@ruta.PrioDesc</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => cliente.Priority)" class="text-danger small" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*  TAB 2: DATOS FISCALES  *@
                    <div class="tab-pane fade @(activeTab == "fiscales" ? "show active" : "")">
                        <div class="row g-4">
                            <div class="col-12 col-lg-6">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label text-muted small fw-semibold">Regimen Tributario</label>
                                        <InputSelect @bind-Value="cliente.U_HBT_RegTrib" class="form-select form-select-sm">
                                            <option> Seleccione Regimen Tributario</option>
                                            @foreach (var tribu in listaRegimeneTributario)
                                            {
                                                <option value="@tribu.code">@tribu.code - @tribu.Name</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_RegTrib)" class="text-danger small" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label text-muted small fw-semibold">Actividad Economica*</label>
                                        <InputText class="form-control cursor-pointer" readonly @onclick="AbrirModalActividadEconomica" @bind-Value="cliente.U_HBT_ActEco" />
                                        <ValidationMessage For="@(() => cliente.U_HBT_ActEco)" class="text-danger small" />
                                    </div>

                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Tipo Entidad *</label>

                                        <InputSelect @bind-Value="cliente.U_HBT_TipEnt" class="form-select form-select-sm">
                                            <option> Seleccione Tipo Entidad</option>
                                            @foreach (var entidad in listTipoEntidad)
                                            {
                                                <option value="@entidad.Code">@entidad.Code - @entidad.U_HbtTipoEntidad</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_TipEnt)" class="text-danger small" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Nacionalidad </label>
                                        <InputSelect @bind-Value="cliente.U_HBT_Nacional" class="form-select form-select-sm">
                                            <option> Seleccione Nacionalidad</option>
                                            @foreach (var nacionalidad in listNacionalidad)
                                            {
                                                <option value="@nacionalidad.Code">@nacionalidad.Code - @nacionalidad.U_hbtNacionalidad</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_Nacional)" class="text-danger small" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Régimen Fiscal *</label>
                                        <InputSelect @bind-Value="cliente.U_HBT_RegFis" class="form-select form-select-sm">
                                            <option> Seleccione Régimen</option>
                                            @foreach (var reg in listRegimenFiscal)
                                            {
                                                <option value="@reg.Code"> @reg.Code - @reg.Name</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_RegFis)" class="text-danger small" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Medios de pago</label>
                                        <InputSelect @bind-Value="cliente.U_HBT_MedPag" class="form-select form-select-sm">
                                            <option> Seleccione Medio de pago</option>
                                            @foreach (var medios in lisMediosDePago)
                                            {
                                                <option value="@medios.UHBTMedPag">@medios.UHBTMedPag-@medios.NameMediosDepago </option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_MedPag)" class="text-danger small" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Recidente</label>
                                        <InputSelect @bind-Value="cliente.U_HBT_Residente" class="form-select form-select-sm">
                                            <option> Seleccione Recidente</option>
                                            @foreach (var medios in listResidente)
                                            {
                                                <option value="@medios.U_HBT_Residente">@medios.U_HBT_Residente </option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_Residente)" class="text-danger small" />

                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Informacion Tributaria</label>
                                        <InputSelect @bind-Value="cliente.U_HBT_InfoTrib" class="form-select form-select-sm">
                                            <option> Seleccione Informacion Tributaria</option>
                                            @foreach (var medios in lisInformacionTributaria)
                                            {
                                                <option value="@medios.Code">@medios.Name </option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_InfoTrib)" class="text-danger small" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Regimen Fiscal  </label>
                                        <InputSelect @bind-Value="cliente.U_HBT_ResFis" class="form-select form-select-sm">
                                            <option> Seleccione Regimen Fiscal</option>
                                            @foreach (var medios in lisregimenfiscal1)
                                            {
                                                <option value="@medios.Code">@medios.Code - @medios.Name</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_ResFis)" class="text-danger small" />
                                    </div>

                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Regimen Fiscal 1 </label>
                                        <InputSelect @bind-Value="cliente.U_HBT_ResFis1" class="form-select form-select-sm">
                                            <option> Seleccione Regimen Fiscal 1</option>
                                            @foreach (var regimen in lisregimenfiscal1)
                                            {
                                                <option value="@regimen.Code">@regimen.Code - @regimen.Name</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => cliente.U_HBT_ResFis1)" class="text-danger small" />
                                    </div>

                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label text-muted small fw-semibold d-block mb-2">Códigos de Retención IVA/ICA Permitidos</label>
                                <div class="table-responsive border rounded-3 overflow-hidden style-scrollbar">
                                    <table class="table table-sm table-hover align-middle m-0 table-sap">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th class="text-center" style="width: 60px;">Activa</th>
                                                <th>Código</th>
                                                <th>Descripción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var retencion in listretencionDtos)
                                            {
                                                <tr>
                                                    <td class="text-center">
                                                        <input type="checkbox" class="form-check-input check-vinotinto" @bind="retencion.Activa" />
                                                    </td>
                                                    <td class="fw-semibold text-dark small">@retencion.WTCode - @retencion.WTName</td>
                                                    <td class="text-muted small">@retencion.WTName</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*   3 PROPIEDADES Y COMENTARIOS  *@
                    <div class="tab-pane fade @(activeTab == "propiedades" ? "show active" : "")">
                        <div class="row g-4">
                            <div class="col-12 col-lg-7">
                                <label class="form-label text-muted small fw-semibold d-block mb-2">Clasificación de Canales (Propiedades SAP)</label>
                                <div class="table-responsive border rounded-3 overflow-hidden style-scrollbar" style="max-height: 360px;">
                                    <table class="table table-sm table-hover align-middle m-0 table-sap">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th class="text-center" style="width: 60px;">Activa</th>
                                                <th>Descripción Propiedad</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var prop in listaPropiedades)
                                            {

                                                <tr>
                                                    <td class="text-center">

                                                        @* <input type="checkbox" class="form-check-input check-amarillo" @bind="prop.Activa" /> *@

                                                        <InputCheckbox @bind-Value="prop.Activa" class="form-check-input check-amarillo" />

                                                    </td>
                                                    <td class="text-dark small fw-medium">@prop.GroupName</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-12 col-lg-5">
