    private int CalcularDV(string nit)
    {
        nit = new string(nit.Where(char.IsDigit).ToArray());

        if (string.IsNullOrEmpty(nit))
            return 0;

        int[] pesos = { 3, 7, 13, 17, 19, 23, 29, 37, 41, 43, 47, 53, 59, 67, 71 };

        int suma = 0;

        for (int i = 0; i < nit.Length; i++)
        {
            suma += (nit[nit.Length - 1 - i] - '0') * pesos[i];
        }

        int residuo = suma % 11;

        return residuo <= 1 ? residuo : 11 - residuo;
    }

