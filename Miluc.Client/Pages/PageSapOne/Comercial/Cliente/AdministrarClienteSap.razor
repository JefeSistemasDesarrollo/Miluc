@page "/administrar-cliente/sap"
@using Miluc.Client.Interfaces.SapInterfaces.Cliente
@using Miluc.Shared.DTOs.Sap.Cliente
@using System.Text.Json

@inject IAuthClientService _authService
@inject IAuthClientService _authClienteService
@inject ISapOcrdClientService _sapClienteService
@inject ILogClientService _logClienteService
@inject IJSRuntime _jsrumtine
@inject NavigationManager _nav
<div class="cliente-page animate__animated animate__fadeIn p-4">

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">

        
        <div>
            <h2 class="fw-bold text-negro m-0 ">
                <i class="bi bi-person-badge-fill me-2"> Gestionar Clientes</i>
            </h2>
            <p class="m-0 text-muted">Administrcion de Clientes Sap One</p>
        </div>

        <div class="col-md-6 col-12 text-md-end text-start mt-3 mt-md-0">
            <button type="button" class="btn btn-outline-secondary btn-nuevo rounded-pill px-4 shadow-sm me-2" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i>Volver
            </button>
            @if (_authClienteService.HasPermission("Cliente.Create"))
            {
                <button type="button" class="btn btn-rojo btn-nuevo rounded-pill px-4 shadow-sm" @onclick="IrACrear">
                    <i class="bi bi-plus-lg me-1"></i>Nuevo
                </button>
            }

          
        </div>
        @* } *@
    </div>
    @* --- BARRA DE BÚSQUEDA --- *@
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-lg-7">
                    @if (_authClienteService.HasPermission("Cliente.View"))
                    {
                        <div class="input-group input-group-lg search-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            @* para actualizar en tiempo real cada vez que precione una tecla
                                no HACERLO contenteditable EL ONCHAGE *@
                            <input type="text" class="form-control border-start-0 shadow-none fs-6"
                                   placeholder="Filtrar local o buscar en servidor..."
                                   @bind="textoBusqueda" @bind:event="oninput" @onkeyup="HandleEnter" />
                            <button class="btn btn-rojo rounded-end-pill px-4" @onclick="BuscarEnServidor">
                                <i class="bi bi-search me-2"></i>
                            </button>
                        </div>
                    }

                </div>

                <div class="col-lg-5 text-lg-end">
                    <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border ">
                        <label class="mx-3 small fw-bold text-muted text-uppercase">Mostrar</label>
                        <select class="form-select form-select-sm rounded-pill border-0 bg-transparent fw-bold"
                                style="width: 80px;"
                                value="@cantidadPorPagina"
                                @onchange="CambiarCantidadPagina">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </div>

                </div>

            </div>
        </div>
    </div>

    @* tabla  *@
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

        <div class="table-responsive">
            <table class=" table table-striped table table-hover mb-0">
                <thead class="bg-vinotinto text-rojo">
                    <tr>
                        <th class="ps-4 py-3">Codigo</th>
                        <th class="text-center">Nombre</th>
                        <th class="text-center">Nit</th>
                        <th class="text-lg-center">Sucursal</th>
                        <th class="text-center">Grupo o canal </th>
                        <th class="text-center">Saldo de cuenta</th>
                        <th class="text-center">Contacto</th>
                        <th class="text-center">Condicion de pago</th>
                        <th class="text-center">Vendedor</th>
                        <th class="text-center">Dirección</th>
                        <th class="text-center pe-4">Estado</th>
                        <th class="text-center pe-4">Acciones</th>

                    </tr>
                </thead>
                <tbody class="bg-white">
                    @* Aquí se iteraría sobre la lista de usuarios *@
                    @* Ejemplo de fila de usuario *@
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-border text-vinotinto"></div>
                            </td>
                        </tr>
                    }
                    else if (!ListClientApi.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                No se encontraron clientes
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cliente in ListClientApi)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">

                                        <div class="ms-3">
                                            <div class="fw-bold text-dark small mb-0"> @cliente.CardCode</div>

                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@cliente.CardName</span>
                                </td>
                                <td>
                                    <div class="text-muted x-small">@cliente.LicTradNum</div>
                                </td>
                                <td>
                                    <div class="text-muted x-small">@cliente.CardFName</div>
                                </td>
                                <td>
                                    <div class="text-muted x-small">@cliente.GroupName</div>
                                </td>

                                <td>
                                    <div class="text-muted x-small">@cliente.Balance</div>
                                </td>
                                <td>
                                    <div class="text-muted x-small">@cliente.Phone1 - @cliente.Phone2</div>
                                </td>
                                <td>
                                    <div class="text-muted x-small">@cliente.ListName</div>
                                </td>
                                <td>
                                    <div class="text-muted x-small">@cliente.SlpName</div>
                                </td>
                                <td>
                                    <div class="text-muted x-small">@cliente.Address</div>
                                </td>

                                <td class="text-center">
                                    @if (cliente.validFor == 'Y')
                                    {
                                        <span class="badge btn-amarillo px-3 py-2 rounded-pill">
                                            <i class="bi bi-check2-circle text-negro"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge btn-amarillo px-3 py-2 rounded-pill">
                                            <i class="bi bi-x-circle text-rojo"></i>
                                        </span>
                                    }
                                </td>

                                @*VER EL DETALLE *@
                                <td class="text-center pe-4">
                                    @* Botonera de acciones CRUD para cada registro individual *@
                                    <div class="btn-group shadow-sm border rounded-pill bg-white overflow-hidden">

                                        @if (_authClienteService.HasPermission("Cliente.Detail"))
                                        {
                                            @* Botón para ir al detalle del empleado *@
                                            <button class="btn-detail btn btn-sm px-2 border-end" title="Ver Detalle" @onclick="() => VerDetalleCliente(cliente.CardCode)">
                                                <i class="bi bi-eye text-secondary"></i>
                                            </button>
                                        }
                                        @if (_authClienteService.HasPermission("Cliente.Update"))
                                        {
                                            @* Botón para navegar al formulario de edición *@
                                            <button class="btn  btn-sm px-2 border-end edit" title="Editar Usuario" @onclick="() => EditarCliente(cliente.CardCode)">
                                                <i class="bi bi-pencil-square text-primary"></i>
                                            </button>
                                        }

                                        @if (_authClienteService.HasPermission("Cliente.Delete"))
                                        {
                                            @* Botón para accionar el flujo de eliminación *@
                                            <button class="btn btn-sm px-2 delete" title="Eliminar" @onclick="() => EliminarCliente(cliente.CardCode)">
                                                <i class="bi bi-trash3 text-danger"></i>
                                            </button>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>



    @* paginador  *@
    <div class="pagination-footer d-flex justify-content-between align-items-center mt-4">
        <div class=" page-link text-muted small">Página <b>@paginaActual</b> de @totalPaginas</div>
        <div class="page-item.active pagination-container p-1 bg-white border rounded-pill shadow-sm">
            <button class="btn btn-sm rounded-circle text-rojo @(paginaActual <= 1 ? "disabled" : "")" @onclick="() => IrPagina(paginaActual - 1)"><i class="bi bi-chevron-left"></i></button>
            <span class="mx-3 fw-bold text-rojo">@paginaActual</span>
            <button class="btn btn-sm rounded-circle text-rojo @(paginaActual >= totalPaginas ? "disabled" : "")" @onclick="() => IrPagina(paginaActual + 1)"><i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
</div>
@code {

    private List<SapClienteReaderDto> ListClientOriginal = new();
    private List<SapClienteReaderDto> ListClientApi = new();
    private bool cargando = false;
    private int totalRegistros = 0;
    private string _textoBusqueda = "";
    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            FiltrarLocal();
        }
    }
    //para que funcione para las dos busquedas tanto local como en servidor

    private int totalPaginas
    {
        get
        {
            var total = string.IsNullOrWhiteSpace(_textoBusqueda) ? totalRegistros : ListClientApi.Count;

            return (int)Math.Ceiling((double)total / cantidadPorPagina);
        }
    }
    private void FiltrarLocal()
    {

        if (ListClientOriginal == null || !ListClientOriginal.Any())
        {
            ListClientApi = new List<SapClienteReaderDto>();
            return;
        }

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            ListClientApi = ListClientOriginal.ToList();
            return;

        }
        else
        {
            ListClientApi = ListClientOriginal
                .Where(u => (u.CardCode?.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) || (u.CardName?.Contains(_textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }
    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (_authClienteService.HasPermission("Cliente.View"))
        {
            if (e.Key == "Enter")
            {
                paginaActual = 1;
                await BuscarEnServidor();
            }
        }
        else
        {
            await _jsrumtine.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Acceso denegado",
                text = "No tienes permiso para ver los clientes.",
                confirmButtonColor = "#6c1d1d"
            });
            return;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            int CodigoVendedor = 0;

            if (_authClienteService.CurrentSession != null)
            {
                CodigoVendedor = _authClienteService.CurrentSession.CodVendedorSAP ?? -1;
            }
            await CargarClientesSap();
        }
        catch (Exception ex)
        {
            await _logClienteService.GuardarErrorAsync(
                                   ex.Message,
                                   ex.StackTrace,
                                  usuario: _authClienteService.CurrentSession.UserName ?? "No encontrado",
                                 metodo: nameof(OnInitializedAsync),
                                   ruta: nameof(AdministrarClienteSap),
                                   origen: $"Blazor Clientes Sap ",
                                   nivel: "error");
        }
    }
    private async Task BuscarEnServidor()
    {
        if (_authClienteService.HasPermission("Cliente.View"))
        {
            paginaActual = 1;
            cargando = true;

            int CodigoVendedor = 0;

            if (_authClienteService.CurrentSession != null)
            {
                CodigoVendedor = _authClienteService.CurrentSession.CodVendedorSAP ?? -1;
            }

            var response = await _sapClienteService.GetallClienteAsync(_textoBusqueda, paginaActual, cantidadPorPagina, CodigoVendedor);

            if (response.Valor != null)
            {
                ListClientOriginal = response.Valor;
                ListClientApi = ListClientOriginal.ToList();
                totalRegistros = response.CantRegistros;
            }
            else
            {
                ListClientApi = new List<SapClienteReaderDto>();
                string errores = response.Errores != null && response.Errores.Any()
               ? string.Join("<br>", response.Errores)
               : "Ocurrió un error inesperado.";

                await _jsrumtine.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = $"Error al consultar usuarios {response.Mensaje} ",
                    text = $"{errores}",
                    confirmButtonColor = "#6c1d1d"
                });
            }
            cargando = false;
        }
        else
        {
            await _jsrumtine.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Acceso denegado",
                text = "No tienes permiso para ver los clientes.",
                confirmButtonColor = "#6c1d1d"
            });
            return;
        }


    }
    private async Task CargarClientesSap()
    {
        try
        {
            if (!_authClienteService.HasPermission("Cliente.View"))
            {
                await _jsrumtine.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = "Acceso denegado",
                    text = "No tienes permiso para visualizar los clientes.",
                    confirmButtonColor = "#6c1d1d"
                });
                return;
            }

            int CodigoVendedor = 0;

            if (_authClienteService.CurrentSession != null)
            {
                CodigoVendedor = _authClienteService.CurrentSession.CodVendedorSAP ?? -1;
            }

            cargando = true;
            var response = await _sapClienteService.GetallClienteAsync(textoBusqueda, paginaActual, cantidadPorPagina, CodigoVendedor);
            if (response != null)
            {
                ListClientOriginal = response.Valor;
                ListClientApi = ListClientOriginal.ToList();
                totalRegistros = response.CantRegistros;
            }
            cargando = false;
        }
        catch (Exception ex)
        {
            cargando = false;
            await _logClienteService.GuardarErrorAsync(
                                   ex.Message,
                                   ex.StackTrace,
                                  usuario: _authClienteService.CurrentSession.UserName ?? "No encontrado",
                                 metodo: nameof(CargarClientesSap),
                                   ruta: nameof(AdministrarClienteSap),
                                   origen: $"Blazor Clientes Sap ",
                                   nivel: "error");


            await _jsrumtine.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Error al cargar usuarios",
                text = ex.Message
            });

        }

    }
    private int cantidadPorPagina = 10;
    private int paginaActual = 1;
    private async Task IrPagina(int nuevaPagina)
    {
        if (_authClienteService.HasPermission("Cliente.View") == false)
        {
            await _jsrumtine.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Acceso denegado",
                text = "No tienes permiso para ver los clientes.",
                confirmButtonColor = "#6c1d1d"
            });
            return;
        }
        ;

        if (nuevaPagina < 1)
            return;

        paginaActual = nuevaPagina;
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await CargarClientesSap();
        else
            await BuscarEnServidor();

    }

    private async Task CambiarCantidadPagina(ChangeEventArgs e)
    {
        cantidadPorPagina = int.Parse(e.Value!.ToString()!);
        paginaActual = 1;
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
            await CargarClientesSap();
        else
            await BuscarEnServidor();
    }
    private void IrACrear()
    {
        if (!_authClienteService.HasPermission("Cliente.Create"))
        {
            _jsrumtine.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Acceso denegado",
                text = "No tienes permiso para crear clientes.",
                confirmButtonColor = "#6c1d1d"
            });
            return;
        }

        _nav.NavigateTo("/administrar-cliente/crear-socio");
    }
    private void Volver() => _nav.NavigateTo("/administrar-modulo-comercial");


    private void VerDetalleCliente(string CardCode)
    {
        if (!_authClienteService.HasPermission("Cliente.Detail"))
        {
            _jsrumtine.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Acceso denegado",
                text = "No tienes permiso para ver el detalle del cliente.",
                confirmButtonColor = "#6c1d1d"
            });
            return;
        }
        _nav.NavigateTo($"/Administrar-cliente/Sap/Detalle/{CardCode}");
    }
    private void EditarCliente(string CardCode)
    {
        if (!_authClienteService.HasPermission("Cliente.Update"))
        {
            _jsrumtine.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Acceso denegado",
                text = "No tienes permiso para editar el cliente.",
                confirmButtonColor = "#6c1d1d"
            });
            return;
        }

        _nav.NavigateTo($"/Administrar-cliente/Sap/Editar/{CardCode}");

    }

    private async Task EliminarCliente(string CardCode)
    {
        try
        {

            if (!_authClienteService.HasPermission("Cliente.Delete"))
            {
                await _jsrumtine.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = "Acceso denegado",
                    text = "No tienes permiso para eliminar el cliente.",
                    confirmButtonColor = "#6c1d1d"
                });
                return;
            }

            var result = await _jsrumtine.InvokeAsync<JsonElement>
                        ("Swal.fire", new
                        {
                            title = "¿Estás seguro?",
                            text = $"¿Deseas Cancelar el cliente?",
                            icon = "info",
                            showCancelButton = true,
                            confirmButtonColor = "#D0CFCA",
                            cancelButtonColor = "#D62F46",
                            confirmButtonText = "Eliminar",
                            cancelButtonText = "NO"
                        });
            if (result.GetProperty("isConfirmed").GetBoolean())
            {
                await _jsrumtine.InvokeVoidAsync("mostrarEspera", "Sincronizando - SAP ONE", "Eliminando Cliente ...<br><br><b>No cierre esta ventana.</b>", "info");
                var resultado = await _sapClienteService.EliminarClienteAsync(CardCode);

                if (resultado.EsCorrecto)
                {
                    await _jsrumtine.InvokeVoidAsync("cerrarEspera");

                    await _jsrumtine.InvokeVoidAsync("Swal.fire", new
                    {
                        icon = "success",
                        title = "El cliente se elimino con exito",
                        text = resultado.Mensaje,

                        confirmButtonColor = "#6c1d1d"
                    });

                }
                else
                {
                    await _jsrumtine.InvokeVoidAsync("cerrarEspera");
                    string mensaje = string.Join(",", resultado.Errores);
                    await _jsrumtine.InvokeVoidAsync("Swal.fire", "Error", $"No se pudo eliminar el cliente. {mensaje}", $"error{resultado.Mensaje}");
                    //   await _jsrumtine.InvokeVoidAsync($"Swal.fire", "Error", $"No se pudo eliminar el pedido{resultado.Errores}", "error");
                }
            }

        }
        catch (Exception ex)
        {
            await _jsrumtine.InvokeVoidAsync("cerrarEspera");

            await _logClienteService.GuardarErrorAsync(
                                   ex.Message,
                                   ex.StackTrace,
                                  usuario: _authClienteService.CurrentSession.UserName ?? "No encontrado",
                                 metodo: nameof(EliminarCliente),
                                   ruta: nameof(AdministrarClienteSap),
                                   origen: $"Blazor Clientes Sap ",
                                   nivel: "error");
        }


    }
}
