@page "/FacturasVentas-ventas"
@using Miluc.Client.Interfaces.SapInterfaces.Informes
@using Miluc.Client.Interfaces.SapInterfaces.Oslp
@using Miluc.Shared.DTOs.Sap.Vendedor

@inject ISapVentasClientService _facturasVentasService
@inject ISapOslpService _oslpService
@inject IAuthClientService _auth
@inject ILogClientService _logErrores
@inject NavigationManager _nav;
@inject IJSRuntime _js

<div class="FacturasVentas-container container-fluid py-4 px-3 px-md-4">

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="d-flex justify-content-between align-items-center">
                <label class="form-label text-muted small fw-semibold mb-0">
                    Tipo de Informe
                </label>
            </div>
            <select class="form-select form-select-sm mt-2"
                    @bind="tipoInformeSeleccionado">
                <option value='1'>FacturasVentas de Ventas por cabecera</option>
                <option value='2'>Detalle por Fechas Detalle</option>
                <option value='3'>Historico FacturasVentas de Ventas por cabecera</option>
                <option value='4'>Historico Detalle por Fechas Detalle</option>

            </select>
        </div>
    </div>
    <!-- Encabezado -->
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom border-red-subtle">
        <div class="icon-badge me-3">
            <i class="bi bi-bar-chart-line-fill"></i>
        </div>
        <div>
            @if (tipoInformeSeleccionado == 1)
            {
                <h3 class="title-brand m-0">FacturasVentas de Ventas por cabecera y fecha </h3>
                <p class="subtitle-brand m-0">Generación de informes de SAP Business One</p>
            }
            @if (tipoInformeSeleccionado == 2)
            {
                <h3 class="title-brand m-0">Detalle por Fechas Detalle y fecha </h3>
                <p class="subtitle-brand m-0">Generación de informes de SAP Business One</p>
            }
            @if (tipoInformeSeleccionado == 3)
            {
                <h3 class="title-brand m-0">Historico FacturasVentas de Ventas por cabecera</h3>
                <p class="subtitle-brand m-0">Generación de informes de SAP Business One</p>
            }
            @if (tipoInformeSeleccionado == 4)
            {
                <h3 class="title-brand m-0">Historico Detalle por Fechas Detalle</h3>
                <p class="subtitle-brand m-0">Generación de informes de SAP Business One</p>
            }
        </div>
    </div>

    <!-- Formulario / Card Principal -->
    <div class="card card-brand shadow-sm">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-end">

                <!-- Fecha Inicial -->
                @if (tipoInformeSeleccionado == 1 || tipoInformeSeleccionado == 2)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label font-weight-bold">
                            <i class="bi bi-calendar-event me-1 text-red"></i> Fecha inicial
                        </label>
                        <InputDate @bind-Value="fechaInicioFacturasVentas" class="form-control input-brand" />
                    </div>

                    <!-- Fecha Final -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label font-weight-bold">
                            <i class="bi bi-calendar-check me-1 text-red"></i> Fecha final
                        </label>
                        <InputDate @bind-Value="fechaFinalFacturasVentas" class="form-control input-brand" />
                    </div>
                }

                <!-- Código de Vendedor -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label text-muted small fw-semibold">Grupo *</label>


                    <InputSelect @bind-Value="vendedorSeleccionadoFacturasVentas" class="form-select form-select-sm">
                        @* <option value="@int.MinValue">Seleccione un vendedor</option> *@
                        @foreach (var slp in listSapVendedorReaderDtos)
                        {
                            <option value="@slp.SlpCode">@slp.SlpName</option>
                        }
                    </InputSelect>
                </div>

                <!-- Botón de Acción -->
                <div class="col-12 col-sm-6 col-lg-3">
                    @if (tipoInformeSeleccionado == 1 || tipoInformeSeleccionado == 2)
                    {
                        <button class="btn btn-red w-100 d-flex align-items-center justify-content-center"
                                @onclick="DescargarExcelFacturasVentas"
                                disabled="@cargandoFacturasVentas">
                            @if (cargandoFacturasVentas)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Generando...</span>
                            }
                            else
                            {
                                <i class="bi bi-file-earmark-excel-fill me-2"></i>
                                <span>Descargar Excel</span>
                            }
                        </button>
                    }
                     @if (tipoInformeSeleccionado == 3 || tipoInformeSeleccionado == 4)
                    {
                        <button class="btn btn-red w-100 d-flex align-items-center justify-content-center"
                                @onclick="DescargarExcelFacturasVentas"
                                disabled="@cargandoFacturasVentas">
                            @if (cargandoFacturasVentas)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Generando...</span>
                            }
                            else
                            {
                                <i class="bi bi-file-earmark-excel-fill me-2"></i>
                                <span>Descargar Excel Histórico</span>
                            }
                        </button>
                    }
                    
                </div>

            </div>
        </div>
    </div>
    <!-- Alertas y Mensajes -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-red-custom mt-4 d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
            <div>@mensaje</div>
        </div>
    }
</div>


@code {
    private DateTime fechaInicioFacturasVentas = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime fechaFinalFacturasVentas = DateTime.Now;

    // private int slpCode = -1;
    private bool cargandoFacturasVentas;

    private string? mensaje;
    public int vendedorSeleccionadoFacturasVentas { get; set; }

    private int tipoInformeSeleccionado = 1; // 1: FacturasVentas de Ventas, 2: Detalle por Fechas


    private List<SapVendedorReaderDto> listSapVendedorReaderDtos = new List<SapVendedorReaderDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {

            if (_auth.HasPermission("Informe.FacturasVentas"))
            {
                vendedorSeleccionadoFacturasVentas = Convert.ToInt32(_auth.CurrentSession.CodVendedorSAP);
                var listaVendedores = await _oslpService.GetListVendedoresAsync();

                if (listaVendedores.Valor != null)
                {
                    listSapVendedorReaderDtos = listaVendedores.Valor;
                    if (vendedorSeleccionadoFacturasVentas > 0)
                    {
                        listSapVendedorReaderDtos = listaVendedores.Valor.Where(v => v.SlpCode == vendedorSeleccionadoFacturasVentas).ToList();
                    }
                }
            }
            else
            {
                _nav.NavigateTo("/no-autorizado");
                return;
            }

        }
        catch (Exception ex)
        {
            await _logErrores.GuardarErrorAsync
          (
              ex.Message,
              ex.StackTrace,
              usuario: _auth.CurrentSession.UserName ?? "No encontrado",
              metodo: nameof(OnInitializedAsync),
              ruta: "/FacturasVentas-ventas",
              origen: $"FacturasVentas de ventas icializar vendedor {ex.HelpLink}",
              nivel: "error"

          );
            await _js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Error al cargar usuarios",
                text = ex.Message
            });
        }
    }

    private async Task DescargarExcelFacturasVentas()
    {
        try
        {
            cargandoFacturasVentas = true;
            mensaje = null;

            if (tipoInformeSeleccionado == 3 || tipoInformeSeleccionado == 4)
            {
                fechaInicioFacturasVentas = new DateTime(2023, 1, 1);
                fechaFinalFacturasVentas = DateTime.Now;
            }

            if (fechaInicioFacturasVentas > fechaFinalFacturasVentas)
            {
                mensaje = "La fecha inicial no puede ser mayor que la fecha final.";
                return;
            }
                var resultado = await _facturasVentasService.DescargarFacturasVentasService(
                    fechaInicioFacturasVentas,
                    fechaFinalFacturasVentas,
                    vendedorSeleccionadoFacturasVentas,
                    tipoInformeSeleccionado);
                
                if (!resultado)
                {
                    mensaje = "No fue posible generar el archivo Excel o no existen registros con los filtros seleccionados.";
                }  
        }
        catch (Exception ex)
        {
            mensaje = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            cargandoFacturasVentas = false;
        }
    }
}