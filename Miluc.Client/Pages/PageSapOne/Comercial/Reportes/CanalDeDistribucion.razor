@page "/canal-de-distribucion"
@using Miluc.Client.Interfaces.SapInterfaces.Cliente
@using Miluc.Client.Interfaces.SapInterfaces.Informes
@using Miluc.Client.Interfaces.SapInterfaces.Oslp
@using Miluc.Shared.DTOs.Sap.GrupoDeVenta
@using Miluc.Shared.DTOs.Sap.Vendedor

@inject ISapVentasClientService _facturasVentasService
@inject ISapOslpService _oslpService
@inject IAuthClientService _authclienteService
@inject ILogClientService _logErrores
@inject NavigationManager _nav;
@inject ISapOcrdClientService _ocrdService
@inject IJSRuntime _js

<div class="frecuencia-container container-fluid py-4 px-3 px-md-4">
    <!-- Encabezado -->
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom border-red-subtle">
        <div class="icon-badge me-3">
            <i class="bi bi-bar-chart-line-fill"></i>
        </div>
        <div>
            <h3 class="title-brand m-0">Canal de Distribución</h3>
            <p class="subtitle-brand m-0">Generación de informes de Canal de Distribución</p>
        </div>
    </div>
    <!-- Formulario / Card Principal -->
    <div class="card card-brand shadow-sm">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-end">

                <!-- Fecha Inicial -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label font-weight-bold">
                        <i class="bi bi-calendar-event me-1 text-red"></i> Fecha inicial
                    </label>
                    <InputDate @bind-Value="fechaInicio" class="form-control input-brand" />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label font-weight-bold">
                        <i class="bi bi-calendar-event me-1 text-red"></i> Fecha final
                    </label>
                    <InputDate @bind-Value="fechaFinal" class="form-control input-brand" />
                </div>

                <!-- Fecha Final -->
                <!-- Código de Vendedor -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label text-muted small fw-semibold">Canal *</label>
                    <InputSelect @bind-Value="canal" class="form-select form-select-sm">
                @*         <option selected value="0">Seleccione el canal </option> *@
                        @* <option value="@int.MinValue">Seleccione un vendedor</option> *@
                        @foreach (var canal in partnerGroupsDtos)
                        {
                            <option value="@canal.GroupCode">@canal.GroupName</option>
                        }
                    </InputSelect>
                </div>

                <!-- Botón de Acción -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <button class="btn btn-red w-100 d-flex align-items-center justify-content-center"
                            @onclick="DescargarExcel"
                            disabled="@cargando">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Generando...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel-fill me-2"></i>
                            <span>Descargar Excel</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Alertas y Mensajes -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-red-custom mt-4 d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
            <div>@mensaje</div>
        </div>
    }
</div>


@code {
    private DateTime fechaInicio = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime fechaFinal = DateTime.Now;


    //private DateTime fechaFinal = DateTime.Now;
    // private int codigoVendedor = 0;
    private int canal = 0;
    private bool cargando;
    private string? mensaje;

    private string codigoCliente = string.Empty;
    private List<SapVendedorReaderDto> listSapVendedorReaderDtos = new List<SapVendedorReaderDto>();
    private List<BusinessPartnerGroupsDto> partnerGroupsDtos = new List<BusinessPartnerGroupsDto>();

    //  List<DiasCreditoDto>>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (_authclienteService.HasPermission("Informe.FacturasVentas"))
            {
               
                var listaGruposDeVenta = await _ocrdService.GetGrupoDeVentasAsync();
                if (listaGruposDeVenta.Valor != null)
                {
                    partnerGroupsDtos = listaGruposDeVenta.Valor;
                }
            }
            else
            {
                _nav.NavigateTo("/no-autorizado");
                return;
            }          
        }
        catch (Exception ex)
        {
            await _logErrores.GuardarErrorAsync
          (
              ex.Message,
              ex.StackTrace,
              usuario: _authclienteService.CurrentSession.UserName ?? "No encontrado",
              metodo: nameof(OnInitializedAsync),
              ruta: "/facturas-ventas",
              origen: $"facturas de ventas icializar vendedor {ex.HelpLink}",
              nivel: "error"

          );
            await _js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Error al cargar usuarios",
                text = ex.Message
            });
        }
    }

    private async Task DescargarExcel()
    {
        try
        {
            cargando = true;
            mensaje = null;


            var resultado = await _facturasVentasService.CanalDeDistribucionAsync(fechaInicio, fechaFinal, canal);
            if (resultado)
            {
                mensaje = "Archivo Excel generado correctamente.";
            }
            else
            {
                mensaje = "No fue posible generar el archivo Excel o no existen registros con los filtros seleccionados.";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }
}