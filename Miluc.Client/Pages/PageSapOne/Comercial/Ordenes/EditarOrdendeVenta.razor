    private async Task BuscarEnServidorArticulo()
    {
        try
        {
            Cargando = true;

            var response = await _sapOitmClientService.GetListOitmAsync(textoBusquedaArticulo.Trim(), paginaActualArticulo, CantidadRegistrosPorPaginaArticulo);

            listaArticulosApi = response?.Valor ?? new();

            CantidadDeArticulosEncontrados = response?.CantRegistros ?? 0;

        }
        catch (Exception ex)
        {
            await _logClientService.GuardarErrorAsync(ex.Message, ex.StackTrace, nivel: "error", metodo: "BuscarEnServidor");

        }
        finally
        {
            Cargando = false;
            StateHasChanged();
        }
    }
    private async Task SeleccionarArticulo(SapOitmDto item)
    {
        // 1. Validación inicial: Sin cliente no hay precios.
        if (string.IsNullOrEmpty(clienteSeleccionado?.CardCode))
        {
            await _jsRuntime.InvokeVoidAsync("Swal.fire", "Error.", "Seleccione un cliente antes de agregar artículos", "error");
            return;
        }
        try
        {
            // Usamos item.ItemCode del objeto seleccionado en el modal, NO el texto de búsqueda.
            var responseArticulo = await _sapOitmClientService.GetOitmCarcodeItemcodeAsync(clienteSeleccionado.CardCode, item.ItemCode, 1);

            if (responseArticulo?.Valor != null)
            {
                var artData = responseArticulo.Valor;

                //  Validación de Precio
                if (artData.PriceAsignado == 0 || artData.PriceAsignado == null)
                {
                    await _jsRuntime.InvokeVoidAsync("Swal.fire", "Error", $"El artículo {artData.ItemCode} no tiene precio asignado para este cliente.", "error");
                    return;
                }
                // 4Lógica de Agregado o Actualización
                var existente = lineasPedido.FirstOrDefault(x => x.ItemCode == artData.ItemCode);

                if (existente != null)
                {
                    // Si ya existe, solo aumentamos la cantidad y recalculamos
                    existente.Quantity++;
                    CalcularTotales(existente);
                }
                else
                {
                    // Si es nuevo, inicializamos cantidad y calculamos antes de añadir
                    artData.Quantity = 1;
                    if (artData.SWeight1 > 0)
                    {
                        //calcular el equivalente en kg y unidades dependiendo de la unidad de medida de compra, teniendo en cuenta el peso del artículo
                        if (!string.IsNullOrEmpty(artData.BuyUnitMsr))
                        {
                            if (artData.BuyUnitMsr.ToUpper() == "KG")
                            {
                                artData.U_CantidadKg = artData.Quantity;
                                decimal pesoUnidades = Math.Round(Convert.ToDecimal(artData.U_CantidadKg / artData.SWeight1), 2);
                                artData.U_UnidadSal = (int)Math.Round(pesoUnidades, MidpointRounding.AwayFromZero);
                            }
                            else
                            {
                                artData.U_UnidadSal = artData.Quantity;
                                artData.U_CantidadKg = Math.Round(Convert.ToDecimal(artData.U_UnidadSal * artData.SWeight1), 2);
                            }
                        }
                    }
                    CalcularTotales(artData);
                    lineasPedido.Add(new ArticuloPorListaDePreciosDto
                    {
                        ItemCode = artData.ItemCode,
                        ItemName = artData.ItemName,
                        BuyUnitMsr = artData.BuyUnitMsr,
                        SWeight1 = Math.Round(Convert.ToDecimal(artData.SWeight1), 2),
                        PriceAcobrar = Math.Round(Convert.ToDecimal(artData.PriceAcobrar), 2),
                        // PriceAcobrar = Math.Round(Convert.ToDecimal(artData.PriceAcobrar), 2),
                        PriceAsignado = Math.Round(Convert.ToDecimal(artData.PriceAsignado), 2),
                        //    SWeight1 = Math.Round(d.OITM.SWeight1, 2),
                        PriceEspecial = Math.Round(Convert.ToDecimal(artData.PriceEspecial), 2),
                        Quantity = artData.Quantity,
                        BaseSum = Math.Round(Convert.ToDecimal(artData.BaseSum), 2),
                        Rate = Math.Round(Convert.ToDecimal(artData.Rate), 2),
                        TaxCode = artData.TaxCode,
                        // U_EquivalentedKg = Math.Round(Convert.ToDecimal(artData.U_EquivalentedKg), 2),
                        // U_EquivalenteUni = Math.Round(Convert.ToDecimal(artData.U_EquivalenteUni), 2),
                        TotalImpuesto = Math.Round(Convert.ToDecimal(artData.TotalImpuesto), 2)
                    });
                }
            }
        }
        catch (Exception ex)
        {
            await _logClientService.GuardarErrorAsync(ex.Message, ex.StackTrace, "error", "SeleccionarArticulo");
        }
        finally
        {
            CerrarModalArticulo();
            StateHasChanged();
        }
    }

