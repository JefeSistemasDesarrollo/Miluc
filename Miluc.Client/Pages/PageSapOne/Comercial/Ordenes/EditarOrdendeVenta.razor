        new OrigenPedidoDto{OrigenPedidoId=6,OrigenNombre="Tienda - pag"},
        new OrigenPedidoDto{OrigenPedidoId=7,OrigenNombre="Referidos"}
    };

        listVendedores = (await _sapOslpVendedorService.GetListVendedoresAsync()).Valor ?? new List<SapVendedorReaderDto>();

        listaArticulosApi = (await _sapOitmClientService.GetListOitmAsync("P", paginaActualArticulo, CantidadRegistrosPorPaginaArticulo)).Valor ?? new List<SapOitmDto>();

