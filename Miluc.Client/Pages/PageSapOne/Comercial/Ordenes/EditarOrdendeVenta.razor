    private void OnCantidadChanged(decimal? value, ArticuloPorListaDePreciosDto linea)
    {
        linea.Quantity = value ?? 0;

        if (linea.SWeight1 <= 0)
        {
            CalcularTotales(linea);
            return;
        }

        if (linea.BuyUnitMsr?.ToUpper() == "KG")
        {
            // Cantidad está en Kg
            linea.U_CantidadKg = linea.Quantity;

            linea.U_UnidadSal = Math.Round(Convert.ToDecimal(linea.Quantity) / Convert.ToDecimal(linea.SWeight1), 0, MidpointRounding.AwayFromZero);
        }
        else
        {
            // Cantidad está en Unidades
            linea.U_UnidadSal = linea.Quantity;

            linea.U_CantidadKg = Math.Round(Convert.ToDecimal(linea.Quantity) * Convert.ToDecimal(linea.SWeight1), 2);
        }

        CalcularTotales(linea);
    }

    private void OnKgChanged(decimal? value, ArticuloPorListaDePreciosDto linea)
    {
        linea.U_CantidadKg = value ?? 0;

        if (linea.SWeight1 <= 0)
        {
            CalcularTotales(linea);
            return;
        }

        linea.U_UnidadSal = Math.Round(
        Convert.ToDecimal(linea.U_CantidadKg) / Convert.ToDecimal(linea.SWeight1),
        0,
        MidpointRounding.AwayFromZero);

        // Como el artículo es por unidades,
        // Quantity siempre representa unidades.
        linea.Quantity = linea.U_UnidadSal;

        CalcularTotales(linea);
    }
    private void OnUnidadesChanged(decimal? value, ArticuloPorListaDePreciosDto linea)
    {
        linea.U_UnidadSal = Math.Round(value ?? 0, 0);

        if (linea.SWeight1 <= 0)
        {
            CalcularTotales(linea);
            return;
        }

        linea.U_CantidadKg = Math.Round(Convert.ToDecimal(linea.U_UnidadSal) * Convert.ToDecimal(linea.SWeight1), 2);

        // Como el artículo es por Kg,
        // Quantity siempre representa Kg.
        linea.Quantity = linea.U_CantidadKg;

        CalcularTotales(linea);
    }
    private void CalcularTotales(ArticuloPorListaDePreciosDto linea)
    {
        linea.BaseSum = Math.Round((linea.Quantity ?? 0) * (linea.PriceAcobrar ?? 0), 2);

        linea.TotalImpuesto = Math.Round((linea.BaseSum * linea.Rate) / 100, 2);
    }
    private void RecalcularLinea(ArticuloPorListaDePreciosDto linea)
    {
        if (linea.SWeight1 <= 0)
        {
            CalcularTotales(linea);
            return;
        }

        if (linea.BuyUnitMsr?.ToUpper() == "KG")
        {
            linea.U_CantidadKg = linea.Quantity;

            linea.U_UnidadSal = Math.Round((Convert.ToDecimal(linea.Quantity)) / Convert.ToDecimal(linea.SWeight1),
            0, MidpointRounding.AwayFromZero);
        }
        else
        {
            linea.U_UnidadSal = linea.Quantity;

            linea.U_CantidadKg = Math.Round((Convert.ToDecimal(linea.Quantity)) * Convert.ToDecimal(linea.SWeight1), 2);
        }

        CalcularTotales(linea);
    }
