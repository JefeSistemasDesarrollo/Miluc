@page "/administrar-pedido/detalle/{DocEntry:int}"

@using System.Globalization
@using Miluc.Client.Interfaces.SapInterfaces.SapOrdr;
@using Miluc.Shared.DTOs.Sap.Pedidos
@using Shared.DTOs.Sap.Articulos
@using Shared.DTOs.Sap.Vendedor
@inject ISapOrdrService _sapOrdrService
@inject NavigationManager nav
@inject IAuthClientService _authClient

<div class="container-fluid py-4 bg-light min-vh-100">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3 page-header">

        <div>
            <span class="text-uppercase small fw-bold text-muted tracking-wider d-block mb-1">Módulo SAP One</span>
            <h class="fw-black text-dark m-0 d-flex align-items-center gap-2">
                <i class="bi bi-receipt text-maroon"></i>
                Orden de Venta <span class="text-maroon">#@modelUpdateOrden.DocNum</span>
            </h>
        </div>

        <div class="d-flex align-items-center gap-3 w-100 w-md-auto justify-content-between justify-content-md-end">
            @if (modelUpdateOrden.CANCELED == "Y")
            {
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill animate__animated animate__pulse animate__infinite">
                    <i class="bi bi-x-circle-fill me-1"></i> CANCELADO en SAP
                </span>
            }
            else
            {
                @if (modelUpdateOrden.DocStatus == "C") 
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">
                        <i class="bi bi-check-circle-fill me-1"></i> PROCESADO / CERRADO
                    </span>
                }
                else
                {
                    <span class="badge bg-success bg-opacity-10 text-warning border border-warning px-3 py-2 rounded-pill">
                        <i class="bi bi-clock-history me-1"></i> ACTIVO / ABIERTO
                    </span>
                }
            }

            <button class="btn btn-white-modern shadow-sm rounded-pill px-4"
                    @onclick='() => nav.NavigateTo("/administrar-pedido/pedidos")'>
                <i class="bi bi-arrow-left me-2"></i> Volver
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 ">
                <div class="card-body p-4 border-maroon rounded-4">
                    <div class="d-flex align-items-center gap-2 mb-3 text-muted text-uppercase small fw-bold tracking-wider">
                        <i class="bi bi-person-badge text-danger  fs-5"></i> Datos del Socio de negocio
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@modelUpdateOrden.CardName</h5>
                    <p class="text-muted small mb-3">Codigo del cliente: <span class="badge bg-light text-dark border">@modelUpdateOrden.CardCode</span></p>

                    <div class="d-flex flex-column gap-2 border-top pt-3 small">
                        <div class="d-flex justify-content-between"><span class="text-muted">NIT / Identificación:</span> <strong class="text-dark">@modelUpdateOrden.NitCliente</strong></div>
                        <div class="d-flex justify-content-between text-end gap-2"><span class="text-muted text-start">Sucursal  de Despacho:</span> <strong class="text-dark">@modelUpdateOrden.CardFName</strong></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-0 border-start   rounded-3">
                <div class="card-body p-4 border-maroon rounded-4 ">
                    <div class="d-flex align-items-center gap-2 mb-3 text-muted text-uppercase small fw-bold tracking-wider">
                        <i class="bi bi-calendar3 text-maroon fs-5 bg"></i> Fechas pedido
                    </div>
                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3">
                            <span class="text-muted">Fecha Emisión</span>
                            <span class="fw-bold badge bg-white text-dark shadow-sm border py-2 px-3">@modelUpdateOrden.DocDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3">
                            <span class="text-muted">Fecha de Entrega</span>
                            <span class="fw-bold badge bg-danger bg-opacity-10 text-danger py-2 px-3 border border-danger-subtle">@modelUpdateOrden.DocDueDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-12 col-xl-4">
            <div class="card h-100 shadow-sm border-0 border-start  rounded-3">
                <div class="card-body p-4 border-maroon rounded-4">
                    <div class="d-flex align-items-center gap-2 mb-3 text-muted text-uppercase small fw-bold tracking-wider">
                        <i class="bi bi-bezier2 text-marron fs-5"></i> Comercial
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted d-block">Asesor Comercial</label>
                        <span class="fs-5 fw-bold text-dark">@modelUpdateOrden.SlpName</span>
                    </div>
                    <div class="p-2 bg-marron text-white rounded-3 d-flex  justify-content-between align-items-center px-3 small">
                        <span class="opacity-75"><i class="bi bi-globe me-1"></i> Origen:</span>
                        <span class="fw-bold tracking-wider text-uppercase text-white">@nombreOrigenPedido</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2 mt-5">
        <i class="bi bi-box-seam text-danger"></i> Ítems en la Orden
    </h5>

    <div class="d-flex flex-column gap-3">
        @if (lineasPedido != null)
        {
            @for (int i = 0; i < lineasPedido.Count; i++)
            {
                var linea = lineasPedido[i];
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden animate__animated animate__fadeInUp" style="animation-delay: @($"{i * 50}ms")">
                    <div class="row g-0 align-items-center">

                        <div class="col-12 col-md-auto bg-light text-center py-2 px-3 border-end fw-bold text-muted min-w-50">
                            # @(i + 1)

                        </div>

                        <div class="col-12 col-md p-3">
                            <span class="badge bg-danger text-white mb-1 font-monospace">@linea.ItemCode</span>
                            <h6 class="fw-bold text-dark m-0 text-truncate">@linea.ItemName</h6>
                        </div>

                        <div class="col-6 col-md-2 p-3 text-center border-start-md bg-light bg-opacity-25">
                            <span class="small text-muted d-block mb-1">Cantidad</span>
                            <span class="fs-5 fw-bold text-dark">@Convert.ToDecimal(linea.Quantity).ToString("N2", new CultureInfo("es-CO"))</span>
                            <span class="small text-muted font-monospace">@linea.BuyUnitMsr</span>
                        </div>

                        <div class="col-6 col-md-4 p-3 border-start-md">
                            <div class="row g-2 small">
                                <div class="col-6">
                                    <span class="text-muted d-block text-xs">Precio Lista:</span>
                                    <span class="fw-semibold text-dark">@linea.PriceAsignado?.ToString("N2", new CultureInfo("es-CO"))</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block text-xs">Precio Cobrado:</span>
                                    <span class="fw-semibold text-dark">@linea.PriceAcobrar?.ToString("N2", new CultureInfo("es-CO"))</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block text-xs">Impuesto (@linea.TaxCode):</span>
                                    <span class="text-muted">@linea.TotalImpuesto.ToString("N2", new CultureInfo("es-CO"))</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block text-xs">P. Especial:</span>
                                    @if (linea.PriceEspecial > 0)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle py-0 px-1">
                                            @linea.PriceEspecial?.ToString("N2", new CultureInfo("es-CO"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-2 p-3 bg-light bg-opacity-50 border-start-md small">
                            <div class="row g-1">
                                <div class="col-6 col-md-12">
                                    <span class="text-muted text-xs">Peso SAP:</span> <strong class="text-dark">@Convert.ToDecimal(linea.SWeight1).ToString("N2", new CultureInfo("es-CO")) Kg</strong>
                                </div>
                                <div class="col-6 col-md-12">
                                    <span class="text-muted text-xs">Equiv. Uni:</span> <strong class="text-dark">@Convert.ToDecimal(linea.U_UnidadSal).ToString("N2", new CultureInfo("es-CO"))   </strong>
                                </div>
                                <div class="col-12">
                                    <span class="text-muted text-xs">Equiv. Kg:</span> <strong class="text-dark">@Convert.ToDecimal(linea.U_CantidadKg).ToString("N2", new CultureInfo("es-CO"))</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-2 p-3 bg-danger bg-opacity-10 text-end border-start-md h-100">
                            <span class="text-uppercase text-muted d-block text-xs fw-bold mb-1">Total Línea</span>
                            <span class="fs-5 fw-bold text-danger">@Convert.ToDecimal(linea.BaseSum).ToString("N2", new CultureInfo("es-CO"))</span>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center p-5 bg-white rounded-4 shadow-sm border">
                <div class="spinner-border text-danger" role="status"></div>
                <p class="text-muted mt-2 mb-0 fw-semibold">Cargando líneas de la orden...</p>
            </div>
        }
    </div>

    <div class="row justify-content-end mt-4 g-4">
        <div class="col-12 col-md-6 col-lg-5 col-xl-4">
            <div class="card shadow-sm border-0 border-top border-4 border-secondary rounded-3 h-100">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex justify-content-between align-items-center">
                            <span>Comentarios SAP</span>
                            <i class="bi bi-chat-square-text text-muted fs-5"></i>
                        </h5>
                        <p class="text-muted bg-light p-3 rounded-3 border small m-0 font-italic">
                            @(string.IsNullOrWhiteSpace(comentarios) ? "Sin comentarios registrados en esta orden." : comentarios)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-5 col-xl-4">
            <div class="card shadow-sm border-0 border-top border-4 border-danger rounded-3 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex justify-content-between align-items-center">
                        <span>Resumen Monetario</span>
                        <i class="bi bi-calculator   text-maroon fs-5"></i>
                    </h5>

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Subtotal Neto</span>
                        <span class="fw-bold text-dark">@Subtotal.ToString("N2", new CultureInfo("es-CO"))</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Impuestos Consolidados</span>
                        <span class="fw-bold text-dark">@Iva.ToString("N2", new CultureInfo("es-CO"))</span>
                    </div>

                    @if (Redondeo != 0)
                    {
                        <div class="d-flex justify-content-between mb-3 text-xs text-muted">
                            <span>Ajuste por Redondeo</span>
                            <span class="fs-7 fw-bold font-monospace text-dark ">@Redondeo.ToString("N2", new CultureInfo("es-CO"))</span>
                        </div>
                    }

                    <div class="p-3 bg-maroon  rounded-3 d-flex justify-content-between align-items-center border border-danger-subtle mt-3">
                        <strong class="text-white text-uppercase tracking-wider small">Total General</strong>
                        <strong class="fs-5 fw-bold text-white">
                            @TotalFinal.ToString("N2", new CultureInfo("es-CO"))
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


@code {

    [Parameter]
    public int DocEntry { get; set; }
    // private decimal descuentoPorcentaje = 0;
    private Shared.DTOs.Sap.Cliente.SapClienteReaderDto? clienteSeleccionado = new();

    private SapOitmDto? ArticuloSeleccionado = new();
    //EL PEDIDO QUE VAMOS A EDITAR, INICIALIZAMOS CON LOS VALORES EXISTENTES PARA MOSTRARLOS EN EL FORMULARIO
    private OrdersReaderDto modelUpdateOrden = new();
    //LA LISTA ORIGEN DEL PEDIDO LA INICIALIZAMOS CON LOS VALORES FIJOS QUE TENEMOS EN SAP, PARA QUE EL USUARIO PUEDA SELECCIONAR EL ORIGEN DEL PEDIDO
    private List<OrigenPedidoDto> listOrigenPedidos = new();
    //LA LISTA DE LINEAS DEL PEDIDO, INICIALIZAMOS VACIA Y SE IRÁ LLENANDO A MEDIDA QUE EL USUARIO VAYA AGREGANDO ARTÍCULOS, CADA VEZ QUE SE AGREGA O MODIFICA UNA LÍNEA SE CALCULAN LOS TOTALES CORRESPONDIENTES
    private List<ArticuloPorListaDePreciosDto> lineasPedido = new();
    //LA LISTA DE VENDEDORES LA INICIALIZAMOS CON LOS VENDEDORES QUE TENEMOS EN SAP, PARA QUE EL USUARIO PUEDA SELECCIONAR EL VENDEDOR RESPONSABLE DEL PEDIDO
    private List<SapVendedorReaderDto> listVendedores = new();
    //LA LISTA DE ARTÍCULOS LA INICIALIZAMOS VACÍA Y SE IRÁ LLENANDO CON LOS RESULTADOS DE LA BÚSQUEDA QUE EL USUARIO HAGA EN EL MODAL DE ARTÍCULOS, CADA VEZ QUE EL USUARIO HAGA UNA BÚSQUEDA SE CONSULTA A SAP Y SE ACTUALIZA ESTA LISTA CON LOS RESULTADOS OBTENIDOS

    private List<SapOitmDto> listaArticulosApi = new();
    //FECHAS DEL PEDIDO, INICIALIZAMOS CON LA FECHA ACTUAL PERO EL USUARIO PUEDE MODIFICARLA SI LO DESEA, LA FECHA DE CONTABILIZACIÓN SE UTILIZA PARA CALCULAR LOS TOTALES Y LA FECHA DE ENTREGA SE UTILIZA PARA CALCULAR LOS PLAZOS DE ENTREGA Y LAS CONDICIONES DE PAGO
    private DateTime fechaContabilizacion = DateTime.Now;
    private DateTime fechaEntrega = DateTime.Now;
    //LA VAMOS A PASAR DESDE EL CLIENTE DEL PEDIDO , CUANDO EL USUARIO SELECCIONE EL PEDIDO QUE DESEA EDITAR, SE CONSULTA A SAP POR LOS DETALLES DE ESE PEDIDO Y SE INICIALIZA ESTE OBJETO CON LOS VALORES O
    private Int16? origenSeleccionado = 0;
    private ArticuloPorListaDePreciosDto articuloPorListaDePreciosDto = new();
    // Totales calculados
    private decimal Subtotal => lineasPedido.Sum(x => x.BaseSum);
    // El IVA se calcula sumando el TotalImpuesto de cada línea, que ya incluye el cálculo del impuesto según la cantidad y el precio
    private decimal Iva => lineasPedido.Sum(x => x.TotalImpuesto);
    //private decimal TotalFinal =>Math.Round(Subtotal + Iva, 2, MidpointRounding.AwayFromZero);
    private decimal TotalFinal => Math.Round((Subtotal + Iva));
    // El redondeo se calcula como la diferencia entre el total final redondeado y el total sin redondear, para mostrar al usuario cuánto se está redondeando en el documento

    private decimal TotalSinRedondeo => (Subtotal + Iva);
    // El redondeo se calcula como la diferencia entre el total final redondeado y el total sin redondear, para mostrar al usuario cuánto se está redondeando en el documento
    private decimal Redondeo => TotalFinal - TotalSinRedondeo;
    //private decimal ValorRedondeo => TotalFinal - TotalSinRedondeo;
    private string comentarios = "";
    private string nombreOrigenPedido = "";



    protected override async Task OnParametersSetAsync()
    {
        if (_authClient.HasPermission("Orders.Detail"))
        {
            await InicializarFormulario();
        }
        else
        {
            nav.NavigateTo("/no-autorizado");
            return;
        }
    }

    private async Task InicializarFormulario()
    {
        clienteSeleccionado = new();
        ArticuloSeleccionado = new();
        lineasPedido.Clear();
        comentarios = "";
        //ACA VAMOS A INICIALIZAR EL OBJETO modelUpdateOrden CONSULTANDO A SAP POR
        // LOS DETALLES DEL PEDIDO QUE VAMOS A EDITAR, Y ASIGNAMOS LOS VALORES OBTENIDOS A LAS VARIABLES CORRESPONDIENTES
        //  PARA MOSTRARLOS EN EL FORMULARIO, COMO EL CLIENTE SELECCIONADO, LAS LINEAS DEL PEDIDO, LAS FECHAS, EL ORIGEN DEL PEDIDO, ETC
        var responseOrdenUpdate = await _sapOrdrService.GetOrderByIdAsync(DocEntry);

        if (responseOrdenUpdate != null && responseOrdenUpdate.Valor != null)
        {
            modelUpdateOrden = responseOrdenUpdate.Valor;
            origenSeleccionado = modelUpdateOrden.U_OrigenPedido;
            fechaContabilizacion = modelUpdateOrden.DocDate;
            fechaEntrega = modelUpdateOrden.DocDueDate;
            comentarios = modelUpdateOrden.Comments;
            // ASIGNAMOS EL CLIENTE SELECCIONADO
            if (!string.IsNullOrEmpty(modelUpdateOrden.CardCode))
            {
                // var responseCliente = await _sapOcrdClientService.GetClienteByCardCodeAsync(modelUpdateOrden.CardCode);
                clienteSeleccionado.CardCode = modelUpdateOrden.CardCode;
                clienteSeleccionado.CardName = modelUpdateOrden.CardName;
                // clienteSeleccionado.ListName = modelUpdateOrden.ListName;
                // clienteSeleccionado.LicTradNum = modelUpdateOrden.LicTradNum;
                clienteSeleccionado.CardFName = modelUpdateOrden.CardFName;
                origenSeleccionado = modelUpdateOrden.U_OrigenPedido;
            }
            // ASIGNAMOS LAS LINEAS DEL PEDIDO
            if (modelUpdateOrden.detalle != null)
            {
                lineasPedido = modelUpdateOrden.detalle.Select(linea => new ArticuloPorListaDePreciosDto
                {
                    ItemCode = linea.ItemCode,
                    ItemName = linea.ItemName,
                    Quantity = linea.Quantity,
                    BuyUnitMsr = linea.BuyUnitMsr,
                    PriceAcobrar = Math.Round(Convert.ToDecimal(linea.PriceAcobrar),2),
                    PriceAsignado = Math.Round(Convert.ToDecimal(linea.PriceAsignado),2),
                    PriceEspecial = Math.Round(Convert.ToDecimal(linea.PriceAcobrar),2),
                    TaxCode = linea.TaxCode,
                    Rate = Math.Round(Convert.ToDecimal(linea.Rate),2),
                    // NombreRate = linea.NombreRate,
                    SWeight1 = Math.Round(Convert.ToDecimal(linea.SWeight1),2)
                }).ToList();
                //aca vamos
                foreach (var linea in lineasPedido)
                {
                    //aca vamos a realizar todas las operaciones
                    // para calcular el equivalente en kg y unidades, dependiendo de la unidad de medida de compra que tenga cada artículo,
                    //  y el peso que tenga asignado en SAP, para eso utilizamos las propiedades BuyUnitMsr y SWeight1 que ya tenemos en cada
                    // línea, y aplicamos las fórmulas correspondientes para cada caso, teniendo en cuenta que si la unidad de medida es kg,
                    //  entonces el equivalente en kg es la cantidad ingresada y el equivalente en unidades se calcula multiplicando por el peso,
                    //  y si la unidad de medida es unidades, entonces el equivalente en kg se calcula dividiendo la cantidad ingresada por el peso,
                    // y el equivalente en unidades es la cantidad ingresada


                    if (linea.SWeight1 > 0)
                    {
                        //calcular el equivalente en kg y unidades dependiendo de la unidad de medida de compra, teniendo en cuenta el peso del artículo
                        if (!string.IsNullOrEmpty(linea.BuyUnitMsr))
                        {
                            if (linea.BuyUnitMsr.ToUpper() == "KG")
                            {
                                linea.U_CantidadKg = linea.Quantity;
                                decimal pesoUnidades = Math.Round(Convert.ToDecimal(linea.U_CantidadKg / linea.SWeight1));
                                linea.U_UnidadSal = (int)Math.Round(pesoUnidades, MidpointRounding.AwayFromZero);
                            }
                            else
                            {
                                linea.U_UnidadSal = linea.Quantity;
                                linea.U_CantidadKg = Math.Round(Convert.ToDecimal(linea.U_UnidadSal * linea.SWeight1));
                            }
                           
                        }
                    }
                    linea.BaseSum = Convert.ToDecimal(linea.Quantity) * Convert.ToDecimal((linea.PriceAcobrar ?? 0));
                    linea.TotalImpuesto = (linea.BaseSum * linea.Rate) / 100;

                }

            }

        }
        fechaContabilizacion = DateTime.Now;
        fechaEntrega = DateTime.Now;

        listOrigenPedidos = new List<OrigenPedidoDto>
        {
            new OrigenPedidoDto{ OrigenPedidoId=1,OrigenNombre="Seleccione.."},
            new OrigenPedidoDto{ OrigenPedidoId=2,OrigenNombre="Redes Sociales"},
            new OrigenPedidoDto{ OrigenPedidoId=3,OrigenNombre="WhatsApp"},
            new OrigenPedidoDto{ OrigenPedidoId=4,OrigenNombre="Télefono Celular"},
            new OrigenPedidoDto{ OrigenPedidoId=5,OrigenNombre="Correo"},
            new OrigenPedidoDto{ OrigenPedidoId=6,OrigenNombre="Tienda - pag"},
            new OrigenPedidoDto{ OrigenPedidoId=7,OrigenNombre="Puntos de Venta"},
            new OrigenPedidoDto{ OrigenPedidoId=8,OrigenNombre="Referidos"}
};

        foreach (var origen in listOrigenPedidos)
        {
            if (origen.OrigenPedidoId == origenSeleccionado)
            {
                nombreOrigenPedido = origen.OrigenNombre;
            }
        }
    }
}