    private async Task BuscarEnServidorCliente(string? textoBusqueda = null, int? pagina = null, int? cantidadPorPagina = null)
    {
        try
        {
            if (Convert.ToInt32(pagina) <= 0)
            {
                pagina = 1;
            }
            if (textoBusqueda == null)
            {
                textoBusqueda = _textoBusquedaCliente;
            }
            if (cantidadPorPagina == null)
            {
                cantidadPorPagina = cantidadPorPaginaCliente;
            }
            Cargando = true;

            var response = await _sapOcrdClientService.GetallClienteAsync(textoBusqueda.ToString().Trim(), Convert.ToInt32(pagina), Convert.ToInt32(cantidadPorPagina));

            if (response != null)
            {
                listoriginalClientes = response?.Valor;
                listClientesApi = listoriginalClientes.ToList();
                CantidadDeClientesEncontrados = response?.CantRegistros ?? 0;
            }
            else
            {
                listClientesApi = new List<SapClienteReaderDto>();
                string errores = response.Errores != null && response.Errores.Any()
                ? string.Join("<br>", response.Errores)
                : "Ocurrió un error inesperado.";

                await _jsRuntime.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = $"Error al consultar clientes {response.Mensaje} ",
                    text = $"{errores}",
                    confirmButtonColor = "#6c1d1d"
                });
            }
        }
        catch (Exception ex)
        {
            await _logClientService.GuardarErrorAsync(ex.Message, ex.StackTrace, nivel: "error", metodo: "BuscarEnServidor");
            await _jsRuntime.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = $"Error al consultar socio de negocio",
                text = $"{ex.Message}",
                confirmButtonColor = "#6c1d1d"
            });
        }
        finally
        {
            Cargando = false;
            StateHasChanged();
        }
    }
