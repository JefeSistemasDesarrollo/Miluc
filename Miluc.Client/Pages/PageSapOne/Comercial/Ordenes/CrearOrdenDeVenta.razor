@page "/administrar-pedido/crear-pedido"
@using System.Globalization
@using Miluc.Client.Interfaces.SapInterfaces.Cliente
@using Miluc.Client.Interfaces.SapInterfaces.Oslp
@using Miluc.Client.Interfaces.SapInterfaces.SapOitm
@using Miluc.Client.Interfaces.SapInterfaces.SapOrdr
@using Miluc.Shared.DTOs.Sap.Articulos
@using Miluc.Shared.DTOs.Sap.Cliente
@using Miluc.Shared.DTOs.Sap.Pedidos
@using Miluc.Shared.DTOs.Sap.Vendedor
@using System.Text.Json
@inject ISapOcrdClientService _sapOcrdClientService
@inject NavigationManager nav
@inject ILogClientService _logClientService
@inject IAuthClientService _authClientService
@inject ISapOslpService _sapOslpVendedorService
@inject ISapOitmClientService _sapOitmClientService
@inject ISapOrdrService _sapOrdrService
@inject IJSRuntime _jsRuntime
<div class="container-fluid py-3 bg-light min-vh-100">
    @* encabezado de los pedidos *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-title fw-bold mb-0">
            <i class="bi bi-file-earmark-plus me-2"></i>Orden de Venta
        </h4>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick='() => nav.NavigateTo("/administrar-pedido/pedidos")'>
                <i class="bi bi-arrow-left me-1"></i> Volver
            </button>
            <button type="submit" form="pedidoForm" class="btn btn-miluc rounded-pill px-4">
                <i class="bi bi-check-circle me-1"></i> Crear
            </button>
        </div>
    </div>
    <EditForm id="pedidoForm" Model="clienteSeleccionado" OnValidSubmit="CrearPedido">
        <div class="row g-3">
            @* --- DATOS DEL CLIENTE --- *@
            <div class="col-12 col-xl-4">
                <div class="card shadow-sm border-0 border-top border-maroon border-4 h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3 small text-uppercase text-muted">Datos del Cliente</h6>
                        <div class="mb-3">
                            <label class="form-label">Cliente (Socio de Negocio)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                <InputText class="form-control cursor-pointer" readonly @onclick="AbrirModalCliente" @bind-Value="clienteSeleccionado.CardCode" />
                                <button class="btn btn-maroon" type="button" @onclick="AbrirModalCliente">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Lista de precios  : @clienteSeleccionado?.ListName</label>
                        </div>
                        <div class="mb-2">
                            Sucursal : @(clienteSeleccionado?.CardFName ?? "")
                        </div>
                        <div class="mb-2">
                            Estado de cuenta : @(clienteSeleccionado?.Balance?.ToString("N2", new CultureInfo("es-CO")) ?? "0,00")
                        </div>
                        <div class="mt-3">
                            <span class="badge @(clienteSeleccionado?.validFor == 'Y' ? "bg-success" : "bg-secondary") w-100 py-2">
                                Estado: @(clienteSeleccionado?.validFor == 'Y' ? "Activo" : "Inactivo")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            @* --- LOGÍSTICA --- *@
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 border-top border-maroon border-4 h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3 small text-uppercase text-muted">Logística y Fechas</h6>
                        <div class="mb-3">
                            <label class="form-label">Fecha de Emision</label>
                            <InputDate class="form-control form-control-sm" @bind-Value="fechaContabilizacion" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fecha de Entrega</label>
                            <InputDate class="form-control form-control-sm" @bind-Value="fechaEntrega" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>
            </div>
            @* --- VENTAS --- *@
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 border-top border-maroon border-4 h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3 small text-uppercase text-muted">Encabezado de Ventas</h6>
                        <div class="mb-3">
                            <label class="form-label">Empleado de Ventas</label>
                            <select class="form-select form-select-sm" disabled>
                                @if (clienteSeleccionado?.SlpCode != null)
                                {
                                    var vendedorPredeterminado = listVendedores.FirstOrDefault(v => v.SlpCode == clienteSeleccionado.SlpCode);
                                    if (vendedorPredeterminado != null)
                                    {
                                        <option value="@vendedorPredeterminado.SlpCode" selected>@vendedorPredeterminado.SlpName</option>
                                    }
                                }
                                @foreach (var vendedor in listVendedores)
                                {
                                    <option value="@vendedor.SlpCode">@vendedor.SlpName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Origen del Pedido</label>
                            <select class="form-select form-select-sm" @bind="origenSeleccionado">

                                @foreach (var origen in listOrigenPedidos)
                                {
                                    <option value="@origen.OrigenPedidoId">@origen.OrigenNombre</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* --- GRILLA DE ARTÍCULOS DINÁMICA --- *@
        <div class="col-12 mt-3">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Contenido del Pedido</h6>
                    <button type="button" class="btn btn-sm btn-outline-maroon" @onclick="AbrirModalArticulo">
                        <i class="bi bi-plus-lg me-1"></i> Agregar Línea
                    </button>
                </div>
                <div class="table-responsive" style="max-height: 350px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th class="ps-3" style="width: 3%">#</th>
                                <th style="width: 5%">Código</th>
                                <th style="width: 15%">Descripción</th>
                                <th class="text-center" style="width: 3%">Cantidad</th>
                                <th style="width: 3%">U.M</th>
                                <th style="width: 8%">Equi.k</th>
                                <th style="width: 8%">Equi.U</th>
                                <th class="text-end" style="width: 10%">Precio</th>
                                <th class="text-end" style="width: 10%">Precio Cliente</th>
                                <th class="text-end" style="width: 8%">Precio Especial</th>
                                <th class="text-end" style="width: 10%">Impuesto</th>
                                <th class="text-end" style="width: 10%">% Renta</th>
                                <th class="text-end pe-3" style="width: 10%">Total Impuesto</th>
                                <th class="text-end pe-3" style="width: 10%">Total</th>
                                <th class="text-center" style="width: 5%"> Eliminar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < lineasPedido.Count; i++)
                            {
                                var index = i;
                                var linea = lineasPedido[index];
                                <tr>
                                    <td class="ps-3 text-muted">@(index + 1)</td>

                                    <td>
                                        <span class="text-vinotinto">@linea.ItemCode</span>
                                    </td>

                                     
                                    <td>
                                        <input type="text" readonly class="form-control form-control-sm" @bind="linea.ItemName">
                                    </td>

                                    <!-- CANTIDAD -->
                                    <td>
                                        @if (linea.BuyUnitMsr?.ToUpper() == "KG")
                                        {
                                            <InputNumber TValue="decimal?"
                                                         Value="linea.Quantity"
                                                         ValueChanged="@(v => OnCantidadChanged(v, linea))"
                                                         ValueExpression="() => linea.Quantity"
                                                         class="form-control form-control-sm text-end"
                                                         step="any"
                                                         min="0" />
                                        }
                                        else
                                        {
                                            <InputNumber TValue="decimal?"
                                                         Value="linea.Quantity"
                                                         ValueChanged="@(v => OnCantidadChanged(Math.Round(v ?? 0,0,MidpointRounding.AwayFromZero), linea))"
                                                         ValueExpression="() => linea.Quantity"
                                                         class="form-control form-control-sm text-end"
                                                         step="1"
                                                         min="0" />
                                        }
                                    </td>

                                    <td class="align-content-center">
                                        @linea.BuyUnitMsr
                                    </td>

                                    <!-- EQUIVALENTE KG -->
                                    <td>
                                        @if (linea.BuyUnitMsr?.ToUpper() == "KG")
                                        {
                                            <!-- Cuando el artículo se vende por Kg, este campo solo muestra el valor -->
                                            <InputNumber TValue="decimal?"
                                                         Value="linea.U_EquivalentedKg"
                                                         ValueExpression="() => linea.U_EquivalentedKg"
                                                         class="form-control form-control-sm text-end"
                                                         step="any"
                                                         readonly />
                                        }
                                        else
                                        {
                                            <!-- Cuando el artículo se vende por unidades, este campo SI se puede editar -->
                                            <InputNumber TValue="decimal?"
                                                         Value="linea.U_EquivalentedKg"
                                                         ValueChanged="@(v => OnKgChanged(v, linea))"
                                                         ValueExpression="() => linea.U_EquivalentedKg"
                                                         class="form-control form-control-sm text-end"
                                                         step="any"
                                                         min="0" />
                                        }
                                    </td>

                                    <!-- EQUIVALENTE UNIDADES -->
                                    <td>
                                        @if (linea.BuyUnitMsr?.ToUpper() == "KG")
                                        {
                                            <!-- Cuando el artículo se vende por Kg, este campo SI se puede editar -->
                                            <InputNumber TValue="decimal?"
                                                         Value="linea.U_EquivalenteUni"
                                                         ValueChanged="@(v => OnUnidadesChanged(v, linea))"
                                                         ValueExpression="() => linea.U_EquivalenteUni"
                                                         class="form-control form-control-sm text-end"
                                                         step="1"
                                                         min="0" />
                                        }
                                        else
                                        {
                                            <!-- Cuando el artículo se vende por unidades, solo muestra el valor -->
                                            <InputNumber TValue="decimal?"
                                                         Value="linea.U_EquivalenteUni"
                                                         ValueExpression="() => linea.U_EquivalenteUni"
                                                         class="form-control form-control-sm text-end"
                                                         readonly />
                                        }


                                    </td>
                                 
                                    
                                    <!-- PRECIOS -->
                                    <td>
                                        <input type="number" readonly class="form-control form-control-sm text-end" @bind="linea.PriceAcobrar" @bind:event="oninput">
                                    </td>
                                    <td>
                                        <input type="number" readonly class="form-control form-control-sm text-end" @bind="linea.PriceAsignado" @bind:event="oninput">
                                    </td>
                                    <td>
                                        <input type="number" readonly class="form-control form-control-sm text-end" @bind="linea.PriceEspecial" @bind:event="oninput">
                                    </td>
                                    <td>
                                        <input type="text" readonly class="form-control form-control-sm" @bind="linea.CodeTaxcode">
                                    </td>
                                    <td>
                                        <input type="number" readonly class="form-control form-control-sm text-end" @bind="linea.Rate" @bind:event="oninput">
                                    </td>
                                    <td class="text-end pe-3 fw-bold text-maroon">
                                        @linea.TotalImpuesto.ToString("N2", new CultureInfo("es-CO"))
                                    </td>
                                    <td class="text-end pe-3 fw-bold text-maroon">
                                        @linea.BaseSum.ToString("N2", new CultureInfo("es-CO"))
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm text-danger" @onclick="() => lineasPedido.Remove(linea)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @* --- COMENTARIOS Y TOTALES --- *@
        <div class="row g-3 mt-1">
            <div class="col-12 col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <label class="form-label fw-bold small text-muted text-uppercase">Comentarios</label>
                        <InputTextArea class="form-control" rows="6" @bind-Value="comentarios" placeholder="Notas adicionales..."></InputTextArea>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm border-0 bg-white">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-muted small text-uppercase">Resumen de Totales</h6>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Subtotal</span>
                            <span>@Subtotal.ToString("N2", new CultureInfo("es-CO"))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small align-items-center">
                            <span class="text-muted">Redondeo </span>
                            <span>@Redondeo.ToString("N2", new CultureInfo("es-CO"))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Impuesto</span>
                            <span>@Iva.ToString("N2", new CultureInfo("es-CO"))</span>
                        </div>
                        <hr class="my-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0 fw-bold">TOTAL DOCUMENTO</span>
                            <span class="h4 mb-0 fw-bold text-maroon"> @TotalFinal.ToString("N2", new CultureInfo("es-CO")) </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>
@* --- MODAL DE BÚSQUEDA DE CLIENTES  --- *@
<div class="modal fade @(mostrarModalCliente ? "show d-block" : "")" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">
    <!-- MODAL PEQUEÑO -->
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <!-- HEADER -->
            <div class="modal-header bg-maroon text-white">
                <h5 class="modal-title mb-0">

                    <i class="bi bi-person-fill-add"></i>Buscar Clientes

                </h5>
                <button type="button" class="btn-close btn-close-white ms-auto" @onclick="CerrarModalCliente"></button>
            </div>
            <!-- BODY -->
            <div class="modal-body">
                <!-- BUSCADOR -->
                <div class="input-group mb-3">
                    <input type="text" class="form-control" @bind:event="oninput" placeholder="Buscar Cliente..." @bind="textoBusquedaCliente" @onkeyup="HandleEnterCliente">
                    <button class="btn btn-maroon" @onclick="() => BuscarEnServidorCliente()"><i class="bi bi-search"></i>Buscar</button>
                </div>
                <!-- INFORMACION -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-muted">
                        Registros encontrados:
                        <strong>@CantidadDeArticulosEncontrados</strong>
                    </small>
                    <small class="text-muted">
                        Página @paginaActualCliente de @TotalPaginasCliente
                    </small>
                </div>
                <!-- LISTA -->
                <div class="list-group" style="max-height: 350px; overflow-y: auto;">

                    @if (listClientesApi.Any())
                    {
                        @foreach (var item in listClientesApi)
                        {
                            <button type="button" class="list-group-item list-group-item-action" @onclick="() => SeleccionarCliente(item)">
                                <div class="d-flex flex-column">
                                    <strong class="text-maroon">@item.CardCode</strong>

                                    <small class="text-muted">@item.CardName</small>
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-search fs-3"></i>
                            <div class="mt-2">
                                No se encontraron cliente
                            </div>
                        </div>
                    }

                </div>

                <!-- PAGINADOR -->
                @if (CantidadDeClientesEncontrados > 0)
                {
                    <div class="d-flex justify-content-center mt-3">
                        <div class="btn-group">
                            <!-- ANTERIOR -->
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(paginaActualCliente == 1)" @onclick="PaginaAnteriorCliente">
                                <i class="bi bi-chevron-left"></i>
                            </button>

                            <!-- PAGINAS -->
                            @for (int i = Math.Max(1, paginaActualCliente - 2); i <= Math.Min(TotalPaginasCliente, paginaActualCliente + 2); i++)
                            {
                                var pagina = i;
                                <button class="btn @(paginaActualCliente == pagina ? "btn-maroon text-white" : "btn-outline-secondary") btn-sm"
                                        @onclick="() => IrPaginaCliente(pagina)">
                                    @pagina
                                </button>
                            }
                            <!-- SIGUIENTE -->
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(paginaActualCliente == TotalPaginasCliente)"
                                    @onclick="SiguientePaginaCliente">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* MODAL DE ARTICULOS *@
<div class="modal fade @(mostrarModalArticulo ? "show d-block" : "")" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">

    <!-- MODAL  PEQUEÑO -->
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <!-- HEADER -->
            <div class="modal-header bg-maroon text-white">
                <h5 class="modal-title mb-0"><i class="bi bi-box-seam me-2"></i>Buscar Artículo</h5>
                <button type="button" class="btn-close btn-close-white ms-auto" @onclick="CerrarModalArticulo"></button>

            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- BUSCADOR -->
                <div class="input-group mb-3">

                    <input type="text" class="form-control" placeholder="Buscar artículo..." @bind:event="oninput" @bind="textoBusquedaArticulo" @onkeyup="HandleEnterArticulo">

                    <button class="btn btn-maroon" @onclick="() => BuscarEnServidorArticulo()"><i class="bi bi-search"></i>Buscar</button>
                </div>
                <!-- INFORMACION -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-muted">
                        Registros encontrados:
                        <strong>@CantidadDeArticulosEncontrados</strong>
                    </small>

                    <small class="text-muted">
                        Página @paginaActualArticulo de @TotalPaginasArticulo
                    </small>
                </div>
                <!-- LISTA -->
                <div class="list-group"
                     style="max-height: 350px; overflow-y: auto;">

                    @if (listaArticulosApi.Any())
                    {
                        @foreach (var item in listaArticulosApi)
                        {
                            <button type="button" class="list-group-item list-group-item-action" @onclick="() => SeleccionarArticulo(item)">
                                <div class="d-flex flex-column">
                                    <strong class="text-maroon">
                                        @item.ItemCode
                                    </strong>
                                    <small class="text-muted">
                                        @item.ItemName
                                    </small>
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-search fs-3"></i>
                            <div class="mt-2">
                                No se encontraron artículos
                            </div>
                        </div>
                    }
                </div>
                <!-- PAGINADOR -->
                @if (CantidadDeArticulosEncontrados > 0)
                {
                    <div class="d-flex justify-content-center mt-3">

                        <div class="btn-group">

                            <!-- ANTERIOR -->
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(paginaActualArticulo == 1)" @onclick="PaginaAnteriorArticulo">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <!-- PAGINAS -->
                            @for (int i = Math.Max(1, paginaActualArticulo - 2); i <= Math.Min(TotalPaginasArticulo, paginaActualArticulo + 2); i++)
                            {
                                var pagina = i;
                                <button class="btn @(paginaActualArticulo == pagina ? "btn-maroon text-white" : "btn-outline-secondary") btn-sm" @onclick="() => IrPaginaArticulo(pagina)">
                                    @pagina
                                </button>
                            }
                            <!-- SIGUIENTE -->
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(paginaActualArticulo == TotalPaginasArticulo)" @onclick="SiguientePaginaArticulo">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@code {

    private bool Cargando = false;
    private string comentarios = "";
    // private decimal descuentoPorcentaje = 0;
    private SapClienteReaderDto? clienteSeleccionado = new();
    private SapOitmDto? ArticuloSeleccionado = new();
    private List<OrigenPedidoDto> listOrigenPedidos = new();
    private List<ArticuloPorListaDePreciosDto> lineasPedido = new();
    private List<SapVendedorReaderDto> listVendedores = new();
    private List<SapClienteReaderDto> listoriginalClientes = new();
    private List<SapClienteReaderDto> listClientesApi = new();
    private List<SapOitmDto> listaArticulosApi = new();
    private List<SapOitmDto> listaOriginalArticulos = new();
    private DateTime fechaContabilizacion = DateTime.Now;
    private DateTime fechaEntrega = DateTime.Now;
    private int origenSeleccionado = 6;
    private ArticuloPorListaDePreciosDto articuloPorListaDePreciosDto = new();
    // Totales calculados
    private decimal Subtotal => lineasPedido.Sum(x => x.BaseSum);
    private decimal Iva => lineasPedido.Sum(x => x.TotalImpuesto);
    //private decimal TotalFinal =>Math.Round(Subtotal + Iva, 2, MidpointRounding.AwayFromZero);
    private decimal TotalFinal => Math.Round((Subtotal + Iva));
    private decimal TotalSinRedondeo => (Subtotal + Iva);
    private decimal Redondeo => TotalFinal - TotalSinRedondeo;
    //private decimal ValorRedondeo => TotalFinal - TotalSinRedondeo;
    private bool mostrarModalCliente = false;
    private bool mostrarModalArticulo = false;
    private int paginaActualArticulo = 1;
    private int CantidadRegistrosPorPaginaArticulo = 10;
    private int CantidadDeArticulosEncontrados = 0;
    private int CantidadDeClientesEncontrados = 0;
    private int paginaActualCliente = 1;
    private int cantidadPorPaginaCliente = 10;
    // private int cantidadPorPaginaArticulo = 10;
    private string _textoBusquedaArticulo = "";
    private string _textoBusquedaCliente = "";

    private string textoBusquedaCliente
    {
        get => _textoBusquedaCliente;
        set
        {
            _textoBusquedaCliente = value;
            FiltrarClientes();
        }
    }
    private string textoBusquedaArticulo
    {
        get => _textoBusquedaArticulo;
        set
        {
            _textoBusquedaArticulo = value;
            FiltrarArticulos();
        }
    }
    private async Task InicializarFormulario()
    {
        clienteSeleccionado = new();
        ArticuloSeleccionado = new();
        lineasPedido.Clear();
        comentarios = "";
        origenSeleccionado = 6;
