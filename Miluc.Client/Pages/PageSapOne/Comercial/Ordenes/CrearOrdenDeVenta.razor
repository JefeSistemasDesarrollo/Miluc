    private void OnCantidadChanged(decimal? value, ArticuloPorListaDePreciosDto linea)
    {
        linea.Quantity = value ?? 0;

        if (linea.SWeight1 <= 0)
        {
            CalcularTotales(linea);
            return;
        }

        if (linea.BuyUnitMsr?.ToUpper() == "KG")
        {
            // Cantidad está en Kg
            linea.U_EquivalentedKg = linea.Quantity;

            linea.U_EquivalenteUni = Math.Round(Convert.ToDecimal(linea.Quantity) / Convert.ToDecimal(linea.SWeight1),0,MidpointRounding.AwayFromZero);
        }
        else
        {
            // Cantidad está en Unidades
            linea.U_EquivalenteUni = linea.Quantity;

            linea.U_EquivalentedKg = Math.Round(Convert.ToDecimal(linea.Quantity) * Convert.ToDecimal(linea.SWeight1),2);
        }

        CalcularTotales(linea);
    }

    private void OnKgChanged(decimal? value, ArticuloPorListaDePreciosDto linea)
    {
        linea.U_EquivalentedKg = value ?? 0;

        if (linea.SWeight1 <= 0)
        {
            CalcularTotales(linea);
            return;
        }

        linea.U_EquivalenteUni = Math.Round(
           Convert.ToDecimal(linea.U_EquivalentedKg) / Convert.ToDecimal(linea.SWeight1),
            0,
            MidpointRounding.AwayFromZero);

        // Como el artículo es por unidades,
        // Quantity siempre representa unidades.
        linea.Quantity = linea.U_EquivalenteUni;

        CalcularTotales(linea);
    }
    private void OnUnidadesChanged(decimal? value, ArticuloPorListaDePreciosDto linea)
    {
        linea.U_EquivalenteUni = Math.Round(value ?? 0, 0);

        if (linea.SWeight1 <= 0)
        {
            CalcularTotales(linea);
            return;
        }

        linea.U_EquivalentedKg = Math.Round(Convert.ToDecimal(linea.U_EquivalenteUni) * Convert.ToDecimal(linea.SWeight1), 2);

        // Como el artículo es por Kg,
        // Quantity siempre representa Kg.
        linea.Quantity = linea.U_EquivalentedKg;

        CalcularTotales(linea);
    }
    private void CalcularTotales(ArticuloPorListaDePreciosDto linea)
    {
        linea.BaseSum = Math.Round((linea.Quantity ?? 0) * (linea.PriceAcobrar ?? 0),2);

        linea.TotalImpuesto = Math.Round((linea.BaseSum * linea.Rate) / 100,2);
    }

  
    private void CalculaTotales(ArticuloPorListaDePreciosDto linea)
    {
        linea.BaseSum = Math.Round(Convert.ToDecimal(linea.Quantity) * Convert.ToDecimal((linea.PriceAcobrar ?? 0)), 2);
        linea.TotalImpuesto = Math.Round(Convert.ToDecimal((linea.BaseSum * linea.Rate) / 100), 2);
    }

