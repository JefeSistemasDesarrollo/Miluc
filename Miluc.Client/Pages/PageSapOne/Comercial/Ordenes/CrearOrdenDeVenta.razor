    private async Task BuscarEnServidorArticulo(string? textoBusqueda = null, int? pagina = null, int? cantidadPorPagina = null)
    {
        if (string.IsNullOrEmpty(textoBusqueda))
        {
            textoBusqueda = _textoBusquedaArticulo;
        }
        if (Convert.ToInt32(pagina) <= 0)
        {
            pagina = paginaActualArticulo;
        }
        if (Convert.ToInt32(cantidadPorPagina) <= 0)
        {
            cantidadPorPagina = CantidadRegistrosPorPaginaArticulo;
        }
        try
        {
            Cargando = true;
            var response = await _sapOitmClientService.GetListOitmAsync(textoBusqueda, pagina, cantidadPorPagina);
            listaArticulosApi = response?.Valor ?? new();
            CantidadDeArticulosEncontrados = response?.CantRegistros ?? 0;
        }
        catch (Exception ex)
        {
            await _logClientService.GuardarErrorAsync(ex.Message, ex.StackTrace, nivel: "error", metodo: "BuscarEnServidor");
        }
        finally
        {
            Cargando = false;
            StateHasChanged();
        }
    }
