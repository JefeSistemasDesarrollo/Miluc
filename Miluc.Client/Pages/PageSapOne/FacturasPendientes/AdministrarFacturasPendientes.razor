@page "/administrar-facturas/pendientes/{cardcode}"
@using Miluc.Client.Interfaces.Exportar
@using Miluc.Client.Interfaces.SapInterfaces.Cliente
@using Miluc.Shared.DTOs.Sap.Factura
@inject IAuthClientService _auth
@inject NavigationManager _nav
@inject ISapOcrdClientService _clienteSapCartera
@inject IExportarService _excelService

@* <h5>cardcode- @cardcode</h5> *@
<div class="container py-4">
    <!-- Header Navegación / Título -->
    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i class="bi bi-diagram-3 me-2 text-danger"></i>Facturas pendientes por cobrar
            </h4>
            <p class="text-muted small mb-0">Seguimiento de flujo documental de N° <strong>@cardcode</strong></p>
        </div>
        <button class="btn btn-success"
                @onclick="DescargarExcel">
            <i class="bi bi-file-earmark-spreadsheet"></i>Descargar
        </button>

        


        <button class="btn btn-outline-secondary btn-sm" @onclick='() => _nav.NavigateTo("/administrar-pedido/pedidos")'>
            <i class="bi bi-arrow-left me-1"></i> Volver
        </button>
    </div>

    @if (!cargando)
    {
        <!-- Estado de Carga -->
        <div class="card shadow-sm border-0 py-5 my-3 text-center">
            <div class="card-body">
                <div class="spinner-border text-danger mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <h6 class="text-muted fw-normal">Consultando flujo de documentos en SAP...</h6>
            </div>
        </div>
    }
    else if (ListaFacturasPendientes == null)
    {
        <!-- Estado Sin Datos -->
        <div class="alert alert-warning d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                No se encontraron facturas <strong>N° @cardcode</strong>.
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- SECCIÓN 3: FACTURAS DE VENTA (Espacio reservado) -->
            <div class="col-12">
                <div class="p-3 bg-light rounded-3 border border-dashed">
                    <div class="d-flex align-items-center text-muted">
                        <i class="bi bi-receipt me-2 fs-5"></i>
                        <h6 class="mb-0 fw-bold">Facturas de Venta</h6>
                    </div>
                    <p class="small text-muted mb-0 mt-1">Facturas de venta.</p>
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                    @foreach (var item in ListaFacturasPendientes)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 border-start border-4 border-danger rounded-3">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                                    <span class="badge bg-danger-subtle text-danger fw-semibold px-2 py-1">
                                        Factura N° @item.DocNum
                                    </span>
                                </div>
                                <div class="card-body pt-1 pb-3">
                                    <div class="mb-2">
                                        <small class="text-uppercase text-muted fw-bold d-block fs-8">Cliente / Código</small>
                                        <span class="fw-semibold text-dark">@item.CardCode</span>
                                    </div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-5">
                                            <small class="text-muted d-block fs-8">Emisión</small>
                                            <span class="fs-7"><i class="bi bi-calendar-event me-1"></i>@item.DocDate.Value.Date.ToShortDateString()</span>
                                        </div>
                                        <div class="col-5">
                                            <small class="text-muted d-block fs-8">Vencimiento</small>
                                            <span class="fs-7"><i class="bi bi-calendar-check me-1"></i>@item.DocDueDate.Value.Date.ToShortDateString()</span>
                                        </div>
                                        <div class="col-2">
                                            @if (_auth.HasPermission("Invoices.Details"))
                                            {
                                                <button class="btn btn-outline-secondary border-0 btn-sm" @onclick:stopPropagation="true" @onclick="() => VerDetalleFactura(item.DocEntry, cardcode)">
                                                    <i class="bi bi-list-task"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <hr class="my-2 text-muted opacity-25" />
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted fs-7">Saldo Pendiente:</span>
                                        <span class="fw-bold text-danger fs-6">@item.SaldoPendiente.ToString("C", new System.Globalization.CultureInfo("es-CO"))</span>

                                        <span class="text-muted fs-7">Monto Total:</span>
                                        <span class="fw-bold text-danger fs-6">@item.DocTotal.ToString("C", new System.Globalization.CultureInfo("es-CO"))</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

          
          
      
        </div>
    }
</div>

@code {
    [Parameter]
    public string cardcode{ get; set; }
    public bool cargando = false;


    public List<OinvReaderDto>ListaFacturasPendientes=new List<OinvReaderDto>();

    protected override async Task OnInitializedAsync()
    {

        var result = await _clienteSapCartera.FacturasPendientes(cardcode);

        if (result.Valor != null)
        {
            ListaFacturasPendientes=result.Valor;
            cargando = true;
        }
        else
        {
            _nav.NavigateTo("/");
        }
    }

    private void VerDetalleFactura(int DocEntry, string CardCode)
    {

        // //
        // if (_authClientService.HasPermission("Orders.Detail"))
        // {
        // _nav.NavigateTo($"/administrar-detalle-factura/detalle/{DocEntry}/{cardcode}");
        _nav.NavigateTo($"/detalle-factura-Cliente/{DocEntry}/{CardCode}");
        // }
        // else
        // {
        //     Nav.NavigateTo("/no-autorizado");
        //     return;
        // }

    }
    private async Task DescargarExcel() => await _excelService.DescargarExcelAsync(
           ListaFacturasPendientes,
           "Facturas Pendientes ");

}
