@page "/permiso/Editar/{IdPermiso:int}"
@using Miluc.Client.Interfaces.UsuariosRolesPermisos
@using Miluc.Shared.DTOs.Permisos
@using Miluc.Shared.DTOs.Roles
@inject NavigationManager nav
@inject IPermisoClientService _permisoService
@inject IRolClientService _rolService
@inject IJSRuntime js
@inject IAuthClientService authClient
@inject ILogClientService logClient
<div class="permisos-page animate__animated animate__fadeIn p-4">
    @* --- CABECERA --- *@
    <div class="header-box mb-4 d-flex justify-content-between align-items-center border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-vinotinto m-0"><i class="bi bi-shield-lock me-2"></i>Crear Permiso</h2>
            <p class="text-muted mb-0 small">Complete los datos obligatorios marcados con (*).</p>
        </div>
        <button class="btn btn-vinotinto btn-sm rounded-pill px-3" @onclick='() => nav.NavigateTo("/configuracion/permisos")'>
            <i class="bi bi-arrow-left me-1"></i> Volver a la lista
        </button>
    </div>

    <EditForm Model="permisosUpdateDto" OnValidSubmit="GuardarPermiso">
        <DataAnnotationsValidator />

        <div class="row g-4">
            @* --- COLUMNA IZQUIERDA: PERFIL Y CREDENCIALES --- *@
            <div class="col-xl-12 col-lg-10 col-12 col-md-6 col-lg-4 col-xl-4">
                <div class="card shadow-sm border-0 mb-4 rounded-4">
                    <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-secondary">Nombre del permiso*</label>
                                <InputText class="form-control custom-input" @bind-Value="permisosUpdateDto.Nombre" placeholder="ejemplo Productos.view" />
                                <ValidationMessage For="@(() => permisosUpdateDto.Nombre)" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-secondary">Descripcion del permiso*</label>
                                <InputText class="form-control custom-input" placeholder="Descripción Permiso" @bind-Value="permisosUpdateDto.Descripcion" />
                                <ValidationMessage For="@(() => permisosUpdateDto.Descripcion)" class="text-danger small" />
                            </div>
                             <div class="mt-4 p-3 rounded-3 bg-light border-start border-4 border-warning shadow-sm">
                            <div class="form-check form-switch m-0">
                                <InputCheckbox class="form-check-input" id="chkPass" @bind-Value="permisosUpdateDto.Activo" />
                                <label class="form-check-label fw-bold small cursor-pointer" for="chkPass">Activo</label>
                            </div>
                        </div>

                    </div>
                 </div>
            </div>   
                @* --- TIPOS DE USUARIO --- *@
            <div class="col-xl-12 col-lg-10 col-12 col-md-6 col-lg-4 col-xl-4">
                 <div class="card shadow-sm border-0 rounded-4 h-100">
                 <div class="card-header bg-white py-3 border-0">
                        <div class="row align-items-center">
                            <div class="col-md-6"><h6 class="mb-0 fw-bold text-vinotinto text-uppercase">Asignación de Roles*</h6></div>
                            <div class="col-md-6">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-pill"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control bg-light border-start-0 rounded-end-pill" placeholder="Buscar rol..." @oninput="FiltrarRoles" />
                                </div>
                            </div>
                        </div>
                 </div>
                 <div class="card-body pt-0">
                               <div class="alert alert-warning py-2 small border-0 bg-opacity-10 mb-3 d-flex justify-content-between">
                            <span><i class="bi bi-shield-check me-2"></i>Seleccione los Roles</span>
                            <span class="badge bg-vinotinto rounded-pill">@permisosUpdateDto.RolesIds.Count seleccionados</span>
                  </div>
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-header bg-white py-3 border-0"><h6 class="mb-0 fw-bold text-vinotinto">Roles*</h6></div>

                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-2 g-2 overflow-auto pe-1" style="max-height: 580px;">
                        @if (rolesFiltrados != null)
                        {
                            @foreach (var roles in rolesFiltrados)
                            {
                                 <div class="col">
                                    <div class=" role-card tipo-item p-2 mb-2 rounded-3 @(permisosUpdateDto.RolesIds.Contains(roles.IdRol) ? "active" : "")">
                                        <div class="form-check form-switch d-flex align-items-center justify-content-between p-0">
                                            <label class="form-check-label fw-semibold small ms-2" for="tipo-@roles.IdRol">@roles.Nombre</label>
                                            <input class="form-check-input ms-0" type="checkbox" id="tipo-@roles.IdRol"
                                                   checked="@permisosUpdateDto.RolesIds.Contains(roles.IdRol)"
                                                   @onchange="@(e => ToggleRoles(roles.IdRol, e.Value))" />
                                        </div>
                                      <span class="text-muted role-desc ">@roles.Descripcion</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
                     <div class="card-footer bg-white border-0 p-4 text-end">
                        <button type="submit" class="btn btn-vinotinto btn-lg rounded-pill px-5 shadow-sm" disabled="@procesando">
                            @if (procesando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span> <span>Guardando...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-shield-lock me-2"></i>Guardar Permiso</span>
                            }
                        </button>
                    </div> 
                </div> 
           </div> 
       </div> 
    </EditForm>
</div>
@code {
    [Parameter]
    public int IdPermiso{ get; set; }
    private PermisosUpdateDto permisosUpdateDto = new PermisosUpdateDto { RolesIds = new List<int>() };
    private List<RolReadDto> listRoles = new();
    private List<RolReadDto>? rolesFiltrados;
    private bool procesando = false;
  
    protected override async Task OnParametersSetAsync()
    {
        if (!authClient.HasPermission("Permiso.Update"))
        {
            nav.NavigateTo("/no-autorizado");
            return;
        }
        try
        {
            var responsePermiso = await _permisoService.GetByIdPermisoAsync(IdPermiso);

            if (responsePermiso.Valor!=null)
            {
                permisosUpdateDto.IdPermiso = responsePermiso.Valor.IdPermiso;
                permisosUpdateDto.Nombre = responsePermiso.Valor.Nombre;
                permisosUpdateDto.Descripcion = responsePermiso.Valor.Descripcion;
                permisosUpdateDto.Activo = responsePermiso.Valor.Activo;
                permisosUpdateDto.RolesIds = responsePermiso.Valor.RolesIds  != null ? new List<int>(responsePermiso.Valor.RolesIds)
                : new List<int>();
            }
            var responseRole = await _rolService.GetAllRolesAsync();

            if (responseRole.Valor!=null)
            {
                listRoles = responseRole.Valor;
                rolesFiltrados = listRoles;
            }
        }
        catch (Exception ex)
        {
            await logClient.GuardarErrorAsync(
                       ex.Message,
                       ex.StackTrace,
                       usuario: authClient.CurrentSession.UserName ?? "No encontrado",
                       metodo: "OnParametersSetAsync",
                       ruta: $"/permiso/Editar/{IdPermiso}",
                       origen: "Blazor Cliente",
                       nivel: "error");              
        }
    }
    private void FiltrarRoles(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString()?.ToLower() ?? "";
        rolesFiltrados = string.IsNullOrEmpty(texto)
        ? listRoles
        : listRoles?.Where(r => r.Nombre.ToLower().Contains(texto)).ToList();
    }
    private async Task GuardarPermiso()
    {
        // Validación manual adicional
        if (permisosUpdateDto.RolesIds.Count == 0)
        {
            await js.InvokeVoidAsync("Swal.fire", "Atención", "Debe asignar este permiso a al menos un rol.", "warning");
            return;
        }
        procesando = true;
        try
        {
            var res = await _permisoService.ActualizarPemriso(permisosUpdateDto);

            if (res.EsCorrecto)
            {
                await js.InvokeVoidAsync("Swal.fire", "¡Éxito!", "El permiso se creó correctamente.", "success");
                nav.NavigateTo("/configuracion/permisos"); // Ajustado a la ruta lógica
            }
            else
            {
                await js.InvokeVoidAsync("Swal.fire", "Error", res.Mensaje, "error");
            }
        }
        catch (Exception ex)
        {
            await logClient.GuardarErrorAsync(
                       ex.Message,
                       ex.StackTrace,
                       usuario: authClient.CurrentSession.UserName ?? "No encontrado",
                       metodo: "Editar Permisos",
                       ruta: $"/permiso/Editar/{IdPermiso}",
                       origen: "Blazor cliente",
                       nivel: "error");

            await js.InvokeVoidAsync("Swal.fire", "Error de sistema", ex.Message, "error");
        }
        finally
        {
            procesando = false;
        }
    }
    private void ToggleRoles(int id, object? val)
    {
        bool isChecked = (bool)(val ?? false);
        if (isChecked) { if (!permisosUpdateDto.RolesIds.Contains(id)) permisosUpdateDto.RolesIds.Add(id); }
        else permisosUpdateDto.RolesIds.Remove(id);
    }
}
