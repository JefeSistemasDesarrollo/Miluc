@page "/cambiar-password/{IdUsuario:int}"
@attribute [AllowAnonymous]

@using Miluc.Shared.DTOs.Autorizacion
@using Miluc.Shared.DTOs.Usuarios
@inject IAuthClientService AuthService
@inject NavigationManager Nav
@inject IJSRuntime js

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light animate__animated animate__fadeIn">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="max-width: 420px; width: 100%;">
        
        @* Encabezado con color institucional *@
        <div class="bg-vinotinto p-4 text-center text-white">
            <div class="mb-3">
                <i class="bi bi-key-fill fs-1"></i>
            </div>
            <h4 class="fw-bold m-0">Nueva Contraseña</h4>
            <p class="small opacity-75 mb-0">Actualice sus credenciales de acceso</p>
        </div>

        <div class="card-body p-4 p-md-5">
            <EditForm Model="model" OnValidSubmit="Cambiar">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="form-label fw-bold small text-secondary">Nueva Contraseña</label>
                    <div class="input-group search-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-lock text-vinotinto"></i>
                        </span>
                        <InputText type="password" 
                                   class="form-control border-start-0 shadow-none rounded-end-pill custom-input" 
                                   @bind-Value="model.Password"
                                   placeholder="Min. 8 caracteres" />
                    </div>
                    <ValidationMessage For="@(() => model.Password)" class="text-danger small mt-1" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-secondary">Confirmar Contraseña</label>
                    <div class="input-group search-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-shield-check text-vinotinto"></i>
                        </span>
                        <InputText type="password" 
                                   class="form-control border-start-0 shadow-none rounded-end-pill custom-input" 
                                   @bind-Value="model.ConfirmarPassword"
                                   placeholder="Repita su contraseña" />
                    </div>
                    <ValidationMessage For="@(() => model.ConfirmarPassword)" class="text-danger small mt-1" />
                </div>

                <button type="submit" class="btn btn-vinotinto w-100 rounded-pill py-3 shadow-sm fw-bold d-flex align-items-center justify-content-center mt-3" disabled="@loading">
                    @if (loading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span> <span>Procesando...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat me-2"></i> <span>Actualizar Contraseña</span>
                    }
                </button>
            </EditForm>
        </div>
        
        <div class="card-footer bg-white border-0 pb-4 text-center">
            <button class="btn btn-link btn-sm text-decoration-none text-muted" @onclick='() => Nav.NavigateTo("/login")'>
                <i class="bi bi-x-circle me-1"></i> Cancelar y salir
            </button>
        </div>
    </div>
</div>



@code {
    [Parameter] public int IdUsuario { get; set; }
    private CambiarPasswordRequest model = new();
    private bool loading = false;

    protected override void OnInitialized()
    {
        model.IdUsuario = IdUsuario;
    }

    private async Task Cambiar()
    {
        loading = true;
        try
        {
            var result = await AuthService.CambiarPassword(model);

            if (result.EsCorrecto)
            {
                await js.InvokeVoidAsync("Swal.fire", new {
                    title = "¡Éxito!",
                    text = "Contraseña actualizada correctamente",
                    icon = "success",
                    confirmButtonColor = "#800020"
                });
                Nav.NavigateTo("/login");
            }
            else
            {
                await js.InvokeVoidAsync("Swal.fire", new {
                    title = "Error",
                    text = result.Mensaje,
                    icon = "error",
                    confirmButtonColor = "#800020"
                });
            }
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("Swal.fire", "Error", ex.Message, "error");
        }
        finally { loading = false; }
    }
}