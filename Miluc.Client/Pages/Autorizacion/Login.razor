
@page "/login"
@attribute [AllowAnonymous]
@using Miluc.Client.Interfaces
@using Miluc.Shared.DTOs.Autorizacion
@inject IAuthClientService AuthService
@inject NavigationManager Nav
@inject IJSRuntime js

<div class="login-page">
    <div class="login-card shadow-lg">
        @* Encabezado con Identidad de Marca *@
        <div class="login-header">
            <div class="login-logo-circle">
               <div class="login-logo-circle">
        <img src="/img/logo-miluc.png" alt="Logo Miluc" style="width: 100%; height: auto;" />
    </div>
            </div>
            <h2 class="brand-name">AVICOLA MILUC</h2>
            <p class="brand-subtitle">Bienvenido Portal Web</p>
        </div>

        <div class="card-body p-4 p-md-5">
            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="form-label fw-bold">Usuario</label>
                    <div class="input-group custom-input">
                        <span class="input-group-text bg-white"><i class="bi bi-person text-danger"></i></span>
                        <InputText @bind-Value="loginModel.Usuario" class="form-control border-start-0" placeholder="Usuario" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Usuario)" class="text-danger small" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Contraseña</label>
                    <div class="input-group custom-input">
@* 
                        <span class="input-group-text bg-white">
                            <i class="bi bi-lock text-danger"></i>
                            </span> *@
                             <span type="button" class="input-group-text bg-white"@onclick="TogglePassword">

                              <i class="bi @(showPassword ? "bi bi-lock" : "bi bi-key")"></i>

                             </span>

                        <InputText @bind-Value="loginModel.Password"   type="@PasswordInputType" class="form-control border-start-0" placeholder="********" />
                    </div>
                           
                    <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-miluc py-2 text-center mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                    </div>
                }

                <button type="submit" class="btn btn-miluc-login w-100" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span> <span>Verificando...</span>
                    }
                    else
                    {
                        <span>INICIAR SESIÓN</span>
                    }
                </button>
            </EditForm>
        </div>
        <div class="card-footer text-center py-3 bg-white border-0">
            <small class="text-muted">&copy; 2026 </small>
        </div>
    </div>
</div>
@code {
    private LoginAccesoRequest loginModel = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    private bool showPassword = false;

private string PasswordInputType => showPassword ? "text" : "password";

private void TogglePassword()
{
    showPassword = !showPassword;
}


    private async Task HandleLogin()
{
    isSubmitting = true;
    errorMessage = null;

    try
    {
        var result = await AuthService.Login(loginModel);

        // 1️⃣ Validar respuesta general
        if (!result.EsCorrecto || result.Valor == null)
        {
            errorMessage = result.Mensaje;

            await js.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = "Error de autenticación",
                text = result.Mensaje,
                confirmButtonColor = "#6c1d1d"
            });

            return;
        }

        var session = result.Valor;

        //  Requiere 2FA
        if (session.Requiere2FA)
        {
            Nav.NavigateTo($"/verify-otp/{session.IdUsuario}");
            return;
        }

        //  Requiere cambio de contraseña
        if (session.DebeCambiarPassword)
        {
           
            Nav.NavigateTo($"/cambiar-password/{session.IdUsuario}");
            return;
        }

        // 4️⃣ Login normal
        await js.InvokeVoidAsync("Swal.fire", "¡Éxito!", "Login exitoso.", "success");

        Nav.NavigateTo("/");
    }
    catch (Exception ex)
    {
        errorMessage = "Error de conexión con el servidor.";

        await js.InvokeVoidAsync("Swal.fire", new
        {
            icon = "error",
            title = "Error inesperado",
            text = ex.Message,
            confirmButtonColor = "#6c1d1d"
        });
    }
    finally
    {
        isSubmitting = false;
    }
}
  
}