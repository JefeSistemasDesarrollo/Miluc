@inherits LayoutComponentBase
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization
@using Miluc.Client.Interfaces
@inject IAuthClientService AuthService

<div class="miluc-layout @(isMenuOpen ? "menu-open" : "menu-closed")">

    @* CAPA OSCURA: Se activa solo en móvil cuando el menú está abierto *@
    @if (isMenuOpen)
    {
        <div class="sidebar-overlay" @onclick="CloseMenu"></div>
    }

    <aside class="miluc-sidebar">
        <div class="sidebar-header">
            <div class="chicken-logo-wrapper">
                <svg viewBox="0 0 512 512" fill="currentColor"><path d="M448 96c0-53-43-96-96-96s-96 43-96 96c0 9.2 1.3 18.1 3.7 26.5C177.1 137.3 112 211.1 112 300.2V384H80c-26.5 0-48 21.5-48 48s21.5 48 48 48h352c26.5 0 48-21.5 48-48s-21.5-48-48-48h-32v-83.8c0-89.1-65.1-162.9-147.7-177.7 2.4-8.4 3.7-17.3 3.7-26.5zM352 64a32 32 0 1 1 0 64 32 32 0 1 1 0-64z" /></svg>
            </div>
            <span class="brand-text">MILUC</span>
            
            @* Botón de cerrar (X) opcional para móvil *@
            <button class="btn-close-sidebar d-md-none" @onclick="CloseMenu">
                <i class="bi bi-x-lg text-white"></i>
            </button>
        </div>

        @* El evento @onclick="CloseMenu" aquí hace que se cierre al elegir una opción *@
        <nav class="sidebar-nav" @onclick="CloseMenu">
            <NavMenu />
        </nav>
    </aside>

    <div class="miluc-main-container">
        <header class="miluc-topbar">
            <button class="menu-toggle-btn" @onclick="ToggleMenu">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-actions">
                <AuthorizeView>
                    <Authorized>
                        <span class="user-label d-none d-sm-block">User: @context.User.Identity?.Name</span>
                        <button class="btn btn-salir rounded-pill px-3" @onclick="Logout">
                            <i class="bi bi-box-arrow-right"></i> Salir
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="miluc-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isMenuOpen = false; // Mejor iniciar cerrado en móvil

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    // Función específica para cerrar el menú
    private void CloseMenu() => isMenuOpen = false;

    private async Task Logout()
    {
        await AuthService.Logout();
        Nav.NavigateTo("/login");
    }
}