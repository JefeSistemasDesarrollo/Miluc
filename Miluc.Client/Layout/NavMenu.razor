@using Microsoft.AspNetCore.Components.Authorization
@using Miluc.Client.Pages
@inject IAuthClientService _authClientService
@inject NavigationManager nav
<div class="nav-scrollable">
    <nav class="nav flex-column">

        <div class="nav-item px-1">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <div class="nav-icon-wrapper">
                    <i class="bi bi-house-door-fill"></i>
                </div>
                <span>Home</span>
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>

                @if(_authClientService.HasPermission("Modulo.Comercial"))
                {
                    <div class="nav-item px-1">
                        <NavLink class="nav-link" href="/administrar-modulo-comercial">
                            <div class="nav-icon-wrapper">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <span>Comercial</span>
                        </NavLink>
                    </div>
                }
                @if (_authClientService.HasPermission("Modulo.Nomina"))
                {

                    <div class="nav-item px-2">
                    <NavLink class="nav-link" href="administrar-Nomina">
                        <div class="nav-icon-wrapper">
                          <i class="bi bi-calculator"></i>
                        </div>
                        <span class="nav-text">RRH</span>
                    </NavLink>
                </div>
                }

                @if (_authClientService.HasPermission("Modulo.Systems"))
                {
                        <div class="nav-item px-2">
                    <NavLink class="nav-link" href="Usuarios-Seguridad">
                        <div class="nav-icon-wrapper">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <span class="nav-text">Sistemas</span>
                    </NavLink>
                </div>
                }
            

                <AuthorizeView Roles="Admin" Context="innerContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="configuracion">
                            <span class="bi bi-gear-fill" aria-hidden="true"></span> Panel Admin
                        </NavLink>
                    </div>
                </AuthorizeView>
            </Authorized>

            <NotAuthorized>


                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-person-badge-fill" aria-hidden="true"></span> Iniciar Sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}